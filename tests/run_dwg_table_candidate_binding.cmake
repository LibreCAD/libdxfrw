if(NOT DEFINED CONTENT_TEST OR NOT DEFINED DATA_TEST OR NOT DEFINED GEOMETRY_TEST OR NOT DEFINED ROOT_TEST OR NOT DEFINED BIND_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing candidate binding test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(content "${TEST_DIR}/content.bin")
set(largeContent "${TEST_DIR}/large-content.bin")
set(data "${TEST_DIR}/data.bin")
set(dataNine "${TEST_DIR}/data-nine.bin")
set(bad "${TEST_DIR}/bad-role.bin")
set(geometry "${TEST_DIR}/geometry.bin")
set(badGeometry "${TEST_DIR}/bad-geometry.bin")
set(root "${TEST_DIR}/root.bin")
set(dwg "${TEST_DIR}/generated.dwg")
file(REMOVE "${content}" "${largeContent}" "${data}" "${bad}" "${dwg}" "${dwg}.bad.dwg" "${geometry}" "${badGeometry}" "${root}" "${dataNine}")
execute_process(COMMAND "${CONTENT_TEST}" --emit-body "${content}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch TABLECONTENT body")
endif()
execute_process(COMMAND "${DATA_TEST}" --emit-body "${data}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch DATATABLE body")
endif()
execute_process(COMMAND "${DATA_TEST}" --emit-nine "${dataNine}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate nine-child DATATABLE body")
endif()
execute_process(COMMAND "${DATA_TEST}" --emit-bad-role "${bad}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch bad-role body")
endif()
execute_process(COMMAND "${CONTENT_TEST}" --emit-large-body "${largeContent}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch larger TABLECONTENT body")
endif()
execute_process(COMMAND "${GEOMETRY_TEST}" --emit-body "${geometry}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate TABLEGEOMETRY body")
endif()
execute_process(COMMAND "${GEOMETRY_TEST}" --emit-bad-role "${badGeometry}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate bad-role TABLEGEOMETRY body")
endif()
execute_process(COMMAND "${ROOT_TEST}" --emit-body "${root}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate root XRECORD body")
endif()
execute_process(COMMAND "${BIND_TEST}" "${content}" "${data}" "${bad}" "${largeContent}" "${dwg}" "${geometry}" "${badGeometry}" "${root}" "${dataNine}"
    RESULT_VARIABLE result)
file(REMOVE "${content}" "${largeContent}" "${data}" "${bad}" "${dwg}" "${dwg}.bad.dwg" "${geometry}" "${badGeometry}" "${root}" "${dataNine}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Combined candidate binding test failed: ${result}")
endif()
