foreach(_required IN ITEMS ADAPTER_TEST DWG2DXF OUTPUT_DIR)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
execute_process(COMMAND "${ADAPTER_TEST}" --extension-graph-limits
    RESULT_VARIABLE _bounded TIMEOUT 15)
if(NOT "${_bounded}" STREQUAL "0")
    message(FATAL_ERROR "Extension graph resource/cycle boundary tests failed")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_root "${OUTPUT_DIR}/extension-graph-reject-${_nonce}")
file(MAKE_DIRECTORY "${_root}")
foreach(_mode IN ITEMS ascii binary)
    set(_generate --generate-extension-cycle)
    set(_options "")
    if(_mode STREQUAL "binary")
        set(_generate --generate-extension-cycle-binary)
        set(_options -b)
    endif()
    set(_source "${_root}/${_mode} source.dxf")
    set(_destination "${_root}/${_mode} destination.dxf")
    execute_process(COMMAND "${ADAPTER_TEST}" "${_generate}" "${_source}"
        RESULT_VARIABLE _generated TIMEOUT 10)
    if(NOT "${_generated}" STREQUAL "0")
        message(FATAL_ERROR "Extension ownership cycle generation failed: ${_root}")
    endif()
    file(WRITE "${_destination}" "original destination bytes\n")
    file(SHA256 "${_destination}" _before)
    execute_process(COMMAND "${DWG2DXF}" "${_source}" -o "${_destination}" -y -d ${_options}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 10)
    file(SHA256 "${_destination}" _after)
    if("${_result}" STREQUAL "0" OR NOT "${_before}" STREQUAL "${_after}")
        message(FATAL_ERROR "Extension ownership rejection replaced output: ${_root}\n${_stdout}\n${_stderr}")
    endif()
    if(NOT "${_stderr}" MATCHES "Extension graph diagnostic: invalid-graph")
        message(FATAL_ERROR "Missing bounded graph diagnostic: ${_root}\n${_stderr}")
    endif()
endforeach()
file(REMOVE_RECURSE "${_root}")
