foreach(_required IN ITEMS ADAPTER_TEST DWG2DXF OUTPUT_DIR)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_root "${OUTPUT_DIR}/block-owner-reject-${_nonce}")
file(MAKE_DIRECTORY "${_root}")
foreach(_mode IN ITEMS ascii binary)
    set(_generate --generate-dangling)
    set(_options "")
    if(_mode STREQUAL "binary")
        set(_generate --generate-dangling-binary)
        set(_options -b)
    endif()
    set(_source "${_root}/${_mode} source.dxf")
    set(_destination "${_root}/${_mode} destination.dxf")
    execute_process(COMMAND "${ADAPTER_TEST}" "${_generate}" "${_source}"
        RESULT_VARIABLE _generated TIMEOUT 10)
    if(NOT "${_generated}" STREQUAL "0")
        message(FATAL_ERROR "Owner rejection control generation failed: ${_root}")
    endif()
    execute_process(COMMAND "${DWG2DXF}" "${_source}" -o "${_destination}" ${_options}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 10)
    if("${_result}" STREQUAL "0" OR EXISTS "${_destination}")
        message(FATAL_ERROR "Unresolved owner published output: ${_root}\n${_stdout}\n${_stderr}")
    endif()
    if(NOT "${_stderr}" MATCHES "unresolved-block-owner")
        message(FATAL_ERROR "Missing bounded owner diagnostic: ${_root}\n${_stderr}")
    endif()
    file(WRITE "${_destination}" "original destination bytes\n")
    file(SHA256 "${_destination}" _before)
    execute_process(COMMAND "${DWG2DXF}" "${_source}" -o "${_destination}" -y ${_options}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 10)
    file(SHA256 "${_destination}" _after)
    if("${_result}" STREQUAL "0" OR NOT "${_before}" STREQUAL "${_after}")
        message(FATAL_ERROR "Owner rejection replaced original output: ${_root}\n${_stdout}\n${_stderr}")
    endif()
endforeach()
file(REMOVE_RECURSE "${_root}")
