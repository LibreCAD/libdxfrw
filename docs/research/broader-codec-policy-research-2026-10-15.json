    "probe_cpp": "#include \"intern/drw_textcodec.h\"\n#include <clocale>\n#include <iomanip>\n#include <iostream>\n#include <sstream>\n#include <string>\n\nstd::string hex(const std::string& input) {\n    std::ostringstream out;\n    for (unsigned char byte : input)\n        out << std::hex << std::setw(2) << std::setfill('0')\n            << static_cast<unsigned int>(byte);\n    return out.str();\n}\n\nstd::string bytes(const std::string& input) {\n    std::string out;\n    for (std::size_t i = 0; i < input.size(); i += 2)\n        out.push_back(static_cast<char>(std::stoul(input.substr(i, 2), nullptr, 16)));\n    return out;\n}\n\nint main(int argc, char** argv) {\n    if (argc == 2 && std::setlocale(LC_CTYPE, argv[1]) == nullptr)\n        return 77;\n    struct Row { const char* name; const char* input; const char* oracle; };\n    const Row rows[] = {\n        {\"ANSI_1252\", \"80\", \"cp1252\"}, {\"LATIN1\", \"80\", \"iso8859_1\"},\n        {\"ISO-8859-1\", \"80\", \"iso8859_1\"}, {\"ISO8859-2\", \"a1\", \"iso8859_2\"},\n        {\"ISO8859-3\", \"a1\", \"iso8859_3\"}, {\"ISO8859-4\", \"a1\", \"iso8859_4\"},\n        {\"ISO8859-5\", \"b0\", \"iso8859_5\"}, {\"KOI8-R\", \"e1\", \"koi8_r\"},\n        {\"KOI8-U\", \"e1\", \"koi8_u\"}, {\"IBM 866\", \"80\", \"cp866\"},\n        {\"CP866\", \"80\", \"cp866\"}, {\"IBM 850\", \"80\", \"cp850\"},\n        {\"CP850\", \"80\", \"cp850\"}, {\"APPLE ROMAN\", \"80\", \"mac_roman\"},\n        {\"MACINTOSH\", \"80\", \"mac_roman\"}, {\"ISO8859-6\", \"ac\", \"iso8859_6\"},\n        {\"ISO8859-7\", \"a1\", \"iso8859_7\"}, {\"ISO8859-8\", \"e0\", \"iso8859_8\"},\n        {\"ISO8859-9\", \"d0\", \"iso8859_9\"}, {\"ISO8859-10\", \"a1\", \"iso8859_10\"},\n        {\"ISO8859-13\", \"a1\", \"iso8859_13\"}, {\"ISO8859-15\", \"a4\", \"iso8859_15\"},\n        {\"ISO8859-8\", \"df\", \"iso8859_8\"}, {\"ISO8859-9\", \"80\", \"iso8859_9\"},\n        {\"EUC-JP\", \"a4a2\", \"euc_jp\"}, {\"ANSI_932\", \"82a0\", \"cp932\"},\n        {\"GB18030\", \"81308130\", \"gb18030\"}, {\"ANSI_936\", \"d6d0\", \"gbk\"},\n        {\"ANSI_949\", \"b0a1\", \"cp949\"}, {\"ansi_949\", \"b0a1\", \"cp949\"},\n        {\"BIG5-HKSCS\", \"8862\", \"big5hkscs\"}, {\"ANSI_950\", \"a4a4\", \"cp950\"},\n        {\"BIG5-HKSCS\", \"8864\", \"big5hkscs\"},\n        {\"BIG5-HKSCS\", \"88a3\", \"big5hkscs\"},\n        {\"BIG5-HKSCS\", \"88a5\", \"big5hkscs\"}\n    };\n    for (bool dxf : {false, true}) {\n        for (const auto& row : rows) {\n            DRW_TextCodec codec;\n            codec.setVersion(DRW::AC1015, dxf);\n            codec.setCodePage(row.name, dxf);\n            const std::string decoded = codec.toUtf8(bytes(row.input));\n            std::cout << \"{\\\"alias\\\":\\\"\" << row.name << \"\\\",\\\"oracle\\\":\\\"\"\n                      << row.oracle << \"\\\",\\\"dxf\\\":\" << (dxf ? \"true\" : \"false\")\n                      << \",\\\"input_hex\\\":\\\"\" << row.input << \"\\\",\\\"selected\\\":\\\"\"\n                      << codec.getCodePage() << \"\\\",\\\"decoded_utf8_hex\\\":\\\"\"\n                      << hex(decoded) << \"\\\",\\\"reencoded_hex\\\":\\\"\"\n                      << hex(codec.fromUtf8(decoded)) << \"\\\",\\\"redecoded_utf8_hex\\\":\\\"\"\n                      << hex(codec.toUtf8(codec.fromUtf8(decoded))) << \"\\\"}\\n\";\n        }\n    }\n}\n",
    "oracle_script": "import codecs\nimport json\nimport subprocess\nimport sys\n\nresult = []\nfor locale in (\"C\", \"tr_TR.ISO8859-9\"):\n    proc = subprocess.run([sys.argv[1], locale], capture_output=True, text=True,\n                          timeout=15, check=False)\n    if proc.returncode == 77:\n        result.append({\"locale\": locale, \"status\": \"UNAVAILABLE\"})\n        continue\n    if proc.returncode:\n        raise RuntimeError((proc.returncode, proc.stderr))\n    rows = [json.loads(line) for line in proc.stdout.splitlines()]\n    for row in rows:\n        expected = bytes.fromhex(row[\"input_hex\"]).decode(row[\"oracle\"], \"strict\")\n        row[\"expected_utf8_hex\"] = expected.encode(\"utf-8\").hex()\n        row[\"match\"] = row[\"decoded_utf8_hex\"] == row[\"expected_utf8_hex\"]\n        emitted = bytes.fromhex(row[\"reencoded_hex\"]).decode(row[\"oracle\"], \"strict\")\n        row[\"literal_byte_roundtrip\"] = row[\"reencoded_hex\"] == row[\"input_hex\"]\n        row[\"oracle_codec\"] = codecs.lookup(row[\"oracle\"]).name\n        row[\"reencoded_oracle_utf8_hex\"] = emitted.encode(\"utf-8\").hex()\n    result.append({\"locale\": locale, \"status\": \"EXECUTED\", \"rows\": rows,\n                   \"matches\": sum(row[\"match\"] for row in rows), \"total\": len(rows)})\nprint(json.dumps({\"python\": sys.version, \"profiles\": result}, indent=2))\n"
