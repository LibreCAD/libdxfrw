  "implementation": {
    "observer": "dwg2dxf/dx_ac1024_aerial_tile_wire.h independently checks every XRECORD body field, exact BL/BS choices, payload codes/values, owner and reactor roles, four terminal bits, and typed DRW_XRecord equality. The extension-dictionary observer verifies the same-read dictionary body, complete membership and all six TILE name/handle edges.",
    "binding": "dx_iface::hasQualifiedAc1024AerialTileFrames binds the six MATERIAL profiles to their extension dictionaries and 36 TILE standard-object publications in one import generation. Each MATERIAL is independently source-bound through its same-import EED/class proof; standard frame qualification rechecks publication identity, raw frame, typed baseline, complete dictionary edge and unique source handles.",
    "scope": "Input source binding only. No TILE or full MATERIAL graph output is admitted."
  },
  "validation": {
    "build": "cmake --build build-gcc --target libdxfrw_dwg2dxf_adapter_tests -j4",
    "selector": "build-gcc/tests/libdxfrw_dwg2dxf_adapter_tests --ac1024-material-appid-source-capture tests/samples/AC1024/visualization_-_aerial.dwg",
    "result": "PASS. The same-import APPID, all seven MATERIAL EED profiles and all 36 TILE frames qualify; a second adapter cannot reuse the proof.",
    "negativeControls": "PASS 6,336 individual one-bit mutations across the 36 complete 176-bit XRECORD frames; each rejects and restored same-import data requalifies. For every record, source-offset and payload-capture mutations reject and recover. For every extension dictionary, a raw body-bit and source-offset mutation reject and recover. A typed XRECORD identity mutation and typed dictionary owner mutation also reject and recover."
  },
  "limitations": [
    "The source is a local AC1024 corpus sample; no AutoCAD producer witness or native texture interpretation is established.",
    "The extension dictionaries also contain ADVMATERIAL and FBXASSET branches that remain to be independently source-bound and closed for output.",
    "No output/readback qualification or support claim is established."
  ],
  "next": "Source-bind the six remaining FBXASSET XRECORDs with per-frame bounds and ordered binary chunk checks, then prove one bounded ADVMATERIAL compatibility profile. Keep strict MATERIAL root output gated on all body and dependency closure."
}
