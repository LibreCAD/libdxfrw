  "behavior": {
    "before": "A globally frozen layer with positive ACI was reported unsupported but its direct line and polyface appeared visible in a Draft group.",
    "after": "A globally frozen grouped layer and its direct children start hidden; an off-only layer stays hidden, and the flag for freezing in new viewports alone does not globally hide it. Frozen layers remain reported unsupported pending full semantics."
  },
  "validation": {
    "guiUnit": "The focused FreeCAD GUI test failed for a frozen layer before the change and passes after it for on, frozen, new-viewport-only, off and frozen+off profiles.",
    "guiIntegration": "Fifty-one native macOS ARM64 GUI controls pass, including 2D LINE and 3D POLYFACE initial visibility in grouped frozen, viewport-only, and frozen+off layers. Ungrouped frozen cases remain reported, and frozen-only is not mislabeled as off.",
    "headless": "Two targeted headless tests pass for frozen and off diagnostic separation, and the existing real-Draft headless grouping probe still passes.",
    "patchReplay": "The unidiff-zero patch applies to the clean first-sixteen candidate and reproduces byte-identical source and test files.",
    "fixtures": "DXF controls are generated from scratch in temporary directories; no drawings are committed.",
