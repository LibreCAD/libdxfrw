  "sourceAudit": {
    "mechanism": "Actual TABLES bytes were already staged but unavailable to the converter's source-correspondence lane. New executable controls also reproduced ignored nested write attempts publishing successfully during byte inspection.",
    "preFixExecutableFailure": "/tmp/rpp5az-api-diagnostic-controls.log: fault5 wrote=1/sentinel=0 in both encodings, before the inspection-only sticky guard fix.",
