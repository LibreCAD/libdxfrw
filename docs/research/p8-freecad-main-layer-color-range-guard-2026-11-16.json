  },
  "behavior": {
    "before": "Out-of-range integer layer colors were accepted without diagnostic; the Layer constructor would negate INT_MIN, which overflows signed int.",
    "after": "Before layer creation, values below -255 or above 256 are reported and replaced with signed ACI 7, preserving off/on state. Existing handling of 0 and 256 is deliberately unchanged and not qualified as a supported producer profile."
  },
  "validation": {
    "headless": "Eight signed-range cases pass, including INT_MIN, -256, -255, 0, 255, 256, 257 and INT_MAX, diagnostics and off-state warning, with successive valid imports in the same document.",
    "gui": "Fifty-eight native macOS ARM64 GUI controls pass; extreme negative and positive colors use the ACI-7 fallback, retain off/on state, report the invalid color, and preserve both 2D and 3D geometry. An ungrouped off case reports both range and visibility loss.",
    "patchReplay": "The unidiff-zero patch applies to the clean first-seventeen candidate and reproduces byte-identical source and test files.",
    "fixtures": "Controls are generated in temporary directories; no drawings are committed.",
