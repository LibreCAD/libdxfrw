+template <typename T, typename = void>
+struct HasBlockRecordReadCallback : std::false_type {};
+template <typename T>
+struct HasBlockRecordReadCallback<T, std::void_t<decltype(
+    std::declval<T&>().addBlockRecord(
+        std::declval<const DRW_Block_Record&>()))>> : std::true_type {};
+
+TEST_CASE("Block record link observations retain copies and reject ambiguity",
+          "[dxf][dwg][roundtrip][blockrecord][source]") {
+  LC_DwgAdvancedMetadata metadata;
+  DRW_Block_Record record;
+  record.handle = 0x123u;
+  record.parentHandle = 0x10;
+  record.xDictHandle = 0x456u;
+  record.name = "SOURCE_BLOCK";
+  record.reactorHandles = {0x789u};
+  metadata.observeBlockRecordLinks(record);
+  REQUIRE_FALSE(metadata.blockRecordLinkCaptureFailed());
+  REQUIRE(metadata.blockRecordLinks().size() == 1u);
+  record.name = "CHANGED";
+  record.xDictHandle = 0x999u;
+  record.reactorHandles[0] = 0x999u;
+  const auto &saved = metadata.blockRecordLinks().at(0x123u);
+  CHECK(saved.name == "SOURCE_BLOCK");
+  CHECK(saved.parentHandle == 0x10u);
+  CHECK(saved.extensionDictionaryHandle == 0x456u);
+  CHECK(saved.reactorHandles == std::vector<std::uint32_t>{0x789u});
+  metadata.observeBlockRecordLinks(record);
+  CHECK(metadata.blockRecordLinkCaptureFailed());
+  CHECK(metadata.blockRecordLinks().empty());
+  metadata.clear();
+  CHECK_FALSE(metadata.blockRecordLinkCaptureFailed());
+  record.handle = DRW::NoHandle;
+  metadata.observeBlockRecordLinks(record);
+  CHECK(metadata.blockRecordLinkCaptureFailed());
+  CHECK(metadata.blockRecordLinks().empty());
+  metadata.clear();
+  CHECK_FALSE(metadata.blockRecordLinkCaptureFailed());
+}
