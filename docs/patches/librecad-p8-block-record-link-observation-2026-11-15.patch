+  // A bounded copy of the BLOCK_RECORD links as received by the adapter.
+  // These values are correlation evidence only: they are not source-frame
+  // validation and must never by themselves authorize output.
+  struct BlockRecordLinkObservation {
+    std::uint32_t handle = 0;
+    std::uint32_t parentHandle = 0;
+    std::uint32_t extensionDictionaryHandle = 0;
+    std::string name;
+    std::vector<std::uint32_t> reactorHandles;
+    std::int32_t reactorCount = 0;
+    std::uint8_t extensionDictionaryFlag = 0;
   };
 
+  void observeBlockRecordLinks(const DRW_Block_Record &record) noexcept {
+    constexpr std::size_t maxRecords = 100000u;
+    constexpr std::size_t maxBytes = 32u * 1024u * 1024u;
+    if (m_blockRecordLinkCaptureFailed)
+      return;
+    const auto reject = [this]() noexcept {
+      m_blockRecordLinks.clear();
+      m_blockRecordLinkBytes = 0;
+      m_blockRecordLinkCaptureFailed = true;
+    };
+    if (record.handle == 0u || record.handle == DRW::NoHandle
+        || m_blockRecordLinks.size() >= maxRecords
+        || record.name.size() > maxBytes
+        || record.reactorHandles.size() > maxBytes / sizeof(std::uint32_t)) {
+      reject();
+      return;
+    }
+    const std::size_t estimate = sizeof(BlockRecordLinkObservation)
+        + record.name.size() + record.reactorHandles.size() * sizeof(std::uint32_t);
+    if (estimate > maxBytes || m_blockRecordLinkBytes > maxBytes - estimate) {
+      reject();
+      return;
+    }
+    try {
+      BlockRecordLinkObservation observed;
+      observed.handle = record.handle;
+      observed.parentHandle = static_cast<std::uint32_t>(record.parentHandle);
+      observed.extensionDictionaryHandle = record.xDictHandle;
+      observed.name = record.name;
+      observed.reactorHandles = record.reactorHandles;
+      observed.reactorCount = record.reactorCount();
+      observed.extensionDictionaryFlag = record.extensionDictionaryFlag();
+      if (!m_blockRecordLinks.emplace(record.handle, std::move(observed)).second) {
+        reject();
+        return;
+      }
+      m_blockRecordLinkBytes += estimate;
+    } catch (...) {
+      reject();
+    }
+  }
+
+  const std::map<std::uint32_t, BlockRecordLinkObservation> &
+  blockRecordLinks() const noexcept { return m_blockRecordLinks; }
+  bool blockRecordLinkCaptureFailed() const noexcept {
+    return m_blockRecordLinkCaptureFailed;
+  }
