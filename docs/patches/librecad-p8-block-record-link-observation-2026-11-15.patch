+TEST_CASE("DWG block-record callback records source link observations",
+          "[dwg][roundtrip][blockrecord][source]") {
+  if (!HasBlockRecordReadCallback<DRW_Interface>::value)
+    return; // The older bundled reader has no such optional callback.
+  ensureSettings();
+  struct Source {
+    const char *file;
+    const char *modelName;
+    std::uint32_t modelDictionary;
+    std::uint32_t paperHandle;
+    const char *paperName;
+  };
+  for (const Source &sample : {
+       Source{"ordinary_enc_AC1018.dwg", "*Model_Space", 0u,
+              0x18u, "*Paper_Space"},
+       Source{"lc_layer_flags_ac1014.dwg", "*MODEL_SPACE", 0x97u,
+              0x1Bu, "*PAPER_SPACE"}}) {
+    const std::string source = std::string(LIBRECAD_TEST_DIR) + "/" + sample.file;
+    INFO(sample.file);
+    REQUIRE(std::filesystem::exists(source));
+    RS_Graphic graphic;
+    RS_FilterDXFRW reader;
+    REQUIRE(reader.fileImport(graphic, QString::fromStdString(source),
+                              RS2::FormatDWG));
+    const auto &metadata = graphic.dwgAdvancedMetadata();
+    REQUIRE_FALSE(metadata.blockRecordLinkCaptureFailed());
+    const auto &records = metadata.blockRecordLinks();
+    REQUIRE(records.count(0x17u) == 1u);
+    CHECK(records.at(0x17u).name == sample.modelName);
+    CHECK(records.at(0x17u).extensionDictionaryHandle == sample.modelDictionary);
+    REQUIRE(records.count(sample.paperHandle) == 1u);
+    CHECK(records.at(sample.paperHandle).name == sample.paperName);
+  }
+}
