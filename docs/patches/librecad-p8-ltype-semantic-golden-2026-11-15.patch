+TEST_CASE("R12 export observes layer lineweight codec policy",
+          "[dxf][roundtrip][filter][linetype][ltype][named]") {
+  ensureSettings();
+  RS_Graphic graphic;
+  graphic.initForNewDocument();
+  RS_Layer *layer = graphic.findLayer("0");
+  REQUIRE(layer != nullptr);
+  RS_Pen pen = layer->getPen();
+  pen.setWidth(RS2::Width07);
+  layer->setPen(pen);
+  const std::string out = tmpFile("r12_ltype_layer_lineweight.dxf");
+  writeText(out, "previous destination\n");
+  RS_FilterDXFRW filter;
+  const bool written = filter.fileExport(graphic, QString::fromStdString(out),
+                                         RS2::FormatDXFRW12);
+  if (HasCanonicalLTypeMetadataForGolden<dxfRW>::value) {
+    CHECK_FALSE(written);
+    CHECK(textWithoutCR(out) == "previous destination\n");
+  } else {
+    CHECK(written); // The older bundled writer permits the lossy export.
   }
+  CHECK(layer->getPen().getWidth() == RS2::Width07);
+  pen.setWidth(RS2::WidthDefault);
+  layer->setPen(pen);
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(out),
+                            RS2::FormatDXFRW12));
+  CHECK(countRecords(out, "LTYPE") == 35);
+  RS_Graphic reopened;
+  RS_FilterDXFRW reader;
+  REQUIRE(reader.fileImport(reopened, QString::fromStdString(out),
+                            RS2::FormatDXFRW12));
+  CHECK(reopened.findLayer("0") != nullptr);
+  CHECK(reopened.findLineType("DASHED") != nullptr);
+  std::filesystem::remove(out);
 }
 
