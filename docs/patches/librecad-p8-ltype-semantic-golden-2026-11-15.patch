+// Parse the table as ordered DXF pairs so harmless writer formatting and
+// generated handles do not obscure changes to actual linetype fields.
+DxfRecordGroups tablePairs(const std::string &table) {
+  std::istringstream in(table);
+  DxfRecordGroups pairs;
+  std::string code, value;
+  while (std::getline(in, code) && std::getline(in, value))
+    pairs.emplace_back(trimDxfToken(code), trimDxfToken(value));
+  return pairs;
 }
