diff --git a/src/Mod/Import/App/dxf/ImpExpDxf.cpp b/src/Mod/Import/App/dxf/ImpExpDxf.cpp
index 9a04d09..a06657f 100644
--- a/src/Mod/Import/App/dxf/ImpExpDxf.cpp
+++ b/src/Mod/Import/App/dxf/ImpExpDxf.cpp
@@ -1325,0 +1326,10 @@ void ImpExpDxfRead::OnReadBoundedMesh(
+    // The block composer does not preserve per-child nondefault layer
+    // membership. Do not accept this mesh when the user requested layers:
+    // its geometry would appear under the INSERT's layer instead.
+    if (m_preserveLayers && m_entityAttributes.m_Layer != nullptr
+        && m_entityAttributes.m_Layer->Name != "0"
+        && dynamic_cast<BlockDefinitionCollector*>(Collector) != nullptr) {
+        if (polygonMesh) UnsupportedFeature("POLYGON MESH nondefault layer in block");
+        else UnsupportedFeature("POLYFACE nondefault layer in block");
+        return;
+    }
diff --git a/src/Mod/Import/importtests/TestImportDXF.py b/src/Mod/Import/importtests/TestImportDXF.py
index 053cf24..60d8cf2 100644
--- a/src/Mod/Import/importtests/TestImportDXF.py
+++ b/src/Mod/Import/importtests/TestImportDXF.py
@@ -698,0 +699,68 @@ class TestImportDXF(TestImportBase):
+
+    def test_bounded_mesh_block_layer_disposition(self):
+        """Do not silently erase a nondefault layer inside a block."""
+        import sys
+        import types
+        draft = types.ModuleType("Draft")
+        def make_layer(name, *args):
+            layer = self.document.addObject("App::FeaturePython", "TestLayer")
+            layer.Label = name
+            layer.addProperty("App::PropertyLinkListHidden", "Group")
+            return layer
+        draft.make_layer = make_layer
+        old_draft = sys.modules.get("Draft")
+        sys.modules["Draft"] = draft
+        try:
+            modes = (False,) if FreeCAD.GuiUp else (False, True)
+            for polygon, parent_layer in ((False, "0"), (False, "MESH"), (True, "0"), (True, "MESH")):
+                for preserve in modes:
+                    with self.subTest(polygon=polygon, layer=parent_layer, preserve=preserve):
+                        FreeCAD.ParamGet(self.option_source).SetBool("dxfUseDraftVisGroups", preserve)
+                        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                                (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                                (0, "SECTION"), (2, "TABLES"), (0, "TABLE"), (2, "LAYER"), (70, 2)]
+                        for layer in ("0", "MESH"):
+                            tags.extend([(0, "LAYER"), (2, layer), (70, 0), (62, 1), (6, "CONTINUOUS")])
+                        tags.extend([(0, "ENDTAB"), (0, "ENDSEC"), (0, "SECTION"), (2, "BLOCKS"),
+                                     (0, "BLOCK"), (8, "0"), (2, "INNER"), (70, 0),
+                                     (10, 0), (20, 0), (30, 0),
+                                     (0, "POLYLINE"), (5, "A"), (8, parent_layer), (66, 1),
+                                     (70, 16 if polygon else 64)])
+                        coords = ((0, 0), (0, 3), (4, 0), (4, 3)) if polygon else ((0, 0), (4, 0), (0, 3))
+                        if polygon:
+                            tags.extend([(71, 2), (72, 2)])
+                        for x, y in coords:
+                            tags.extend([(0, "VERTEX"), (8, parent_layer), (10, x), (20, y), (30, 0),
+                                         (70, 64 if polygon else 192)])
+                        if not polygon:
+                            tags.extend([(0, "VERTEX"), (8, parent_layer), (10, 0), (20, 0), (30, 0),
+                                         (70, 128), (71, 1), (72, 2), (73, 3)])
+                        tags.extend([(0, "SEQEND"), (8, parent_layer), (0, "ENDBLK"), (8, "0"),
+                                     (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES"),
+                                     (0, "INSERT"), (8, "0"), (2, "INNER"), (10, 1), (20, 2), (30, 0),
+                                     (0, "LINE"), (8, "0"), (10, 10), (20, 0), (30, 0),
+                                     (11, 12), (21, 0), (31, 0), (0, "ENDSEC"), (0, "EOF")])
+                        path = os.path.join(self.temp_dir, f"block-mesh-{polygon}-{parent_layer}-{preserve}.dxf")
+                        with open(path, "w", encoding="ascii", newline="\n") as stream:
+                            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                        previous = set(self.document.Objects)
+                        stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                        objects = [obj for obj in self.document.Objects if obj not in previous]
+                        lines = [obj for obj in objects if obj.Name.startswith("Shape")
+                                 and hasattr(obj, "Shape") and len(obj.Shape.Edges) == 1]
+                        self.assertEqual(len(lines), 1)
+                        refused = preserve and parent_layer != "0"
+                        reason = ("POLYGON MESH" if polygon else "POLYFACE") + " nondefault layer in block"
+                        self.assertEqual(reason in stats["unsupportedFeatures"], refused)
+                        links = [obj for obj in objects if obj.Name.startswith("Link_INNER")]
+                        if refused:
+                            self.assertFalse(any(not link.Shape.isNull() and link.Shape.Faces
+                                                 for link in links))
+                        else:
+                            self.assertEqual(len(links), 1)
+                            self.assertAlmostEqual(links[0].Shape.Area, 12.0 if polygon else 6.0)
+        finally:
+            if old_draft is None:
+                del sys.modules["Draft"]
+            else:
+                sys.modules["Draft"] = old_draft
