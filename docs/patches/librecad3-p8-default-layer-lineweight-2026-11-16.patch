+TEST(LayersTest, EditingKeepsOrChangesDefaultLineweightExplicitly) {
+    ensureUiApplication();
+    auto document = createDocument();
+    const auto color = lc::Color(255, 255, 255, 255);
+    const auto originalDefault = std::make_shared<const lc::meta::Layer>(
+        "DefaultLayer", lc::meta::MetaLineWidthByValue(0.25), color, nullptr, true, true);
+    const auto originalExplicit = std::make_shared<const lc::meta::Layer>(
+        "ExplicitLayer", lc::meta::MetaLineWidthByValue(0.25), color, nullptr, true, false);
+
+    auto edit = [&](lc::meta::Layer_CSPtr source, bool selectDefault) {
+        AddLayerDialogTest dialog(source, document);
+        lc::meta::Layer_CSPtr result;
+        QObject::connect(&dialog, &lc::ui::dialog::AddLayerDialog::editLayer,
+            [&](lc::meta::Layer_CSPtr, lc::meta::Layer_CSPtr changed) { result = changed; });
+        auto* selector = dialog.findChild<lc::ui::widgets::LineWidthSelect*>();
+        EXPECT_NE(selector, nullptr);
+        if (selector == nullptr) return result;
+        if (selectDefault) {
+            selector->setCurrentIndex(0);
+        } else {
+            selector->setWidth(std::make_shared<lc::meta::MetaLineWidthByValue>(0.25));
+        }
+        EXPECT_TRUE(QMetaObject::invokeMethod(&dialog, "accept"));
+        return result;
+    };
+
+    for (const auto& item : {std::make_pair(originalDefault, true),
+                             std::make_pair(originalDefault, false),
+                             std::make_pair(originalExplicit, true),
+                             std::make_pair(originalExplicit, false)}) {
+        auto result = edit(item.first, item.second);
+        ASSERT_NE(result, nullptr);
+        EXPECT_EQ(result->usesDefaultLineWidth(), item.second);
+        EXPECT_TRUE(result->isFrozen());
+        EXPECT_DOUBLE_EQ(result->lineWidth().width(), 0.25);
+    }
+}
+
+TEST(LayersTest, RenamingKeepsDefaultLineweight) {
+    ensureUiApplication();
+    lc::ui::CadMdiChild mdiChild;
+    mdiChild.newDocument();
+    LayersTest layers(&mdiChild);
+    auto original = std::make_shared<const lc::meta::Layer>(
+        "DefaultWidth", lc::meta::MetaLineWidthByValue(0.25),
+        lc::Color(255, 255, 255, 255), nullptr, false, true);
+    layers.addLayer(original);
+    layers.renameLayer("DefaultWidth", "RenamedDefault");
+    auto renamed = layers.layerByName("RenamedDefault");
+    ASSERT_NE(renamed, nullptr);
+    EXPECT_TRUE(renamed->usesDefaultLineWidth());
+    EXPECT_DOUBLE_EQ(renamed->lineWidth().width(), 0.25);
+}
