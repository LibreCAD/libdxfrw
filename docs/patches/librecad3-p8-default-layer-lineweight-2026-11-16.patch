+
+// A legacy LAYER has no group 370. Import should retain its default state,
+// rather than manufacture an explicit 0 mm width that then looks lost.
+// NOLINTNEXTLINE(readability-identifier-naming)
+TEST(DxfRoundTripTest, LegacyAbsentLayerLineweightRemainsDefault) {
+    const auto source = uniqueTmpDxf("legacy-default-layer-width");
+    {
+        std::ofstream file(source);
+        ASSERT_TRUE(file << "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1009\n0\nENDSEC\n"
+                         "0\nSECTION\n2\nTABLES\n0\nTABLE\n2\nLAYER\n70\n1\n"
+                         "0\nLAYER\n2\n0\n70\n0\n62\n7\n6\nCONTINUOUS\n"
+                         "0\nENDTAB\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n"
+                         "0\nLINE\n8\n0\n10\n0\n20\n0\n11\n4\n21\n3\n"
+                         "0\nENDSEC\n0\nEOF\n");
+    }
+    auto doc = newDocument();
+    ASSERT_TRUE(lc::persistence::File::importFile(
+        doc, source, lc::persistence::File::Library::LIBDXFRW).ok);
+    ASSERT_NE(doc->layerByName("0"), nullptr);
+    EXPECT_TRUE(doc->layerByName("0")->usesDefaultLineWidth());
+    EXPECT_DOUBLE_EQ(doc->layerByName("0")->lineWidth().width(), 0.25);
+    const lc::persistence::File::Type targets[] = {
+        lc::persistence::File::LIBDXFRW_DXF_R12,
+        lc::persistence::File::LIBDXFRW_DXF_R14,
+        lc::persistence::File::LIBDXFRW_DXB_R12,
+        lc::persistence::File::LIBDXFRW_DXB_R14,
+        lc::persistence::File::LIBDXFRW_DXF_R2000,
+        lc::persistence::File::LIBDXFRW_DXB_R2000};
+    for (const auto type : targets) {
+        const auto path = uniqueTmpDxf("legacy-default-layer-export");
+        const auto written = lc::persistence::File::exportFile(doc, path, type);
+        ASSERT_TRUE(written.ok) << static_cast<int>(type);
+        EXPECT_TRUE(written.loss.empty()) << static_cast<int>(type);
+        EXPECT_TRUE(lc::persistence::File::save(doc, path, type));
+        auto reopened = newDocument();
+        ASSERT_TRUE(lc::persistence::File::importFile(
+            reopened, path, lc::persistence::File::Library::LIBDXFRW).ok);
+        ASSERT_NE(reopened->layerByName("0"), nullptr);
+        EXPECT_TRUE(reopened->layerByName("0")->usesDefaultLineWidth());
+        EXPECT_DOUBLE_EQ(reopened->layerByName("0")->lineWidth().width(), 0.25);
+        EXPECT_EQ(entitiesInDocument(reopened)["Line"], 1u);
+        boost::filesystem::remove(path);
+    }
+    boost::filesystem::remove(source);
+}
+
+
+// NOLINTNEXTLINE(readability-identifier-naming)
+TEST(DxfRoundTripTest, DefaultAndExplicitLayerWidthsRemainDistinct) {
+    auto doc = newDocument();
+    auto layerDefault = std::make_shared<lc::meta::Layer>(
+        "DEFAULT_WIDTH", lc::meta::MetaLineWidthByValue(0.25),
+        lc::Color(255, 255, 255, 255), nullptr, false, true);
+    auto layerExplicit = std::make_shared<lc::meta::Layer>(
+        "EXPLICIT_WIDTH", lc::meta::MetaLineWidthByValue(0.25),
+        lc::Color(255, 255, 255, 255));
+    std::make_shared<lc::operation::AddLayer>(doc, layerDefault)->execute();
+    std::make_shared<lc::operation::AddLayer>(doc, layerExplicit)->execute();
+    lc::builder::LayerBuilder builder;
+    builder.setName("BUILT")->setLineWidth(lc::meta::MetaLineWidthByValue(0.25))
+        ->setUsesDefaultLineWidth(true);
+    EXPECT_TRUE(builder.build()->usesDefaultLineWidth());
+    builder.setLineWidth(lc::meta::MetaLineWidthByValue(0.25));
+    EXPECT_FALSE(builder.build()->usesDefaultLineWidth());
+    for (const auto type : {lc::persistence::File::LIBDXFRW_DXF_R2000,
+                            lc::persistence::File::LIBDXFRW_DXB_R2000}) {
+        const auto path = uniqueTmpDxf("default-explicit-layer");
+        const auto saved = lc::persistence::File::exportFile(doc, path, type);
+        ASSERT_TRUE(saved.ok);
+        EXPECT_TRUE(saved.loss.empty());
+        if (type == lc::persistence::File::LIBDXFRW_DXF_R2000) {
+            std::ifstream input(path);
+            std::string code, value, layerName;
+            bool inLayer = false;
+            std::map<std::string, int> weights;
+            while (std::getline(input, code) && std::getline(input, value)) {
+                if (!value.empty() && value.back() == '\r') value.pop_back();
+                const int group = std::stoi(code);
+                if (group == 0) {
+                    inLayer = value == "LAYER";
+                    layerName.clear();
+                } else if (inLayer && group == 2) {
+                    layerName = value;
+                } else if (inLayer && group == 370) {
+                    weights[layerName] = std::stoi(value);
+                }
+            }
+            ASSERT_EQ(weights.count("DEFAULT_WIDTH"), 1u);
+            ASSERT_EQ(weights.count("EXPLICIT_WIDTH"), 1u);
+            EXPECT_EQ(weights.at("DEFAULT_WIDTH"), -3);
+            EXPECT_EQ(weights.at("EXPLICIT_WIDTH"), 25);
+        }
+        auto reopened = newDocument();
+        ASSERT_TRUE(lc::persistence::File::importFile(
+            reopened, path, lc::persistence::File::Library::LIBDXFRW).ok);
+        ASSERT_NE(reopened->layerByName("DEFAULT_WIDTH"), nullptr);
+        ASSERT_NE(reopened->layerByName("EXPLICIT_WIDTH"), nullptr);
+        EXPECT_TRUE(reopened->layerByName("DEFAULT_WIDTH")->usesDefaultLineWidth());
+        EXPECT_FALSE(reopened->layerByName("EXPLICIT_WIDTH")->usesDefaultLineWidth());
+        EXPECT_DOUBLE_EQ(reopened->layerByName("DEFAULT_WIDTH")->lineWidth().width(), 0.25);
+        EXPECT_DOUBLE_EQ(reopened->layerByName("EXPLICIT_WIDTH")->lineWidth().width(), 0.25);
+        boost::filesystem::remove(path);
+    }
+}
