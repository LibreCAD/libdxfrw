@@ -86,0 +102,38 @@ class TestImportDXF(TestImportBase):
+    @unittest.skipUnless(FreeCAD.GuiUp, "GUI view providers are required")
+    def test_frozen_layer_group_initial_visibility(self):
+        """Hide globally frozen Draft layers while keeping viewport-only flags distinct."""
+        import Draft  # noqa: F401 - enable the real Draft layer route
+        import ImportGui
+
+        options = FreeCAD.ParamGet(self.option_source)
+        options.SetBool("dxfUseDraftVisGroups", True)
+        cases = (("ON", 0, 2, True), ("FROZEN", 1, 2, False),
+                 ("NEWVIEW", 2, 2, True), ("OFF", 0, -2, False),
+                 ("FROZENOFF", 1, -2, False))
+        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"),
+                (2, "TABLES"), (0, "TABLE"), (2, "LAYER"), (70, len(cases))]
+        for name, flags, color, _ in cases:
+            tags.extend([(0, "LAYER"), (2, name), (70, flags), (62, color), (6, "CONTINUOUS")])
+        tags.extend([(0, "ENDTAB"), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES")])
+        for index, (name, _, _, _) in enumerate(cases):
+            tags.extend([(0, "LINE"), (8, name), (10, 0), (20, index), (30, 0),
+                         (11, 2), (21, index), (31, 0)])
+        tags.extend([(0, "ENDSEC"), (0, "EOF")])
+        path = os.path.join(self.temp_dir, "frozen-layer-visibility.dxf")
+        with open(path, "w", encoding="ascii", newline="\n") as stream:
+            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+        stats = ImportGui.readDXF(path, self.document.Name, True, self.option_source)
+        self.document.recompute()
+        self.assertEqual(len(stats["unsupportedFeatures"]["Frozen layers"]), 2)
+        layers = {obj.Label: obj for obj in self.document.Objects
+                  if getattr(getattr(obj, "Proxy", None), "Type", None) == "Layer"}
+        for name, _, _, visible in cases:
+            with self.subTest(layer=name):
+                layer = layers[name]
+                self.assertEqual(len(layer.Group), 1)
+                self.assertEqual(layer.ViewObject.Visibility, visible)
+                self.assertEqual(layer.Group[0].ViewObject.Visibility, visible)
+                layer.ViewObject.Visibility = True
+                self.assertTrue(layer.Group[0].ViewObject.Visibility)
+
