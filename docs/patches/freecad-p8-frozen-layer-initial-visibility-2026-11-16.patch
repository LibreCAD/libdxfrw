+    def test_frozen_layer_without_grouping_remains_reported(self):
+        """Frozen-only is still reported, without mislabeling the layer as off."""
+        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                (0, "ENDSEC"), (0, "SECTION"), (2, "TABLES"), (0, "TABLE"),
+                (2, "LAYER"), (70, 1), (0, "LAYER"), (2, "FROZEN"), (70, 1),
+                (62, 2), (6, "CONTINUOUS"), (0, "ENDTAB"), (0, "ENDSEC"),
+                (0, "SECTION"), (2, "ENTITIES"), (0, "LINE"), (8, "FROZEN"),
+                (10, 0), (20, 0), (30, 0), (11, 2), (21, 0), (31, 0), (0, "ENDSEC"), (0, "EOF")]
+        path = os.path.join(self.temp_dir, "frozen-layer-no-grouping.dxf")
+        with open(path, "w", encoding="ascii", newline="\n") as stream:
+            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+        stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+        self.assertIn("Frozen layers", stats["unsupportedFeatures"])
+        self.assertNotIn("Off-layer visibility without layer grouping", stats["unsupportedFeatures"])
