+TEST_CASE("Named block export refuses an unhandled dictionary dependency",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE to an ODA AC1024 DWG with OTHER XRECORD");
+  REQUIRE(std::filesystem::exists(fixture));
+  ensureSettings();
+  RS_Graphic graphic;
+  RS_FilterDXFRW filter;
+  REQUIRE(filter.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  const auto &dicts = graphic.dwgAdvancedMetadata().dictionaries();
+  const auto dict = std::find_if(dicts.begin(), dicts.end(), [](const auto &d) {
+    return d.handle == 0xB003u;
+  });
+  REQUIRE(dict != dicts.end());
+  REQUIRE(std::count_if(dict->entries.begin(), dict->entries.end(), [](const auto &e) {
+    return e.name == "OTHER" && e.handle == 0xB200u;
+  }) == 1);
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(true));
+  const std::string path = tmpFile("named_sort_extra_dependency.dxf");
+  const std::string sentinel = "previous destination\n";
+  writeText(path, sentinel);
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  CHECK(filter.lastError().contains("referenced objects are incomplete"));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  const char *minimal = std::getenv("LIBRECAD_ODA_MINIMAL_SORTENTS_FIXTURE");
+  if (minimal && *minimal) {
+    RS_Graphic clean;
+    REQUIRE(filter.fileImport(clean, QString::fromUtf8(minimal), RS2::FormatDWG));
+    REQUIRE(filter.fileExport(clean, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  }
+  std::filesystem::remove(path);
+}
