+TEST_CASE("Explicit named block sort export preserves verified source chain",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_MINIMAL_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_MINIMAL_SORTENTS_FIXTURE to a locally generated ODA AC1024 DWG");
+  REQUIRE(std::filesystem::exists(fixture));
+  ensureSettings();
+  RS_Graphic graphic;
+  RS_FilterDXFRW filter;
+  REQUIRE(filter.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  REQUIRE(graphic.dwgAdvancedMetadata().matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB100u));
+  const char *keepPath = std::getenv("LIBRECAD_KEEP_NAMED_SORTENTS_DXF");
+  const std::string path = keepPath && *keepPath ? keepPath : tmpFile("named_sort_optin.dxf");
+  const std::string sentinel = "previous destination\n";
+  writeText(path, sentinel);
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(true));
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  RS_Graphic reread;
+  RS_FilterDXFRW rereader;
+  REQUIRE(rereader.fileImport(reread, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  const auto &readMetadata = reread.dwgAdvancedMetadata();
+  REQUIRE(readMetadata.sortEntsTables().size() == 1u);
+  const auto &table = readMetadata.sortEntsTables().front();
+  CHECK(table.entityHandles.empty());
+  CHECK(table.sortHandles.empty());
+  const auto block = readMetadata.blockRecordLinks().find(table.blockOwnerHandle);
+  REQUIRE(block != readMetadata.blockRecordLinks().end());
+  CHECK(block->second.name == "Named");
+  CHECK(block->second.extensionDictionaryHandle == table.parentHandle);
+  const auto dict = std::find_if(readMetadata.dictionaries().begin(), readMetadata.dictionaries().end(),
+      [&table](const auto &d) { return d.handle == table.parentHandle; });
+  REQUIRE(dict != readMetadata.dictionaries().end());
+  CHECK(dict->parentHandle == table.blockOwnerHandle);
+  CHECK(std::count_if(dict->entries.begin(), dict->entries.end(), [&table](const auto &entry) {
+    return entry.name == "ACAD_SORTENTS" && entry.handle == table.handle;
+  }) == 1);
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(false));
+  writeText(path, sentinel);
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(true));
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  if (!(keepPath && *keepPath))
