@@ -11484,0 +11493,72 @@ TEST_CASE("Binary DXF imports an editable line type definition",
+// Optional external-producer controls: inputs are made from a locally
+// authored drawing with ODA File Converter; no drawing fixture is stored here.
+TEST_CASE("R13 DXF imports an editable line type from ODA",
+          "[dxf][roundtrip][filter][ltype][linetype][binary][r13]") {
+  const char *ascii = std::getenv("LIBRECAD_R13_LTYPE_ASCII");
+  const char *binary = std::getenv("LIBRECAD_R13_LTYPE_BINARY");
+  if (!ascii || !*ascii || !binary || !*binary)
+    SKIP("Set LIBRECAD_R13_LTYPE_ASCII and LIBRECAD_R13_LTYPE_BINARY to locally generated ODA files");
+  ensureSettings();
+  for (const auto &source : {std::pair<const char *, bool>{ascii, false},
+                             std::pair<const char *, bool>{binary, true}}) {
+    const char *src = source.first;
+    CAPTURE(src);
+    std::ifstream input(src, std::ios::binary);
+    REQUIRE(input.is_open());
+    const std::string bytes(std::istreambuf_iterator<char>(input), {});
+    CHECK((bytes.compare(0, 18, "AutoCAD Binary DXF") == 0) == source.second);
+    if (source.second) {
+      const std::string versionPair("\x09\0$ACADVER\0\x01\0AC1012\0", 20);
+      REQUIRE(bytes.find(versionPair) != std::string::npos);
+    } else {
+      std::istringstream groups(bytes);
+      std::string code, value;
+      bool foundVersion = false;
+      while (std::getline(groups, code) && std::getline(groups, value)) {
+        if (QString::fromStdString(code).trimmed() != QStringLiteral("9") ||
+            QString::fromStdString(value).trimmed() != QStringLiteral("$ACADVER"))
+          continue;
+        REQUIRE(std::getline(groups, code));
+        REQUIRE(std::getline(groups, value));
+        foundVersion = QString::fromStdString(code).trimmed() == QStringLiteral("1") &&
+                       QString::fromStdString(value).trimmed() == QStringLiteral("AC1012");
+        break;
+      }
+      REQUIRE(foundVersion);
+    }
+    RS_Graphic graphic;
+    REQUIRE(importFile(graphic, src));
+    LC_LineType *entry = graphic.findLineType(QStringLiteral("VENDOR_BINARY"));
+    REQUIRE(entry != nullptr);
+    REQUIRE(entry->pattern == std::vector<double>{10.0, -5.0});
+    entry->pattern = {20.0, -10.0};
+    entry->description = QStringLiteral("Edited marks");
+    const std::string out = tmpFile("ltype_r13_peer_out.dxf");
+    const std::string sentinel = "previous drawing\n";
+    writeText(out, sentinel);
+    RS_FilterDXFRW exporter;
+    const bool success = exporter.fileExport(graphic, QString::fromStdString(out), RS2::FormatDXFRW);
+    if (!success) {
+      CHECK(exporter.lastErrorCode() != DRW::BAD_NONE);
+      CHECK(exporter.lastError() != QStringLiteral("no DXF/DWG error"));
+      std::ifstream retained(out, std::ios::binary);
+      CHECK(std::string(std::istreambuf_iterator<char>(retained), {}) == sentinel);
+      retained.close();
+      RS_Graphic retry;
+      REQUIRE(exporter.fileExport(retry, QString::fromStdString(out), RS2::FormatDXFRW));
+      CHECK(exporter.lastErrorCode() == DRW::BAD_NONE);
+    } else {
+      CHECK(ltypeRecordsSpelt(out, "VENDOR_BINARY") == Records{{20.0, -10.0}});
+      CHECK(recordGroupValues(out, "LINE", "6") ==
+            std::vector<std::string>{"VENDOR_BINARY"});
+      RS_Graphic back;
+      REQUIRE(importFile(back, out));
+      const LC_LineType *saved = importedEntry(back, "VENDOR_BINARY");
+      REQUIRE(saved != nullptr);
+      CHECK(saved->pattern == std::vector<double>{20.0, -10.0});
+      CHECK(saved->description == QStringLiteral("Edited marks"));
+    }
+    std::filesystem::remove(out);
+  }
+}
