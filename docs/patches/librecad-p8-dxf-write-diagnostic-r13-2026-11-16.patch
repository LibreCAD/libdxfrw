+// Newer codecs expose a structured write diagnostic. The bundled codec may
+// only provide the legacy error enum, so keep the detail optional.
+template <typename Writer>
+auto dxfWriteDiagnosticIfAvailable(const Writer &writer, int)
+    -> decltype(writer.getLastDiagnostic().message, QString()) {
+  return QString::fromStdString(writer.getLastDiagnostic().message);
+}
