+#if defined(LIBDXFRW_HAS_AC1024_EMPTY_SORTENTS_SOURCE_VERIFY) && defined(LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY)
+TEST_CASE("ODA generated empty sort table without reactors retains source chain",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE to a locally generated ODA AC1024 DWG");
+  REQUIRE(std::filesystem::exists(fixture));
+  ensureSettings(); RS_Graphic graphic; RS_FilterDXFRW reader;
+  REQUIRE(reader.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  auto &md = graphic.dwgAdvancedMetadata();
+  REQUIRE(md.selectedDwgSourceCaptureSessionSealed());
+  REQUIRE_FALSE(md.sortEntsSourceCaptureFailed());
+  REQUIRE(md.emptySortEntsSourceObservations().count(0xB100u) == 1u);
+  CHECK(md.emptySortEntsSourceObservations().at(0xB100u).reactorCount() == 0);
+  CHECK(md.matchesAc1024EmptySortEntsSourceObservation(0xB100u));
+  CHECK(md.matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB100u));
+  CHECK_FALSE(md.matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB200u));
+  const auto duplicate = md.emptySortEntsSourceObservations().at(0xB100u);
+  md.observeEmptySortEntsSource(duplicate);
+  CHECK(md.sortEntsSourceCaptureFailed());
+  CHECK_FALSE(md.selectedDwgSourceCaptureSessionSealed());
+  md.clear();
+  REQUIRE(reader.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  CHECK(graphic.dwgAdvancedMetadata().matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB100u));
+}
+#endif
+
