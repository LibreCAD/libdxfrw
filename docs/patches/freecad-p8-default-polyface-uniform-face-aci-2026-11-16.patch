+    def test_bounded_polyface_uniform_face_aci_override(self):
+        """Admit one explicit face color; refuse mixed or ambiguous faces."""
+        options = FreeCAD.ParamGet(self.option_source)
+        options.SetBool("dxfGetOriginalColors", True)
+        cases = [("uniform", (2, 2), True), ("mixed", (2, 3), False),
+                 ("ambiguous", (2, None), False), ("bylayer", (2, 256), False)]
+        for name, face_colors, accepted in cases:
+            with self.subTest(profile=name):
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"),
+                        (2, "ENTITIES"), (0, "POLYLINE"), (8, "0"), (66, 1), (70, 64), (62, 1)]
+                for x, y in ((0, 0), (4, 0), (4, 3), (0, 3)):
+                    tags.extend([(0, "VERTEX"), (8, "0"), (10, x), (20, y), (30, 0), (70, 192), (62, 1)])
+                for indices, color in zip(((1, 2, 3), (1, 3, 4)), face_colors):
+                    tags.extend([(0, "VERTEX"), (8, "0"), (10, 0), (20, 0), (30, 0), (70, 128)])
+                    tags.extend((71 + index, value) for index, value in enumerate(indices))
+                    if color is not None: tags.append((62, color))
+                tags.extend([(0, "SEQEND"), (8, "0"), (0, "LINE"), (8, "0"),
+                             (10, 10), (20, 0), (30, 0), (11, 12), (21, 0), (31, 0),
+                             (0, "ENDSEC"), (0, "EOF")])
+                path = os.path.join(self.temp_dir, f"uniform-face-color-{name}.dxf")
+                with open(path, "w", encoding="ascii", newline="\n") as stream:
+                    stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                previous = set(self.document.Objects)
+                stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                objects = [obj for obj in self.document.Objects if obj not in previous
+                           and obj.isDerivedFrom("Part::Feature")]
+                meshes = [obj for obj in objects if obj.Name.startswith("Polyface")]
+                lines = [obj for obj in objects if obj.Name.startswith("Shape")]
+                self.assertEqual(len(lines), 1)
+                self.assertEqual(len(meshes), int(accepted))
+                if accepted:
+                    self.assertEqual(stats["unsupportedFeatures"], {})
+                    self.assertEqual(len(meshes[0].Shape.Faces), 2)
+                    self.assertAlmostEqual(meshes[0].Shape.Area, 12.0)
+                else:
+                    self.assertIn("POLYFACE unsupported or invalid profile", stats["unsupportedFeatures"])
+
+    def test_bounded_polyface_face_aci_controls_fused_group(self):
+        """The face ACI, rather than the mesh header ACI, groups geometry."""
+        options = FreeCAD.ParamGet(self.option_source)
+        options.SetInt("DxfImportMode", 3)
+        for preserve in (False, True):
+            with self.subTest(preserve=preserve):
+                options.SetBool("dxfGetOriginalColors", preserve)
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES")]
+                # Both faces are ACI 2 even though the first parent is ACI 1.
+                for offset, parent_color in ((0, 1), (10, 2)):
+                    tags.extend([(0, "POLYLINE"), (8, "0"), (66, 1), (70, 64), (62, parent_color)])
+                    for x, y in ((offset, 0), (offset + 4, 0), (offset, 3)):
+                        tags.extend([(0, "VERTEX"), (8, "0"), (10, x), (20, y), (30, 0),
+                                     (70, 192), (62, parent_color)])
+                    tags.extend([(0, "VERTEX"), (8, "0"), (10, 0), (20, 0), (30, 0),
+                                 (70, 128), (71, 1), (72, 2), (73, 3), (62, 2),
+                                 (0, "SEQEND"), (8, "0")])
+                tags.extend([(0, "ENDSEC"), (0, "EOF")])
+                path = os.path.join(self.temp_dir, f"face-color-group-{preserve}.dxf")
+                with open(path, "w", encoding="ascii", newline="\n") as stream:
+                    stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                previous = set(self.document.Objects)
+                stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                objects = [obj for obj in self.document.Objects if obj not in previous
+                           and obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull()]
+                self.assertEqual(stats["unsupportedFeatures"], {})
+                self.assertEqual(len(objects), 1)
+                self.assertAlmostEqual(objects[0].Shape.Area, 12.0)
+
+    def test_bounded_polyface_mixed_color_then_valid_same_file(self):
+        """A mixed-color refusal must not leak faces or affect a following mesh."""
+        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES")]
+        for offset, colors in ((0, (2, 3)), (10, (2, 2))):
+            tags.extend([(0, "POLYLINE"), (8, "0"), (66, 1), (70, 64), (62, 1)])
+            for x, y in ((offset, 0), (offset + 4, 0), (offset + 4, 3), (offset, 3)):
+                tags.extend([(0, "VERTEX"), (8, "0"), (10, x), (20, y), (30, 0), (70, 192), (62, 1)])
+            for indices, color in zip(((1, 2, 3), (1, 3, 4)), colors):
+                tags.extend([(0, "VERTEX"), (8, "0"), (10, 0), (20, 0), (30, 0), (70, 128), (62, color)])
+                tags.extend((71 + index, value) for index, value in enumerate(indices))
+            tags.extend([(0, "SEQEND"), (8, "0")])
+        tags.extend([(0, "LINE"), (8, "0"), (10, 20), (20, 0), (30, 0),
+                     (11, 22), (21, 0), (31, 0), (0, "ENDSEC"), (0, "EOF")])
+        path = os.path.join(self.temp_dir, "face-color-recovery.dxf")
+        with open(path, "w", encoding="ascii", newline="\n") as stream:
+            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+        previous = set(self.document.Objects)
+        stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+        objects = [obj for obj in self.document.Objects if obj not in previous
+                   and obj.isDerivedFrom("Part::Feature")]
+        meshes = [obj for obj in objects if obj.Name.startswith("Polyface")]
+        lines = [obj for obj in objects if obj.Name.startswith("Shape")]
+        self.assertEqual(len(meshes), 1)
+        self.assertEqual(len(lines), 1)
+        self.assertEqual(len(meshes[0].Shape.Faces), 2)
+        self.assertAlmostEqual(meshes[0].Shape.Area, 12.0)
+        self.assertEqual(len(stats["unsupportedFeatures"]["POLYFACE unsupported or invalid profile"]), 1)
