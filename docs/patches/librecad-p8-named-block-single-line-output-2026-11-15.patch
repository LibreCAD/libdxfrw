+static bool selectedSingleSourceLine(RS_Graphic &graphic, std::uint32_t blockHandle,
+                                     std::uint32_t &lineHandle, std::string &blockName) noexcept {
+  try {
+    const auto &metadata = graphic.dwgAdvancedMetadata();
+    const auto found = metadata.blockRecordLinks().find(blockHandle);
+    if (found == metadata.blockRecordLinks().end() || found->second.sourceEntityCount != 1u
+        || !found->second.singleEntitySource || !found->second.singleLineSource)
+      return false;
+    const auto &source = found->second;
+    const RS_Block *block = nullptr;
+    const QString expected = QString::fromUtf8(source.name.c_str());
+    for (unsigned i = 0; i < graphic.countBlocks(); ++i) {
+      const RS_Block *candidate = graphic.blockAt(i);
+      if (candidate->isDeleted() || candidate->getName().compare(expected, Qt::CaseInsensitive) != 0)
+        continue;
+      if (block != nullptr) return false;
+      block = candidate;
+    }
+    if (block == nullptr || block->sourceHandle() != blockHandle)
+      return false;
+    lc::LC_ContainerTraverser walk{*block, RS2::ResolveNone};
+    RS_Entity *line = walk.first();
+    if (line == nullptr || line->isDeleted() || line->rtti() != RS2::EntityLine
+        || line->sourceHandle() == 0u || line->sourceHandle() == DRW::NoHandle
+        || walk.next() != nullptr)
