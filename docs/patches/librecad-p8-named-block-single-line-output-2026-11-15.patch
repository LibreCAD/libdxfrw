+    const auto &original = *source.singleLineSource;
+    const auto *current = static_cast<const RS_Line *>(line);
+    const RS_Layer *layer = current->getLayer(false);
+    const RS_Pen pen = current->getPen(false);
+    if (layer == nullptr || layer->getName() != QStringLiteral("0")
+        || pen.getLineType() != RS2::LineByLayer || pen.getWidth() != RS2::WidthByLayer
+        || !pen.getColor().isByLayer())
+      return false;
+    if (!source.singleEntitySource->matchesEntityMap(sourceHandles)
+        || original.handle != line->sourceHandle() || original.parentHandle != blockHandle
+        || current->getStartpoint().x != original.basePoint.x
+        || current->getStartpoint().y != original.basePoint.y
+        || current->getEndpoint().x != original.secPoint.x
+        || current->getEndpoint().y != original.secPoint.y)
+      return false;
+    const DRW_DwgFramePublication *publication = nullptr;
+    const DRW_DwgFrameCoverageEntry *coverage = nullptr;
+    for (const auto &item : metadata.dwgFramePublications())
+      if (item.m_handle == original.handle) { if (publication) return false; publication = &item; }
+    for (const auto &item : metadata.dwgFrameCoverageReport().m_entries)
+      if (item.m_handle == original.handle) { if (coverage) return false; coverage = &item; }
+    if (!publication || !coverage || !publication->m_hasSourceLocation
+        || (publication->m_sourceOffsetSpace != DRW_DwgFrameOffsetSpace::PhysicalFile
+            && publication->m_sourceOffsetSpace != DRW_DwgFrameOffsetSpace::DecodedBuffer)
+        || publication->m_encodedType != 19 || publication->m_resolvedType != 19
