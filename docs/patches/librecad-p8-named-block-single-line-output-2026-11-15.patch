+#ifdef LIBDXFRW_HAS_AC1024_EMPTY_XRECORD_SOURCE_VERIFY
+TEST_CASE("Named block export preserves one verified source line",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_NAMED_BLOCK_LINE_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_NAMED_BLOCK_LINE_FIXTURE to a locally generated ODA AC1024 DWG");
+  ensureSettings(); RS_Graphic graphic; RS_FilterDXFRW filter;
+  REQUIRE(filter.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  const auto &md = graphic.dwgAdvancedMetadata();
+  REQUIRE(md.matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB100u));
+  REQUIRE(md.blockRecordLinks().at(0x30u).sourceEntityCount == 1u);
+  RS_Block *block = nullptr;
+  for (unsigned i = 0; i < graphic.countBlocks(); ++i)
+    if (graphic.blockAt(i)->getName() == QStringLiteral("Named")) block = graphic.blockAt(i);
+  REQUIRE(block != nullptr);
+  lc::LC_ContainerTraverser sourceWalk{*block, RS2::ResolveNone};
+  RS_Entity *entity = sourceWalk.first();
+  REQUIRE(entity != nullptr); REQUIRE(entity->rtti() == RS2::EntityLine);
+  REQUIRE(sourceWalk.next() == nullptr);
+  const auto sourceHandle = entity->sourceHandle();
+  REQUIRE(sourceHandle != 0u);
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(true));
+  const char *keepPath = std::getenv("LIBRECAD_KEEP_NAMED_BLOCK_LINE_DXF");
+  const std::string path = keepPath && *keepPath ? keepPath : tmpFile("named_sort_line.dxf");
+  const std::string sentinel = "previous destination\n";
+  writeText(path, sentinel);
+  entity->setSourceHandle(sourceHandle ^ 1u);
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  entity->setSourceHandle(sourceHandle);
+  auto *sourceLine = static_cast<RS_Line *>(entity);
+  const auto originalEnd = sourceLine->getEndpoint();
+  sourceLine->setEndpoint(RS_Vector(originalEnd.x + 1.0, originalEnd.y));
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  sourceLine->setEndpoint(originalEnd);
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  RS_Graphic reread; RS_FilterDXFRW rereader;
+  REQUIRE(rereader.fileImport(reread, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  const RS_Block *readBlock = nullptr;
+  for (unsigned i = 0; i < reread.countBlocks(); ++i)
+    if (reread.blockAt(i)->getName() == QStringLiteral("Named")) readBlock = reread.blockAt(i);
+  REQUIRE(readBlock != nullptr);
+  lc::LC_ContainerTraverser readWalk{*readBlock, RS2::ResolveNone};
+  const RS_Entity *out = readWalk.first();
+  REQUIRE(out != nullptr); REQUIRE(out->rtti() == RS2::EntityLine);
+  CHECK(readWalk.next() == nullptr);
+  const auto *line = static_cast<const RS_Line *>(out);
+  CHECK(line->getStartpoint().x == Catch::Approx(1.0));
+  CHECK(line->getStartpoint().y == Catch::Approx(2.0));
+  CHECK(line->getEndpoint().x == Catch::Approx(3.0));
+  CHECK(line->getEndpoint().y == Catch::Approx(4.0));
