diff --git a/src/Mod/Import/importtests/TestImportDXF.py b/src/Mod/Import/importtests/TestImportDXF.py
--- a/src/Mod/Import/importtests/TestImportDXF.py
+++ b/src/Mod/Import/importtests/TestImportDXF.py
@@ -1997,0 +1998,50 @@
+    def test_classic_polyline_2d_ocs_and_3d_wcs(self):
+        """Classic 2D vertices use the parent OCS; 3D vertices stay in WCS."""
+        import math
+        options = FreeCAD.ParamGet(self.option_source)
+        entities = [(0, "POLYLINE"), (8, "0"), (66, 1), (70, 0), (10, 0), (20, 0), (30, 5),
+                    (210, 0), (220, 1), (230, 0),
+                    (0, "VERTEX"), (8, "0"), (70, 0), (10, 0), (20, 0), (30, 0), (42, 1),
+                    (0, "VERTEX"), (8, "0"), (70, 0), (10, 2), (20, 0), (30, 0),
+                    (0, "VERTEX"), (8, "0"), (70, 0), (10, 2), (20, 1), (30, 0), (0, "SEQEND"), (8, "0"),
+                    (0, "POLYLINE"), (8, "0"), (66, 1), (70, 8), (10, 0), (20, 0), (30, 0),
+                    (210, 0), (220, 1), (230, 0),
+                    (0, "VERTEX"), (8, "0"), (70, 32), (10, 1), (20, 2), (30, 3),
+                    (0, "VERTEX"), (8, "0"), (70, 32), (10, 4), (20, 5), (30, 6), (0, "SEQEND"), (8, "0")]
+        header = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                  (9, "$INSUNITS"), (70, 4), (0, "ENDSEC")]
+        for mode in (2, 3):
+            options.SetInt("DxfImportMode", mode)
+            for nested in (False, True):
+                with self.subTest(mode=mode, nested=nested):
+                    if nested:
+                        tags = header + [(0, "SECTION"), (2, "BLOCKS"), (0, "BLOCK"), (8, "0"),
+                                         (2, "B"), (70, 0), (10, 0), (20, 0), (30, 0)] + entities + [
+                                         (0, "ENDBLK"), (8, "0"), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES"),
+                                         (0, "INSERT"), (8, "0"), (2, "B"), (10, 0), (20, 0), (30, 0)]
+                    else:
+                        tags = header + [(0, "SECTION"), (2, "ENTITIES")] + entities
+                    tags += [(0, "ENDSEC"), (0, "EOF")]
+                    path = os.path.join(self.temp_dir, "classic-polyline-ocs.dxf")
+                    with open(path, "w", encoding="ascii", newline="\n") as stream:
+                        stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                    previous = set(self.document.Objects)
+                    Import.readDXF(path, self.document.Name, True, self.option_source)
+                    self.document.recompute()
+                    name = "Link_B" if nested else ("Compound" if mode == 3 else "Polyline")
+                    objects = [o for o in self.document.Objects if o not in previous and o.Name.startswith(name)]
+                    edges = [edge for obj in objects for edge in obj.Shape.Edges]
+                    self.assertEqual(len(edges), 3)
+                    arc = [e for e in edges if abs(e.Length - math.pi) < 0.00001]
+                    world = [e for e in edges if abs(e.Length - math.sqrt(27)) < 0.00001]
+                    line = [e for e in edges if abs(e.Length - 1) < 0.00001]
+                    self.assertEqual((len(arc), len(world), len(line)), (1, 1, 1))
+                    midpoint = arc[0].valueAt((arc[0].FirstParameter + arc[0].LastParameter) / 2)
+                    for actual, expected in zip((midpoint.x, midpoint.y, midpoint.z), (-1, 5, -1)):
+                        self.assertAlmostEqual(actual, expected, delta=0.00001)
+                    def ends(edge):
+                        return tuple(sorted((round(v.Point.x, 6), round(v.Point.y, 6), round(v.Point.z, 6))
+                                            for v in edge.Vertexes))
+                    self.assertEqual(ends(line[0]), ((-2, 5, 0), (-2, 5, 1)))
+                    self.assertEqual(ends(world[0]), ((1, 2, 3), (4, 5, 6)))
+
