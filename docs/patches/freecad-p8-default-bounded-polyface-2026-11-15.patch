+bool CDxfRead::ReadPolyface(
+    bool profileValid, const std::string& parentHandle, const std::string& containerHandle
+)
+{
+    // Handles are optional in this geometry profile, but if supplied they
+    // must be valid and unique; owner spelling is compared canonically.
+    const auto canonicalHandle = [](const std::string& raw) {
+        std::string result;
+        if (raw.empty() || raw.size() > 16) return result;
+        for (unsigned char c : raw) {
+            if (!std::isxdigit(c)) return std::string();
+            result.push_back(static_cast<char>(std::toupper(c)));
+        }
+        const auto first = result.find_first_not_of('0');
+        return first == std::string::npos ? std::string() : result.substr(first);
+    };
+    const std::string canonicalParent = canonicalHandle(parentHandle);
+    const std::string canonicalContainer = canonicalHandle(containerHandle);
