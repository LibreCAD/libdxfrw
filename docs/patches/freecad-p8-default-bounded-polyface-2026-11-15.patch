+void CDxfRead::ProcessPolyfaceInteger(CDxfRead* object, void* target)
+{
+    auto& destination = *static_cast<int*>(target);
+    if (destination != -1) {
+        destination = -2;
+        return;
+    }
+    std::istringstream stream(object->m_record_data);
+    stream.imbue(std::locale("C"));
+    int value = 0;
+    if (!(stream >> value) || !(stream >> std::ws).eof() || value < 0 || value > 32767) {
+        destination = -2;
+        return;
+    }
+    destination = value;
+}
