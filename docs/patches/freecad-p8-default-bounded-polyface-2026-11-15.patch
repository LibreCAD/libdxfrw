+void ImpExpDxfRead::OnReadPolyface(
+    const std::vector<Base::Vector3d>& vertices,
+    const std::vector<std::vector<std::size_t>>& faces
+)
+{
+    if (shouldSkipEntity()) {
+        return;
+    }
+    try {
+        BRep_Builder builder;
+        TopoDS_Compound compound;
+        builder.MakeCompound(compound);
+        for (const auto& face : faces) {
+            BRepBuilderAPI_MakeWire wire;
+            for (std::size_t i = 0; i < face.size(); ++i) {
+                const gp_Pnt first = makePoint(vertices[face[i]]);
+                const gp_Pnt second = makePoint(vertices[face[(i + 1) % face.size()]]);
+                wire.Add(BRepBuilderAPI_MakeEdge(first, second).Edge());
+            }
+            if (!wire.IsDone()) {
+                UnsupportedFeature("POLYFACE nonplanar or invalid geometry");
+                return;
+            }
+            BRepBuilderAPI_MakeFace result(wire.Wire(), true);
+            if (!result.IsDone() || !BRepCheck_Analyzer(result.Face()).IsValid()) {
+                UnsupportedFeature("POLYFACE nonplanar or invalid geometry");
+                return;
+            }
+            builder.Add(compound, result.Face());
+        }
+        Collector->AddObject(compound, "Polyface");
+        return;
+    }
+    catch (const Standard_Failure&) {
+    }
+    UnsupportedFeature("POLYFACE nonplanar or invalid geometry");
+}
