+        || (!containerHandle.empty() && canonicalContainer.empty())) profileValid = false;
+    std::set<std::string> handles;
+    if (!canonicalParent.empty()) handles.insert(canonicalParent);
+    std::vector<Base::Vector3d> vertices;
+    std::vector<std::vector<std::size_t>> faces;
+    const double absent = std::numeric_limits<double>::quiet_NaN();
+    constexpr std::size_t recordLimit = 1000000;
+    std::size_t recordCount = 0;
+
+    while (get_next_record() && m_record_type == eObjectType && IsObjectName("VERTEX")) {
+        if (++recordCount > recordLimit) {
+            profileValid = false;
+        }
+        Base::Vector3d point(absent, absent, absent);
+        int vertexFlags = -1;
+        int indices[4] = {-1, -1, -1, -1};
+        std::string layer = "0";
+        std::string owner;
+        bool layerSeen = false;
+        bool ownerSeen = false;
+        bool handleSeen = false;
+        InitializeAttributes();
+        m_coordinate_attributes.emplace(10, std::pair(&Process3dFaceDouble, &point.x));
+        m_coordinate_attributes.emplace(20, std::pair(&Process3dFaceDouble, &point.y));
+        m_coordinate_attributes.emplace(30, std::pair(&Process3dFaceDouble, &point.z));
+        m_coordinate_attributes.emplace(70, std::pair(&ProcessPolyfaceInteger, &vertexFlags));
+        for (int i = 0; i < 4; ++i) {
+            m_coordinate_attributes.emplace(71 + i, std::pair(&ProcessPolyfaceInteger, &indices[i]));
+        }
+        while (get_next_record() && m_record_type != eObjectType) {
+            switch (static_cast<int>(m_record_type)) {
+                case 8:
+                    if (layerSeen) profileValid = false;
+                    layerSeen = true;
+                    layer = m_record_data;
+                    break;
+                case 330:
+                    if (ownerSeen) profileValid = false;
+                    ownerSeen = true;
+                    owner = m_record_data;
+                    break;
+                case 5: {
+                    const std::string handle = canonicalHandle(m_record_data);
+                    if (handleSeen || handle.empty() || !handles.insert(handle).second) {
+                        profileValid = false;
+                    }
+                    handleSeen = true;
+                    break;
+                }
+                case 100:
+                    if (m_record_data != "AcDbEntity" && m_record_data != "AcDbVertex"
+                        && m_record_data != "AcDbPolyFaceMeshVertex"
+                        && m_record_data != "AcDbFaceRecord") {
+                        profileValid = false;
+                    }
+                    break;
+                case 10: case 20: case 30: case 70:
+                case 71: case 72: case 73: case 74:
+                    break;
+                default:
+                    profileValid = false;
+                    break;
+            }
+            ProcessAttribute();
+        }
+        repeat_last_record();
+        const std::string canonicalOwner = canonicalHandle(owner);
+        if (layer != "0" || (ownerSeen && (canonicalOwner.empty()
+            || (canonicalOwner != canonicalParent && canonicalOwner != canonicalContainer)))) {
+            profileValid = false;
+        }
+        if (std::isnan(point.z)) point.z = 0.0;
+        if (vertexFlags == 192) {
+            if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z)) {
+                profileValid = false;
+            }
+            for (int index : indices) {
+                if (index != -1 && index != 0) profileValid = false;
+            }
+            if (profileValid) vertices.push_back(point);
+        }
+        else if (vertexFlags == 128) {
+            // Face-record coordinates are unused, but unexpected or invalid
+            // values are not admitted by this bounded profile.
+            if ((!std::isnan(point.x) && point.x != 0.0)
+                || (!std::isnan(point.y) && point.y != 0.0) || point.z != 0.0) {
+                profileValid = false;
+            }
+            std::vector<std::size_t> face;
+            bool ended = false;
+            for (int index : indices) {
+                if (index == -2) profileValid = false;
+                if (index <= 0) ended = true;
+                else if (ended) profileValid = false;
+                else face.push_back(static_cast<std::size_t>(index - 1));
+            }
+            if (face.size() < 3 || face.size() > 4) profileValid = false;
+            if (profileValid) faces.push_back(std::move(face));
+        }
+        else {
+            profileValid = false;
+        }
+    }
+    if (!IsObjectName("SEQEND")) {
+        repeat_last_record();
+        profileValid = false;
+    }
+    else {
+        bool seqendOwnerSeen = false;
+        bool seqendLayerSeen = false;
+        bool seqendHandleSeen = false;
+        while (get_next_record() && m_record_type != eObjectType) {
+            switch (static_cast<int>(m_record_type)) {
+                case 8:
+                    if (seqendLayerSeen || m_record_data != "0") profileValid = false;
+                    seqendLayerSeen = true;
+                    break;
+                case 330: {
+                    const std::string owner = canonicalHandle(m_record_data);
+                    if (seqendOwnerSeen || owner.empty()
+                        || (owner != canonicalParent && owner != canonicalContainer)) {
+                        profileValid = false;
+                    }
+                    seqendOwnerSeen = true;
+                    break;
+                }
+                case 100:
+                    if (m_record_data != "AcDbEntity") profileValid = false;
+                    break;
+                case 5: {
+                    const std::string handle = canonicalHandle(m_record_data);
+                    if (seqendHandleSeen || handle.empty() || !handles.insert(handle).second) {
+                        profileValid = false;
+                    }
+                    seqendHandleSeen = true;
+                    break;
+                }
+                default:
+                    profileValid = false;
+                    break;
+            }
+        }
+        repeat_last_record();
+    }
+    for (const auto& face : faces) {
+        for (std::size_t i = 0; i < face.size(); ++i) {
+            if (face[i] >= vertices.size()) profileValid = false;
+            for (std::size_t j = 0; j < i; ++j) {
+                if (face[i] == face[j]) profileValid = false;
+            }
+        }
+    }
+    if (!profileValid || vertices.empty() || faces.empty()) {
+        UnsupportedFeature("POLYFACE unsupported or invalid profile");
+        return true;
+    }
+    OnReadPolyface(vertices, faces);
+    return true;
+}
