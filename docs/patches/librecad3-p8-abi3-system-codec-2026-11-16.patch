@@ -3202,0 +3225,29 @@ TEST(DxfRoundTripTest, DrawingUnitsSurviveASave) {
+// The legacy bool API reports a lossy write as false even though it publishes
+// a file; exportFile is the API for distinguishing that case from failure.
+// NOLINTNEXTLINE(readability-identifier-naming)
+TEST(DxfRoundTripTest, LegacyLayerLossAndBoolSaveAreDistinguishable) {
+    auto doc = newDocument();
+    auto layer = std::make_shared<lc::meta::Layer>(
+        "A", lc::meta::MetaLineWidthByValue(0.25), lc::Color(255, 255, 255, 255));
+    std::make_shared<lc::operation::AddLayer>(doc, layer)->execute();
+    insertThroughBuilder(doc, {std::make_shared<lc::entity::Line>(
+        lc::geo::Coordinate(0, 0, 0), lc::geo::Coordinate(4, 3, 0), layer)});
+    const auto detailedPath = uniqueTmpDxf("layer-loss-detail");
+    const auto boolPath = uniqueTmpDxf("layer-loss-bool");
+    const auto result = lc::persistence::File::exportFile(
+        doc, detailedPath, lc::persistence::File::LIBDXFRW_DXF_R12);
+    ASSERT_TRUE(result.ok);
+    ASSERT_EQ(result.loss.notes.size(), 1u);
+    EXPECT_NE(result.loss.notes.front().find("Layer lineweights"), std::string::npos);
+    EXPECT_TRUE(result.loss.droppedByType.empty());
+    EXPECT_FALSE(lc::persistence::File::save(
+        doc, boolPath, lc::persistence::File::LIBDXFRW_DXF_R12));
+    ASSERT_TRUE(boost::filesystem::exists(boolPath));
+    auto reopened = newDocument();
+    ASSERT_TRUE(lc::persistence::File::importFile(
+        reopened, boolPath, lc::persistence::File::Library::LIBDXFRW).ok);
+    EXPECT_EQ(entitiesInDocument(reopened)["Line"], 1u);
+    boost::filesystem::remove(detailedPath);
+    boost::filesystem::remove(boolPath);
+}
