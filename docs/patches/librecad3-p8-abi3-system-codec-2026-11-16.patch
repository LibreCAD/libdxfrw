diff --git a/lckernel/CMakeLists.txt b/lckernel/CMakeLists.txt
index 5261566..ac5519b 100644
--- a/lckernel/CMakeLists.txt
+++ b/lckernel/CMakeLists.txt
@@ -280,0 +281,10 @@ endif()
+# Installed packages do not export a target VERSION property or a source Git
+# revision. Preserve the package version and do not label it as the submodule.
+if(WITH_PERSISTENCE AND LIBRECAD_USE_SYSTEM_LIBDXFRW)
+    set(_lc_dxfrw_build_version "${libdxfrw_VERSION}")
+    set(_lc_dxfrw_build_provider "system")
+else()
+    set(_lc_dxfrw_build_version "$<IF:$<TARGET_EXISTS:dxfrw>,$<TARGET_PROPERTY:dxfrw,VERSION>,>")
+    set(_lc_dxfrw_build_provider "bundled")
+endif()
+
@@ -289 +299,2 @@ add_custom_command(
-                "-DLIBDXFRW_BUILD_VERSION=$<IF:$<TARGET_EXISTS:dxfrw>,$<TARGET_PROPERTY:dxfrw,VERSION>,>"
+                "-DLIBDXFRW_BUILD_VERSION=${_lc_dxfrw_build_version}"
+                "-DLIBDXFRW_BUILD_PROVIDER=${_lc_dxfrw_build_provider}"
diff --git a/lckernel/cmake/SetBuildInfo.cmake b/lckernel/cmake/SetBuildInfo.cmake
index 2841709..2212e89 100644
--- a/lckernel/cmake/SetBuildInfo.cmake
+++ b/lckernel/cmake/SetBuildInfo.cmake
@@ -29,7 +29,23 @@ endif()
-execute_process(
-        COMMAND git rev-parse --short HEAD
-        OUTPUT_VARIABLE LIBDXFRW_GIT_COMMIT
-        OUTPUT_STRIP_TRAILING_WHITESPACE
-        ERROR_QUIET
-        WORKING_DIRECTORY ${DIR}/../third_party/libdxfrw
-)
+if(NOT LIBDXFRW_BUILD_PROVIDER STREQUAL "system")
+    set(_dxfrw_source "${DIR}/../third_party/libdxfrw")
+    if(IS_DIRECTORY "${_dxfrw_source}")
+        execute_process(
+                COMMAND git rev-parse --show-toplevel
+                OUTPUT_VARIABLE _dxfrw_git_root
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+                ERROR_QUIET
+                WORKING_DIRECTORY "${_dxfrw_source}")
+        if(_dxfrw_git_root)
+            file(REAL_PATH "${_dxfrw_source}" _dxfrw_source_real)
+            file(REAL_PATH "${_dxfrw_git_root}" _dxfrw_git_root_real)
+            if(_dxfrw_source_real STREQUAL _dxfrw_git_root_real)
+                execute_process(
+                        COMMAND git rev-parse --short HEAD
+                        OUTPUT_VARIABLE LIBDXFRW_GIT_COMMIT
+                        OUTPUT_STRIP_TRAILING_WHITESPACE
+                        ERROR_QUIET
+                        WORKING_DIRECTORY "${_dxfrw_source}")
+            endif()
+        endif()
+    endif()
+endif()
