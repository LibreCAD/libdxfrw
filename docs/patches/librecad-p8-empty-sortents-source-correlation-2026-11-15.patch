+#ifdef LIBDXFRW_HAS_AC1024_EMPTY_SORTENTS_SOURCE_VERIFY
+TEST_CASE("Empty AC1024 sort tables match live adapter source observations",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_AC1024_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_AC1024_SORTENTS_FIXTURE to a locally available AC1024 title_block-iso.dwg");
+  REQUIRE(std::filesystem::exists(fixture));
+  ensureSettings();
+  RS_Graphic graphic;
+  RS_FilterDXFRW reader;
+  const auto import = [&] { return reader.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG); };
+  REQUIRE(import());
+  auto &metadata = graphic.dwgAdvancedMetadata();
+  REQUIRE(metadata.sourceDwgVersion() == DRW::AC1024);
+  REQUIRE(metadata.dwgFramePublicationCoverageComplete());
+  REQUIRE_FALSE(metadata.sortEntsSourceCaptureFailed());
+  for (auto handle : {0xF3u, 0x2121u, 0x21D3u, 0x22D4u}) {
+    INFO(handle);
+    REQUIRE(metadata.emptySortEntsSourceObservations().count(handle) == 1u);
+    CHECK(metadata.matchesAc1024EmptySortEntsSourceObservation(handle));
+  }
+  constexpr std::uint32_t target = 0x2121u;
+  metadata.setSourceDwgVersion(DRW::AC1027);
+  CHECK_FALSE(metadata.matchesAc1024EmptySortEntsSourceObservation(target));
+  metadata.setSourceDwgVersion(DRW::AC1024);
+  CHECK(metadata.matchesAc1024EmptySortEntsSourceObservation(target));
+  const auto goodReport = metadata.dwgFrameCoverageReport();
+  auto badReport = goodReport;
+  for (auto &entry : badReport.m_entries)
+    if (entry.m_handle == target) ++entry.m_sourceOffset;
+  metadata.addDwgFrameCoverageReport(badReport);
+  CHECK_FALSE(metadata.matchesAc1024EmptySortEntsSourceObservation(target));
+  metadata.addDwgFrameCoverageReport(goodReport);
+  CHECK(metadata.matchesAc1024EmptySortEntsSourceObservation(target));
+  const auto &memberships = metadata.dwgSortEntsMemberships();
+  const auto found = std::find_if(memberships.begin(), memberships.end(),
+      [](const auto &entry) { return entry.m_tableHandle == target; });
+  REQUIRE(found != memberships.end());
+  const auto duplicate = *found;
+  metadata.addDwgSortEntsMembership(duplicate);
+  CHECK_FALSE(metadata.matchesAc1024EmptySortEntsSourceObservation(target));
+  const auto duplicateTable = metadata.emptySortEntsSourceObservations().at(target);
+  metadata.observeEmptySortEntsSource(duplicateTable);
+  CHECK(metadata.sortEntsSourceCaptureFailed());
+  CHECK(metadata.emptySortEntsSourceObservations().empty());
+  metadata.clear();
+  CHECK_FALSE(metadata.sortEntsSourceCaptureFailed());
+  REQUIRE(import());
+  CHECK(graphic.dwgAdvancedMetadata().matchesAc1024EmptySortEntsSourceObservation(target));
+}
+#endif
