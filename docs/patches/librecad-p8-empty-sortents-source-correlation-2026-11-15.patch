+  // A typed source observation only; it never authorizes output.
+  void observeEmptySortEntsSource(const DRW_SortEntsTable &table) noexcept {
+    constexpr std::size_t maxRecords = 100000u;
+    constexpr std::size_t maxBytes = 32u * 1024u * 1024u;
+    if (m_sortEntsSourceCaptureFailed)
+      return;
+    if (table.tType != DRW::SORTENTSTABLE || !table.hasCompleteDwgEntries()
+        || !table.m_sortHandles.empty() || !table.m_entityHandles.empty()
+        || !table.appData.empty() || !table.extData.empty()
+        || !table.pendingAppIdResolutions.empty() || !table.pendingLayerRefResolutions.empty()
+        || table.reactorCount() != 1 || table.reactorHandles.size() != 1u
+        || table.parentHandle == 0u || table.parentHandle == DRW::NoHandle
+        || table.reactorHandles[0] != table.parentHandle
+        || table.extensionDictionaryFlag() != 1u || table.xDictHandle != 0u
+        || table.hasDataStorageBinaryData()
+        || table.m_blockOwnerHandle == 0u || table.m_blockOwnerHandle == DRW::NoHandle)
+      return;
+    const auto reject = [this]() noexcept {
+      m_sortEntsSources.clear();
+      m_sortEntsSourceBytes = 0u;
+      m_sortEntsSourceCaptureFailed = true;
+    };
+    if (table.handle == 0u || table.handle == DRW::NoHandle
+        || m_sortEntsSources.size() >= maxRecords
+        || table.name.size() > maxBytes - sizeof(DRW_SortEntsTable) - sizeof(std::uint32_t)) {
+      reject();
+      return;
+    }
+    const std::size_t estimate = sizeof(DRW_SortEntsTable)
+        + sizeof(std::uint32_t) + table.name.size();
+    if (m_sortEntsSourceBytes > maxBytes - estimate) {
+      reject();
+      return;
+    }
+    try {
+      if (!m_sortEntsSources.emplace(table.handle, table).second) {
+        reject();
+        return;
+      }
+      m_sortEntsSourceBytes += estimate;
+    } catch (...) {
+      reject();
+    }
+  }
+  const std::map<std::uint32_t, DRW_SortEntsTable> &
+  emptySortEntsSourceObservations() const noexcept { return m_sortEntsSources; }
+  bool sortEntsSourceCaptureFailed() const noexcept {
+    return m_sortEntsSourceCaptureFailed;
+  }
+  bool matchesAc1024EmptySortEntsSourceObservation(std::uint32_t handle) const noexcept;
+#endif
