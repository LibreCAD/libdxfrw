From ba3c1621e6b87685c6f0b729e3b23c64fa2918a5 Mon Sep 17 00:00:00 2001
From: dxli <dongxuli2011@gmail.com>
Date: Sun, 15 Nov 2026 06:19:25 -0500
Subject: [PATCH] Select polyline-only MPOLYGON output when available

---
 librecad/src/lib/filters/rs_filterdxfrw.cpp              | 3 +++
 librecad/src/lib/filters/tests/lc_mpolygon_dxf_tests.cpp | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/librecad/src/lib/filters/rs_filterdxfrw.cpp b/librecad/src/lib/filters/rs_filterdxfrw.cpp
index b60bfe2..9ebe25e 100644
--- a/librecad/src/lib/filters/rs_filterdxfrw.cpp
+++ b/librecad/src/lib/filters/rs_filterdxfrw.cpp
@@ -12216,6 +12216,9 @@ bool RS_FilterDXFRW::fileExport(RS_Graphic &g, const QString &file,
    */
   ExportWriterScope<dxfRW> activeWriter(
       m_dxfW, std::make_unique<dxfRW>(QFile::encodeName(file).constData()));
+#if defined(LIBDXFRW_HAS_MPOLYGON_POLYLINE_POLICY)
+  m_dxfW->setMPolygonPolylinePathsOnly(true);
+#endif
   prepareShapesForExport();
   if (m_writeFailed)
     return false;
diff --git a/librecad/src/lib/filters/tests/lc_mpolygon_dxf_tests.cpp b/librecad/src/lib/filters/tests/lc_mpolygon_dxf_tests.cpp
index bdaa56a..ebaea2d 100644
--- a/librecad/src/lib/filters/tests/lc_mpolygon_dxf_tests.cpp
+++ b/librecad/src/lib/filters/tests/lc_mpolygon_dxf_tests.cpp
@@ -457,6 +457,9 @@ TEST_CASE("DXF MPOLYGON writer rejects unsupported geometry and versions",
                                       "negative version", "large version");
     const auto path = std::filesystem::temp_directory_path() / "lc_mpoly_payload.dxf";
     dxfRW writer(path.string().c_str());
+#if defined(LIBDXFRW_HAS_MPOLYGON_POLYLINE_POLICY)
+    writer.setMPolygonPolylinePathsOnly(true);
+#endif
     class Emit : public CaptureIface {
     public:
         void writeEntities() override {
-- 
