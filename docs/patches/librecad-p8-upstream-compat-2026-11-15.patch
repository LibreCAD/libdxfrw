@@ -4288,7 +4288,7 @@ bool RS_FilterDXFRW::fileImport(RS_Graphic &g, const QString &file,
     }
   } stackGuard{&m_xrefStack, thisFileAbs, stackInsertedSelf};
   // add some variables that need to be there for DXF drawings:
