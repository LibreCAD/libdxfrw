 librecad/src/lib/filters/rs_filterdxfrw.cpp   | 34 +++++++-
 .../lib/filters/tests/dxf_roundtrip_tests.cpp | 81 ++++++++++++++++---
 2 files changed, 105 insertions(+), 10 deletions(-)

diff --git a/librecad/src/lib/filters/rs_filterdxfrw.cpp b/librecad/src/lib/filters/rs_filterdxfrw.cpp
index fefcf30..b60bfe2 100644
