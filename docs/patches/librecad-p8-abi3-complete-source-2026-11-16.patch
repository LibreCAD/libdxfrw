+#if defined(LIBDXFRW_HAS_AC1024_LAYER_CONTROL_SOURCE) && defined(LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY)
+bool LC_DwgAdvancedMetadata::matchesAc1024LayerControlExtensionSource(
+    std::uint32_t controlHandle, std::uint32_t dictionaryHandle) const noexcept {
+  // Source correlation only. Full inbound edges and output remain unresolved.
+  if (!m_selectedSourceCaptureSealed || m_layerControlSourceCaptureFailed
+      || !m_layerControlSource || controlHandle == 0u || dictionaryHandle == 0u
+      || controlHandle == DRW::NoHandle || dictionaryHandle == DRW::NoHandle
+      || controlHandle == dictionaryHandle
+      || m_layerControlSource->m_raw.m_handle != controlHandle
+      || m_layerControlSource->m_raw.m_xDictHandle != dictionaryHandle
+      || !matchesAc1024DictionarySourceObservation(dictionaryHandle))
+    return false;
+  const DRW_DwgFramePublication *publication = nullptr;
+  const DRW_DwgFrameCoverageEntry *coverage = nullptr;
+  const DictionaryRecord *dictionary = nullptr;
+  for (const auto &item : m_dwgFramePublications)
+    if (item.m_handle == controlHandle) { if (publication) return false; publication = &item; }
+  for (const auto &item : m_dwgFrameCoverageReport.m_entries)
+    if (item.m_handle == controlHandle) { if (coverage) return false; coverage = &item; }
+  for (const auto &item : m_dictionaries)
+    if (item.handle == dictionaryHandle) { if (dictionary) return false; dictionary = &item; }
+  return publication && coverage && dictionary
+      && dictionary->parentHandle == controlHandle
+      && coverage->m_sourceOffset == publication->m_sourceOffset
+      && coverage->m_sourceMapOrdinal == publication->m_sourceMapOrdinal
+      && coverage->m_sourceOffsetSpace == publication->m_sourceOffsetSpace
+      && coverage->m_disposition == DRW_DwgFrameDisposition::Published
+      && coverage->m_publicationCount == 1u
+      && m_layerControlSource->matchesAc1024LayerControlFrame(*publication);
+}
+#endif
