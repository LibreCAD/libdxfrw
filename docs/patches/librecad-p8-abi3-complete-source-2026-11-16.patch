+namespace {
+DRW_UnsupportedObject sourceObject(const LC_DwgAdvancedMetadata::RawObjectRecord &raw) {
+    DRW_UnsupportedObject source;
+    source.m_version = raw.version;
+    source.m_objectType = raw.objectType;
+    source.m_handle = raw.handle;
+    source.m_parentHandle = raw.parentHandle;
+    source.setCommonLinkEvidence(raw.commonLinkEvidence);
+    source.m_reactorHandles = raw.reactorHandles;
+    source.m_xDictHandle = raw.xDictHandle;
+    source.m_numReactors = raw.numReactors;
+    source.m_xDictFlag = raw.xDictFlag;
+    source.m_blockOwnerHandle = raw.blockOwnerHandle;
+    source.m_bodyBitSize = raw.bodyBitSize;
+    source.m_objectOffset = raw.objectOffset;
+    source.m_objectSize = raw.objectSize;
+    source.m_isEntity = raw.isEntity;
+    source.m_isCustomClass = raw.isCustomClass;
+    source.m_hasDataStorage = raw.hasDataStorage;
+    source.m_hasClassDefinition = raw.hasClassDefinition;
+    source.m_classProxyFlag = raw.classProxyFlag;
+    source.m_classAppName = raw.classAppName;
+    source.m_classWasProxy = raw.classWasProxy;
+    source.m_classEntityFlagRaw = raw.classEntityFlagRaw;
+    source.m_classDwgVersion = raw.classDwgVersion;
+    source.m_classMaintenanceVersion = raw.classMaintenanceVersion;
+    source.m_classUnknown1 = raw.classUnknown1;
+    source.m_classUnknown2 = raw.classUnknown2;
+    source.m_recordName = raw.recordName;
+    source.m_className = raw.className;
+    source.m_rawBytes = raw.rawBytes;
+    source.m_typedPayloadValidated = raw.typedPayloadValidated;
+    return source;
+}
+}
+#endif
