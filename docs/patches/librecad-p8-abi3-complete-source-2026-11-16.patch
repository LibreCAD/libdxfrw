+#ifdef LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY
+bool LC_DwgAdvancedMetadata::matchesAc1024DictionarySourceObservation(
+    std::uint32_t handle) const noexcept {
+  // This correlates observations; it does not establish import generation,
+  // graph closure, authentic producer data, CRCs or permission to export.
+  if (m_sourceDwgVersion != DRW::AC1024 || !m_dwgFramePublicationCoverageComplete
+      || !m_dwgFramePublicationConflicts.empty() || m_dictionarySourceCaptureFailed)
+    return false;
+  const auto snapshotIt = m_dictionarySources.find(handle);
+  if (snapshotIt == m_dictionarySources.end())
+    return false;
+  const auto &snapshot = snapshotIt->second;
+  const DictionaryRecord *current = nullptr;
+  const RawObjectRecord *raw = nullptr;
+  const DRW_DwgFramePublication *publication = nullptr;
+  const DRW_DwgDictionaryMembership *membership = nullptr;
+  const DRW_DwgFrameCoverageEntry *coverage = nullptr;
+  for (const auto &item : m_dictionaries)
+    if (item.handle == handle) { if (current) return false; current = &item; }
+  for (const auto &item : m_rawObjects)
+    if (item.handle == handle) { if (raw) return false; raw = &item; }
+  for (const auto &item : m_dwgFramePublications)
+    if (item.m_handle == handle) { if (publication) return false; publication = &item; }
+  for (const auto &item : m_dwgDictionaryMemberships)
+    if (item.m_dictionaryHandle == handle) { if (membership) return false; membership = &item; }
+  for (const auto &item : m_dwgFrameCoverageReport.m_entries)
+    if (item.m_handle == handle) { if (coverage) return false; coverage = &item; }
+  if (!current || !raw || !publication || !membership || !coverage
+      || coverage->m_sourceOffset != publication->m_sourceOffset
+      || coverage->m_sourceMapOrdinal != publication->m_sourceMapOrdinal
+      || coverage->m_sourceOffsetSpace != publication->m_sourceOffsetSpace
+      || coverage->m_disposition != DRW_DwgFrameDisposition::Published
+      || coverage->m_publicationCount != 1u
+      || raw->rawBytes.empty() || raw->rawBytes.size() > 4u * 1024u * 1024u
+      || current->replayState != ReplayState::ReplayAllowed
+      || raw->replayState != ReplayState::ReplayAllowed
+      || !raw->commonHandleDataValidated
+      || current->handle != snapshot.handle
+      || current->parentHandle != snapshot.parentHandle
+      || current->cloning != snapshot.cloning || current->hardOwner != snapshot.hardOwner
+      || current->name != snapshot.name || current->countCap
+      || !current->appData.empty() || !current->extData.empty()
+      || current->reactorHandles != snapshot.reactorHandles
+      || current->xDictHandle != snapshot.xDictHandle
+      || current->numReactors != snapshot.reactorCount()
+      || current->xDictFlag != snapshot.extensionDictionaryFlag()
+      || current->hasDsData != snapshot.hasDataStorageBinaryData()
+      || current->typedPayloadComplete != snapshot.hasCompleteDwgEntries()
+      || current->entries.size() != snapshot.m_entries.size())
+    return false;
+  for (std::size_t i = 0; i < current->entries.size(); ++i)
+    if (current->entries[i].name != snapshot.m_entries[i].m_name
+        || current->entries[i].handle != snapshot.m_entries[i].m_handle)
+      return false;
+  try {
+    const auto source = sourceObject(*raw);
+    return snapshot.matchesAc1024DwgFrame(source, *publication, *membership);
+  } catch (...) {
+    return false;
+  }
+}
+#endif
