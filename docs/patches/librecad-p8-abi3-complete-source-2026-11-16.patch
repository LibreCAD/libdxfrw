+#if defined(LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY) && defined(LIBDXFRW_HAS_AC1024_EMPTY_SORTENTS_SOURCE_VERIFY)
+bool LC_DwgAdvancedMetadata::matchesSelectedAc1024SortEntsOwnerChain(
+    std::uint32_t blockHandle, std::uint32_t dictionaryHandle,
+    std::uint32_t sortHandle) const noexcept {
+  // A selected source-chain observation only. Unknown inbound edges, block
+  // content and every output decision remain outside this check.
+  if (!m_selectedSourceCaptureSealed || m_blockRecordLinkCaptureFailed
+      || blockHandle == 0u || blockHandle == DRW::NoHandle
+      || dictionaryHandle == 0u || dictionaryHandle == DRW::NoHandle
+      || sortHandle == 0u || sortHandle == DRW::NoHandle
+      || blockHandle == dictionaryHandle || blockHandle == sortHandle
+      || dictionaryHandle == sortHandle
+      || !matchesAc1024DictionarySourceObservation(dictionaryHandle)
+      || !matchesAc1024EmptySortEntsSourceObservation(sortHandle))
+    return false;
+  const auto found = m_blockRecordLinks.find(blockHandle);
+  if (found == m_blockRecordLinks.end())
+    return false;
+  const auto &block = found->second;
+  const DRW_DwgFramePublication *publication = nullptr;
+  const DRW_DwgFrameCoverageEntry *coverage = nullptr;
+  const DictionaryRecord *dictionary = nullptr;
+  const SortEntsTableRecord *sort = nullptr;
+  for (const auto &item : m_dwgFramePublications)
+    if (item.m_handle == blockHandle) { if (publication) return false; publication = &item; }
+  for (const auto &item : m_dwgFrameCoverageReport.m_entries)
+    if (item.m_handle == blockHandle) { if (coverage) return false; coverage = &item; }
+  for (const auto &item : m_dictionaries)
+    if (item.handle == dictionaryHandle) { if (dictionary) return false; dictionary = &item; }
+  for (const auto &item : m_sortEntsTables)
+    if (item.handle == sortHandle) { if (sort) return false; sort = &item; }
+  if (!publication || !coverage || !dictionary || !sort
+      || block.handle != blockHandle || block.extensionDictionaryHandle != dictionaryHandle
+      || block.extensionDictionaryFlag != 0u
+      || publication->m_version != DRW::AC1024 || !publication->m_hasSourceLocation
+      || (publication->m_sourceOffsetSpace != DRW_DwgFrameOffsetSpace::PhysicalFile
+          && publication->m_sourceOffsetSpace != DRW_DwgFrameOffsetSpace::DecodedBuffer)
+      || publication->m_encodedType != 49 || publication->m_resolvedType != 49
+      || publication->m_isEntity || publication->m_isCustomClass
+      || publication->m_carrier != DRW_DwgFramePublication::Carrier::Typed
+      || !publication->m_commonHandleDataValidated
+      || !drwDwgCommonLinkEvidenceValidated(publication->m_commonLinkEvidence)
+      || publication->m_parentHandle != block.parentHandle
+      || publication->m_xDictHandle != block.extensionDictionaryHandle
+      || publication->m_xDictFlag != block.extensionDictionaryFlag
+      || publication->m_reactorHandles != block.reactorHandles
+      || publication->m_numReactors != block.reactorCount
+      || coverage->m_sourceOffset != publication->m_sourceOffset
+      || coverage->m_sourceMapOrdinal != publication->m_sourceMapOrdinal
+      || coverage->m_sourceOffsetSpace != publication->m_sourceOffsetSpace
+      || coverage->m_disposition != DRW_DwgFrameDisposition::Published
+      || coverage->m_publicationCount != 1u
+      || dictionary->parentHandle != blockHandle
+      || sort->parentHandle != dictionaryHandle
+      || sort->blockOwnerHandle != blockHandle)
+    return false;
+  std::size_t matchingEntries = 0u;
+  for (const auto &entry : dictionary->entries) {
+    if (entry.name == "ACAD_SORTENTS") {
+      if (entry.handle != sortHandle) return false;
+      ++matchingEntries;
+    }
+  }
+  return matchingEntries == 1u;
+}
+#endif
