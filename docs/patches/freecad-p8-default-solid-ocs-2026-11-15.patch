+    def test_dimension_ocs_orientation_axes(self):
+        """The shared arbitrary-axis basis must be orthonormal for signed normals."""
+        cases = [
+            ((0, 0, 1), [(1, 0, 0), (0, 1, 0), (0, 0, 1)]),
+            ((-1, 0, 0), [(0, -1, 0), (0, 0, 1), (-1, 0, 0)]),
+            ((0.6, 0, 0.8), [(0, 1, 0), (-0.8, 0, 0.6), (0.6, 0, 0.8)]),
+        ]
+        options = FreeCAD.ParamGet(self.option_source)
+        options.SetBool("dxftext", True)
+        for index, (normal, axes) in enumerate(cases):
+            with self.subTest(normal=normal):
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                        (0, "SECTION"), (2, "ENTITIES"), (0, "DIMENSION"), (8, "0"),
+                        (70, 0), (10, 1), (20, 2), (30, 0), (11, 1), (21, 2), (31, 0),
+                        (13, 0), (23, 0), (33, 0), (14, 3), (24, 0), (34, 0), (50, 0)]
+                tags.extend(zip((210, 220, 230), normal))
+                tags.extend([(0, "ENDSEC"), (0, "EOF")])
+                path = os.path.join(self.temp_dir, f"dimension-ocs-{index}.dxf")
+                with open(path, "w", encoding="ascii", newline="\n") as stream:
+                    stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                previous = set(self.document.Objects)
+                stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                dimensions = [obj for obj in self.document.Objects if obj not in previous
+                              and obj.Name.startswith("Dimension")]
+                self.assertEqual(stats["entityCounts"].get("DIMENSION"), 1)
+                self.assertEqual(len(dimensions), 1)
+                rotation = dimensions[0].Placement.Rotation
+                for original, expected in zip(((1, 0, 0), (0, 1, 0), (0, 0, 1)), axes):
+                    actual = rotation.multVec(FreeCAD.Vector(*original))
+                    for value, target in zip((actual.x, actual.y, actual.z), expected):
+                        self.assertAlmostEqual(value, target, places=8)
+
+    def test_read_solid_ocs_vertices(self):
+        """SOLID corners use an orthonormal arbitrary-axis OCS basis."""
+        corners = [(1, 2, 3), (4, 2, 3), (1, 6, 3), (4, 6, 3)]
+        cases = [
+            ((0, 0, 1), corners),
+            ((-1, 0, 0), [(-3, -1, 2), (-3, -4, 2), (-3, -1, 6), (-3, -4, 6)]),
+            ((0.6, 0, 0.8), [(0.2, 1, 3.6), (0.2, 4, 3.6), (-3, 1, 6), (-3, 4, 6)]),
+            ((3, 0, 4), [(0.2, 1, 3.6), (0.2, 4, 3.6), (-3, 1, 6), (-3, 4, 6)]),
+        ]
+        for index, (normal, expected) in enumerate(cases):
+            with self.subTest(normal=normal):
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                        (0, "SECTION"), (2, "ENTITIES"), (0, "SOLID"), (8, "0")]
+                for i, point in enumerate(corners):
+                    tags.extend((code + i, value) for code, value in zip((10, 20, 30), point))
+                tags.extend(zip((210, 220, 230), normal))
+                tags.extend([(0, "ENDSEC"), (0, "EOF")])
+                path = os.path.join(self.temp_dir, f"solid-ocs-{index}.dxf")
+                with open(path, "w", encoding="ascii", newline="\n") as stream:
+                    stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                previous = set(self.document.Objects)
+                stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                shapes = [obj.Shape for obj in self.document.Objects
+                          if obj not in previous and obj.isDerivedFrom("Part::Feature")]
+                self.assertEqual(stats["entityCounts"].get("SOLID"), 1)
+                self.assertEqual(len(shapes), 1)
+                self.assertTrue(shapes[0].isValid())
+                self.assertAlmostEqual(shapes[0].Area, 12.0)
+                actual = sorted((v.Point.x, v.Point.y, v.Point.z) for v in shapes[0].Vertexes)
+                self.assertEqual(len(actual), 4)
+                for a, e in zip(actual, sorted(expected)):
+                    for coordinate, target in zip(a, e):
+                        self.assertAlmostEqual(coordinate, target, places=8)
