 """DXF import tests."""
 
+import os
+
 import FreeCAD
 import Import
 from importtests.TestImportBase import TestImportBase
@@ -74,3 +76,71 @@ class TestImportDXF(TestImportBase):
         self.assertAlmostEqual(bound_box.XMax, 10.0)
