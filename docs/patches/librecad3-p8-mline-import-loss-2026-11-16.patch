diff --git a/unittest/persistence/dwgimporttest.cpp b/unittest/persistence/dwgimporttest.cpp
index 0ff746c..34ceafa 100644
--- a/unittest/persistence/dwgimporttest.cpp
+++ b/unittest/persistence/dwgimporttest.cpp
@@ -16,0 +17 @@
+#include <cstdlib>
@@ -957,0 +959,31 @@ TEST(DwgImportTest, MpolygonRotationPreservesBulges) {
+
+// Both inputs are generated from a local LINE + MLINE source; no fixture is
+// required in the repository. The DWG is converted by ODA File Converter.
+TEST(DwgImportTest, MLineLossIsReportedForDxfAndDwg) {
+    const char* dxf = std::getenv("LC3_MLINE_DXF");
+    const char* dwg = std::getenv("LC3_MLINE_DWG");
+    if (!dxf || !*dxf || !dwg || !*dwg) GTEST_SKIP() << "Set LC3_MLINE_DXF and LC3_MLINE_DWG to generated controls";
+    const char* lineOnly = std::getenv("LC3_LINE_DXF");
+    if (lineOnly && *lineOnly) {
+        auto control = newDwgDocument();
+        const auto result = lc::persistence::File::importFile(
+            control, lineOnly, lc::persistence::File::Library::LIBDXFRW);
+        ASSERT_TRUE(result.ok);
+        EXPECT_EQ(result.loss.droppedByType.count("MLINE"), 0u);
+        EXPECT_EQ(control->entityContainer().asVector().size(), 1u);
+    }
+    for (const char* path : {dxf, dwg}) {
+        SCOPED_TRACE(path);
+        auto doc = newDwgDocument();
+        const auto result = lc::persistence::File::importFile(
+            doc, path, lc::persistence::File::Library::LIBDXFRW);
+        ASSERT_TRUE(result.ok);
+        const auto dropped = result.loss.droppedByType.find("MLINE");
+        ASSERT_NE(dropped, result.loss.droppedByType.end());
+        EXPECT_EQ(dropped->second, 1u);
+        std::size_t lines = 0;
+        for (const auto& entity : doc->entityContainer().asVector())
+            if (std::dynamic_pointer_cast<const lc::entity::Line>(entity)) ++lines;
+        EXPECT_EQ(lines, 1u);
+    }
+}
