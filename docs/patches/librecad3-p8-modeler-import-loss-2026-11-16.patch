diff --git a/persistence/libdxfrw/dxfimpl.h b/persistence/libdxfrw/dxfimpl.h
index a054c91..9e09cac 100644
--- a/persistence/libdxfrw/dxfimpl.h
+++ b/persistence/libdxfrw/dxfimpl.h
@@ -148,0 +149,9 @@ public:
+    void addModelerGeometry(const DRW_ModelerGeometry& data) override {
+        switch (data.eType) {
+        case DRW::E3DSOLID: recordLoss("3DSOLID"); break;
+        case DRW::REGION: recordLoss("REGION"); break;
+        case DRW::BODY: recordLoss("BODY"); break;
+        default: recordLoss("MODELERGEOMETRY"); break;
+        }
+    }
+
diff --git a/unittest/persistence/dwgimporttest.cpp b/unittest/persistence/dwgimporttest.cpp
index 2819fa8..4cbfa6c 100644
--- a/unittest/persistence/dwgimporttest.cpp
+++ b/unittest/persistence/dwgimporttest.cpp
@@ -1047,0 +1048,34 @@ TEST(DwgImportTest, MLeaderLossIsReportedForDxfAndDwg) {
+
+// Synthetic shell payloads exercise callback routing only; they are not ACIS
+// geometry and do not qualify 3D modeler semantics.
+TEST(DwgImportTest, ModelerGeometryLossIsReportedForDxf) {
+    const std::string path = (boost::filesystem::temp_directory_path() /
+        boost::filesystem::unique_path("lc3-modeler-%%%%%%%%.dxf")).string();
+    {
+        std::ofstream file(path, std::ios::binary);
+        ASSERT_TRUE(file.good());
+        file << "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1024\n0\nENDSEC\n"
+                "0\nSECTION\n2\nENTITIES\n0\nLINE\n8\n0\n"
+                "10\n0\n20\n0\n30\n0\n11\n5\n21\n0\n31\n0\n";
+        for (const char* kind : {"3DSOLID", "REGION", "BODY"}) {
+            file << "0\n" << kind << "\n8\n0\n100\nAcDbEntity\n"
+                    "100\nAcDbModelerGeometry\n70\n1\n1\nsynthetic opaque payload\n";
+        }
+        file << "0\nENDSEC\n0\nEOF\n";
+        ASSERT_TRUE(file.good());
+    }
+    auto doc = newDwgDocument();
+    const auto result = lc::persistence::File::importFile(
+        doc, path, lc::persistence::File::Library::LIBDXFRW);
+    boost::filesystem::remove(path);
+    ASSERT_TRUE(result.ok);
+    for (const char* kind : {"3DSOLID", "REGION", "BODY"}) {
+        const auto dropped = result.loss.droppedByType.find(kind);
+        ASSERT_NE(dropped, result.loss.droppedByType.end()) << kind;
+        EXPECT_EQ(dropped->second, 1u);
+    }
+    std::size_t lines = 0;
+    for (const auto& entity : doc->entityContainer().asVector())
+        if (std::dynamic_pointer_cast<const lc::entity::Line>(entity)) ++lines;
+    EXPECT_EQ(lines, 1u);
+}
