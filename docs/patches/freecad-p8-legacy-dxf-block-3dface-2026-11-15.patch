+    def test_legacy_block_keeps_3dface(self):
+        """3DFACE geometry inside a block must reach the compound."""
+        points = [(0, 0, 0), (2, 0, 2), (2, 2, 4), (0, 2, 2)]
+        face = SimpleNamespace(points=[App.Vector(*p) for p in points])
+
+        class Entities:
+            data = [face]
+
+            def get_type(self, name):
+                return [face] if name == "3dface" else []
+
+        block = SimpleNamespace(name="surface", entities=Entities())
+        with mock.patch.object(importDXF, "resolvedScale", 25.4, create=True), \
+             mock.patch.object(importDXF, "dxfStarBlocks", True, create=True), \
+             mock.patch.object(importDXF, "blockshapes", {}, create=True):
+            shape = importDXF.drawBlock(block)
+        self.assertIsNotNone(shape)
+        self.assertEqual(len(shape.Faces), 1)
+        self.assertTrue(shape.isValid())
+        self.assertLegacyPoints((v.Point for v in shape.Vertexes), points, 25.4, 1e-8)
+
