+
+TEST_CASE("Legacy DXF export reports unrepresentable layer lineweight",
+          "[dxf][roundtrip][filter][linetype][ltype][named]") {
+  if (!HasCanonicalLTypeMetadataForGolden<dxfRW>::value)
+    return; // The bundled writer permits this lossy export.
+  ensureSettings();
+  for (const RS2::FormatType format :
+       {RS2::FormatDXFRW12, RS2::FormatDXFRW14}) {
+    RS_Graphic graphic;
+    graphic.initForNewDocument();
+    RS_Layer *layer = graphic.findLayer("0");
+    REQUIRE(layer != nullptr);
+    RS_Pen pen = layer->getPen();
+    pen.setWidth(RS2::Width07);
+    layer->setPen(pen);
+    const std::string out = tmpFile("legacy_dxf_lineweight_report.dxf");
+    writeText(out, "previous destination\n");
+    RS_FileIO *io = RS_FileIO::instance();
+    REQUIRE_FALSE(io->fileExport(graphic, QString::fromStdString(out), format));
+    CHECK(textWithoutCR(out) == "previous destination\n");
+    const QString reason = QObject::tr(
+        "DXF R12 and R14 cannot store the lineweight of layer %1. "
+        "Use a newer DXF version or set that layer's lineweight to Default.",
+        "RS_FilterDXFRW").arg(QStringLiteral("0"));
+    CHECK(io->lastExportReport().contains(reason));
+    CHECK(layer->getPen().getWidth() == RS2::Width07);
+    pen.setWidth(RS2::WidthDefault);
+    layer->setPen(pen);
+    REQUIRE(io->fileExport(graphic, QString::fromStdString(out), format));
+    CHECK_FALSE(io->lastExportReport().contains(reason));
+    std::filesystem::remove(out);
+  }
 }
 
