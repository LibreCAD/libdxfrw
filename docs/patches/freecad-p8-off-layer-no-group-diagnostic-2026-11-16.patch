diff --git a/src/Mod/Import/App/dxf/dxf.cpp b/src/Mod/Import/App/dxf/dxf.cpp
index 7620c5b..a14b0ef 100644
--- a/src/Mod/Import/App/dxf/dxf.cpp
+++ b/src/Mod/Import/App/dxf/dxf.cpp
@@ -2037,0 +2038,5 @@ void CDxfRead::ResolveEntityAttributes()
+    // Without layer groups the output cannot retain an off layer's visibility.
+    // Record this before ResolveBylayerAttributes clears the layer pointer.
+    if (!m_preserveLayers && m_entityAttributes.m_Layer != nullptr && m_entityAttributes.m_Layer->Hidden) {
+        UnsupportedFeature("Off-layer visibility without layer grouping");
+    }
diff --git a/src/Mod/Import/importtests/TestImportDXF.py b/src/Mod/Import/importtests/TestImportDXF.py
index af21cd8..b9b67dc 100644
--- a/src/Mod/Import/importtests/TestImportDXF.py
+++ b/src/Mod/Import/importtests/TestImportDXF.py
@@ -53,0 +54,33 @@ class TestImportDXF(TestImportBase):
+    def test_off_layer_without_grouping_reports_visibility_loss(self):
+        """Report affected line and mesh records, but not an unused off layer."""
+        reason = "Off-layer visibility without layer grouping"
+        for use_off in (False, True):
+            with self.subTest(use_off=use_off):
+                layer = "OFF" if use_off else "ON"
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"),
+                        (2, "TABLES"), (0, "TABLE"), (2, "LAYER"), (70, 2),
+                        (0, "LAYER"), (2, "ON"), (70, 0), (62, 2), (6, "CONTINUOUS"),
+                        (0, "LAYER"), (2, "OFF"), (70, 0), (62, -2), (6, "CONTINUOUS"),
+                        (0, "ENDTAB"), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES"),
+                        (0, "LINE"), (5, "A"), (8, layer), (10, 0), (20, 0), (30, 0),
+                        (11, 2), (21, 0), (31, 0),
+                        (0, "POLYLINE"), (5, "B"), (8, layer), (66, 1), (70, 64)]
+                for x, y in ((0, 0), (4, 0), (0, 3)):
+                    tags.extend([(0, "VERTEX"), (8, layer), (10, x), (20, y), (30, 0), (70, 192)])
+                tags.extend([(0, "VERTEX"), (8, layer), (10, 0), (20, 0), (30, 0),
+                             (70, 128), (71, 1), (72, 2), (73, 3), (0, "SEQEND"), (8, layer),
+                             (0, "ENDSEC"), (0, "EOF")])
+                path = os.path.join(self.temp_dir, f"off-layer-no-grouping-{use_off}.dxf")
+                with open(path, "w", encoding="ascii", newline="\n") as stream:
+                    stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                previous = set(self.document.Objects)
+                stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                objects = [obj for obj in self.document.Objects if obj not in previous
+                           and obj.isDerivedFrom("Part::Feature")]
+                self.assertEqual(len([o for o in objects if o.Name.startswith("Shape")]), 1)
+                self.assertEqual(len([o for o in objects if o.Name.startswith("Polyface")]), 1)
+                self.assertEqual(reason in stats["unsupportedFeatures"], use_off)
+                if use_off:
+                    self.assertEqual(len(stats["unsupportedFeatures"][reason]), 2)
+
