+TEST_CASE("DXF version gates report typed-only fields and clear stale references",
+          "[dxf][roundtrip][filter][version][objects]") {
+  ensureSettings();
+  RS_Graphic graphic;
+  graphic.initForNewDocument();
+  RS_Layer *zero = graphic.findLayer("0");
+  REQUIRE(zero != nullptr);
+  RS_Pen pen = zero->getPen();
+  pen.setWidth(RS2::WidthDefault);
+  zero->setPen(pen);
+  auto *line = new RS_Line(&graphic, RS_LineData(RS_Vector(0.0, 0.0),
+                                                RS_Vector(1.0, 1.0)));
+  line->setReactorHandles({0xE4u});
+  graphic.addEntity(line);
+  DRW_Field field;
+  field.handle = 0xE4u;
+  graphic.dwgAdvancedMetadata().addField(field);
+  const std::string oldOut = tmpFile("typed_only_r14.dxf");
+  const std::string newOut = tmpFile("typed_only_r2004.dxf");
+  std::filesystem::remove(oldOut);
+  std::filesystem::remove(newOut);
+  RS_FilterDXFRW filter;
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(oldOut),
+                            RS2::FormatDXFRW14));
+  CHECK(filter.exportReport().contains(QStringLiteral("FIELD")));
+  CHECK(recordGroupValues(oldOut, "FIELD", "5").empty());
+  CHECK(danglingReferences(oldOut).empty());
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(newOut),
+                            RS2::FormatDXFRW2004));
+  CHECK(filter.exportReport().isEmpty());
+  CHECK(recordGroupValues(newOut, "FIELD", "5") ==
+        std::vector<std::string>{"E4"});
+  const auto refs = recordGroupValues(newOut, "LINE", "330");
+  CHECK(std::count(refs.begin(), refs.end(), "E4") == 1);
+  CHECK(danglingReferences(newOut).empty());
+  std::filesystem::remove(oldOut);
+  std::filesystem::remove(newOut);
+}
