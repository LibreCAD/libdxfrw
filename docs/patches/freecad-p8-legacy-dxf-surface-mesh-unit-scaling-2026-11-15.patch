+    def assertLegacyPoints(self, actual, expected, scale, tolerance):
+        actual = sorted((p.x, p.y, p.z) for p in actual)
+        expected = sorted(tuple(c * scale for c in p) for p in expected)
+        self.assertEqual(len(actual), len(expected))
+        for a, e in zip(actual, expected):
+            for x, y in zip(a, e):
+                self.assertAlmostEqual(x, y, delta=tolerance)
+
+    @unittest.skipUnless(getattr(importDXF, "mesh_available", True), "Mesh module unavailable")
+    def test_legacy_mesh_uses_resolved_scale(self):
+        points = [
+            (1.123456789, 2.25, 1.5),
+            (4.123456789, 2.25, 4.5),
+            (1.123456789, 6.25, 5.5),
+            (4.123456789, 6.25, 8.5),
+        ]
+
+        class Vertex:
+            flags = 192
+
+            def __init__(self, point):
+                self.point = point
+
+            def __getitem__(self, index):
+                return self.point[index]
+
+            def __len__(self):
+                return 3
+
+        poly = SimpleNamespace(
+            flags=16, points=[App.Vector(*p) for p in points], codes={71: 2, 72: 2}
+        )
+        face = SimpleNamespace(flags=128, codes={71: 1, 72: 2, 73: 4, 74: 3})
+        polyface = SimpleNamespace(flags=64, points=[Vertex(p) for p in points] + [face])
+        with mock.patch.object(importDXF, "rawValue", side_effect=lambda obj, code: obj.codes.get(code)):
+            for scale in (1.0, 25.4, 12.7):
+                for mesh in (poly, polyface):
+                    with self.subTest(scale=scale, flags=mesh.flags), mock.patch.object(
+                        importDXF, "resolvedScale", scale, create=True
+                    ):
+                        output = importDXF.drawMesh(mesh)
+                        self.assertIsNotNone(output)
+                        self.assertEqual(len(output.Facets), 2)
+                        self.assertLegacyPoints(output.Points, points, scale, 0.0001)
+                        shape = importDXF.drawMesh(mesh, forceShape=True)
+                        self.assertIsNotNone(shape)
+                        self.assertLegacyPoints(
+                            (v.Point for v in shape.Vertexes), points, scale, 0.0001
+                        )
+
+    def test_legacy_solid_uses_resolved_scale(self):
+        points = [
+            (11.123456789, 12.25, 13.5),
+            (14.123456789, 12.25, 13.5),
+            (11.123456789, 16.25, 13.5),
+            (14.123456789, 16.25, 13.5),
+        ]
+        solid = SimpleNamespace(codes={10 + i: p[0] for i, p in enumerate(points)})
+        solid.codes.update({20 + i: p[1] for i, p in enumerate(points)})
+        solid.codes.update({30 + i: p[2] for i, p in enumerate(points)})
+        with mock.patch.object(importDXF, "rawValue", side_effect=lambda obj, code: obj.codes.get(code)):
+            for scale in (1.0, 25.4, 12.7):
+                with self.subTest(scale=scale), mock.patch.object(
+                    importDXF, "resolvedScale", scale, create=True
+                ):
+                    shape = importDXF.drawSolid(solid)
+                    self.assertTrue(shape.isValid())
+                    self.assertAlmostEqual(shape.Area, 12 * scale * scale, delta=1e-6)
+                    self.assertLegacyPoints((v.Point for v in shape.Vertexes), points, scale, 1e-8)
+
+
