@@ -256,0 +258,61 @@ TEST_CASE("a refused DWG export creates no file and keeps an existing one", "[dw
+
+TEST_CASE("R13 raw source records are not silently dropped on conversion",
+          "[dxf][r13][export-commit][raw-source]") {
+    lc::test::ensureSettings();
+    const lc::test::QuietLog quiet;
+    for (int kind = 0; kind < 3; ++kind) {
+        for (const auto target :
+             {RS2::FormatDXFRW14, RS2::FormatDXFRW2000, RS2::FormatDXFRW, RS2::FormatDXFRW2018}) {
+            for (const bool existing : {false, true}) {
+                CAPTURE(kind, target, existing);
+                const lc::test::OutputDirectory out("r13_raw_conversion");
+                const auto file = out.file("drawing.dxf");
+                const std::string before = existing ? putExistingContent(file) : std::string();
+                RS_Graphic graphic;
+                fill(graphic, 1);
+                graphic.addVariable("$INSUNITS", 0, 70);
+                REQUIRE(graphic.findLayer("0") != nullptr);
+                RS_Pen pen = graphic.findLayer("0")->getPen();
+                pen.setWidth(RS2::WidthDefault);
+                graphic.findLayer("0")->setPen(pen);
+                if (kind == 2) {
+                    DRW_RawDxfSection section;
+                    section.m_name = "CUSTOM_R13_SECTION";
+                    section.m_version = DRW::AC1012;
+                    section.m_groups.emplace_back(1, std::string{"source data"});
+                    graphic.dwgAdvancedMetadata().addRawDxfSection(section);
+                } else {
+                    DRW_RawDxfObject raw;
+                    raw.name = kind == 0 ? "CUSTOM_R13_OBJECT" : "CUSTOM_R13_ENTITY";
+                    raw.handle = static_cast<std::uint32_t>(0xA0 + kind);
+                    raw.m_version = DRW::AC1012;
+                    raw.groups.emplace_back(5, std::string{kind == 0 ? "A0" : "A1"});
+                    raw.groups.emplace_back(1, std::string{"source data"});
+                    if (kind == 0)
+                        graphic.dwgAdvancedMetadata().addRawDxfObject(raw);
+                    else
+                        graphic.dwgAdvancedMetadata().addRawDxfEntity(raw);
+                }
+                RS_FilterDXFRW filter;
+                CHECK_FALSE(filter.fileExport(graphic, lc::test::toQString(file), target));
+                CHECK(filter.exportReport().contains(QStringLiteral("R13")));
+                if (existing) {
+                    CHECK(sameBytes(file, before));
+                    CHECK(out.entries() == std::vector<std::string>{"drawing.dxf"});
+                } else {
+                    CHECK(out.entries().empty());
+                }
+                RS_Graphic clean;
+                fill(clean, 1);
+                clean.addVariable("$INSUNITS", 0, 70);
+                REQUIRE(clean.findLayer("0") != nullptr);
+                clean.findLayer("0")->setPen(pen);
+                const bool retried = filter.fileExport(clean, lc::test::toQString(file), target);
+                INFO(filter.exportReport().toStdString());
+                CHECK(retried);
+                CHECK_FALSE(sameBytes(file, before));
+                CHECK(out.entries() == std::vector<std::string>{"drawing.dxf"});
+            }
+        }
+    }
+}
