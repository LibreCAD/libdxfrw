+void CDxfRead::Process3dFaceDouble(CDxfRead* object, void* target)
+{
+    auto& destination = *static_cast<double*>(target);
+    if (!std::isnan(destination)) {
+        destination = std::numeric_limits<double>::infinity();
+        return;
+    }
+    std::istringstream stream(object->m_record_data);
+    stream.imbue(std::locale("C"));
+    double value = 0.0;
+    if (!(stream >> value) || !(stream >> std::ws).eof() || !std::isfinite(value)) {
+        destination = std::numeric_limits<double>::infinity();
+        return;
+    }
+    destination = object->mm(value);
+}
+
+void CDxfRead::Process3dFaceFlags(CDxfRead* object, void* target)
+{
+    auto& destination = *static_cast<int*>(target);
+    if (destination != -1) {
+        destination = -2;
+        return;
+    }
+    std::istringstream stream(object->m_record_data);
+    stream.imbue(std::locale("C"));
+    int value = 0;
+    if (!(stream >> value) || !(stream >> std::ws).eof() || value < 0 || value > 15) {
+        destination = -2;
+        return;
+    }
+    destination = value;
+}
+
+bool CDxfRead::Read3dFace()
+{
+    const double absent = std::numeric_limits<double>::quiet_NaN();
+    Base::Vector3d first(absent, absent, absent);
+    Base::Vector3d second(absent, absent, absent);
+    Base::Vector3d third(absent, absent, absent);
+    Base::Vector3d fourth(absent, absent, absent);
+    int invisibleEdges = -1;
+
+    const auto setupCorner = [this](int code, Base::Vector3d& point) {
+        m_coordinate_attributes.emplace(code + eXOffset, std::pair(&Process3dFaceDouble, &point.x));
+        m_coordinate_attributes.emplace(code + eYOffset, std::pair(&Process3dFaceDouble, &point.y));
+        m_coordinate_attributes.emplace(code + eZOffset, std::pair(&Process3dFaceDouble, &point.z));
+    };
+    setupCorner(ePrimaryPoint, first);
+    setupCorner(ePoint2, second);
+    setupCorner(ePoint3, third);
+    setupCorner(ePoint4, fourth);
+    m_coordinate_attributes.emplace(eInteger1, std::pair(&Process3dFaceFlags, &invisibleEdges));
+    ProcessAllEntityAttributes();
+
+    for (auto* point : {&first, &second, &third}) {
+        if (std::isnan(point->z)) {
+            point->z = 0.0;
+        }
+    }
+    // A missing fourth corner is a triangle; partially specified corners are
+    // not geometry we can reconstruct safely. Omitted Z defaults to zero.
+    if (std::isnan(fourth.x) && std::isnan(fourth.y) && std::isnan(fourth.z)) {
+        fourth = third;
+    }
+    else if (std::isnan(fourth.z)) {
+        fourth.z = 0.0;
+    }
+    const auto finitePoint = [](const Base::Vector3d& point) {
+        return std::isfinite(point.x) && std::isfinite(point.y) && std::isfinite(point.z);
+    };
+    if (!finitePoint(first) || !finitePoint(second) || !finitePoint(third)
+        || !finitePoint(fourth)) {
+        UnsupportedFeature("3DFACE missing or nonfinite corner");
+        return true;
+    }
+    if (invisibleEdges == -2) {
+        UnsupportedFeature("3DFACE invalid or repeated edge flags");
+        return true;
+    }
+    if (invisibleEdges > 0) {
+        UnsupportedFeature("3DFACE invisible edge flags");
+        return true;
+    }
+    OnRead3dFace(first, second, third, fourth);
+    return true;
+}
