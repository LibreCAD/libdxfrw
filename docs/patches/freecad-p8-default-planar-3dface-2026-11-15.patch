+void ImpExpDxfRead::OnRead3dFace(
+    const Base::Vector3d& first,
+    const Base::Vector3d& second,
+    const Base::Vector3d& third,
+    const Base::Vector3d& fourth
+)
+{
+    if (shouldSkipEntity()) {
+        return;
+    }
+
+    try {
+        // 3DFACE coordinates are WCS, unlike the OCS corners of SOLID.
+        const gp_Pnt p1 = makePoint(first);
+        const gp_Pnt p2 = makePoint(second);
+        const gp_Pnt p3 = makePoint(third);
+        const gp_Pnt p4 = makePoint(fourth);
+        const bool isTriangle = third.x == fourth.x && third.y == fourth.y && third.z == fourth.z;
+        BRepBuilderAPI_MakeWire wireBuilder;
+        wireBuilder.Add(BRepBuilderAPI_MakeEdge(p1, p2).Edge());
+        wireBuilder.Add(BRepBuilderAPI_MakeEdge(p2, p3).Edge());
+        if (!isTriangle) {
+            wireBuilder.Add(BRepBuilderAPI_MakeEdge(p3, p4).Edge());
+            wireBuilder.Add(BRepBuilderAPI_MakeEdge(p4, p1).Edge());
+        }
+        else {
+            wireBuilder.Add(BRepBuilderAPI_MakeEdge(p3, p1).Edge());
+        }
+        if (wireBuilder.IsDone()) {
+            // Do not invent a triangulation for nonplanar quadrilaterals.
+            BRepBuilderAPI_MakeFace faceBuilder(wireBuilder.Wire(), true);
+            if (faceBuilder.IsDone() && BRepCheck_Analyzer(faceBuilder.Face()).IsValid()) {
+                Collector->AddObject(faceBuilder.Face(), "Face3D");
+                return;
+            }
+        }
+    }
+    catch (const Standard_Failure&) {
+    }
+    UnsupportedFeature("3DFACE nonplanar or invalid geometry");
+}
