@@ -3190,0 +3202,41 @@ TEST(DxfRoundTripTest, DrawingUnitsSurviveASave) {
+
+// NOLINTNEXTLINE(readability-identifier-naming)
+TEST(DxfRoundTripTest, LegacyLayerLineweightsReportLossAndKeepGeometry) {
+    auto doc = newDocument();
+    auto layer = std::make_shared<lc::meta::Layer>(
+        "A", lc::meta::MetaLineWidthByValue(0.25), lc::Color(255, 255, 255, 255));
+    std::make_shared<lc::operation::AddLayer>(doc, layer)->execute();
+    auto line = std::make_shared<lc::entity::Line>(
+        lc::geo::Coordinate(0, 0, 0), lc::geo::Coordinate(4, 3, 0), layer);
+    insertThroughBuilder(doc, {line});
+    const lc::persistence::File::Type legacyTypes[] = {
+        lc::persistence::File::LIBDXFRW_DXF_R12, lc::persistence::File::LIBDXFRW_DXF_R14,
+        lc::persistence::File::LIBDXFRW_DXB_R12, lc::persistence::File::LIBDXFRW_DXB_R14};
+    for (const auto type : legacyTypes) {
+        const std::string output = uniqueTmpDxf("layer-weights-legacy");
+        const auto result = lc::persistence::File::exportFile(doc, output, type);
+        ASSERT_TRUE(result.ok) << static_cast<int>(type);
+        ASSERT_EQ(result.loss.notes.size(), 1u);
+        EXPECT_NE(result.loss.notes.front().find("Layer lineweights"), std::string::npos);
+        auto reread = newDocument();
+        ASSERT_TRUE(lc::persistence::File::importFile(
+            reread, output, lc::persistence::File::Library::LIBDXFRW).ok);
+        EXPECT_EQ(entitiesInDocument(reread)["Line"], 1u);
+        EXPECT_EQ(reread->allLayers().count("A"), 1u);
+        EXPECT_FALSE(lc::persistence::File::save(doc, output, type));
+        boost::filesystem::remove(output);
+    }
+    const std::string modern = uniqueTmpDxf("layer-weights-modern");
+    const auto modernResult = lc::persistence::File::exportFile(
+        doc, modern, lc::persistence::File::LIBDXFRW_DXF_R2000);
+    ASSERT_TRUE(modernResult.ok);
+    EXPECT_TRUE(modernResult.loss.empty());
+    auto reread = newDocument();
+    ASSERT_TRUE(lc::persistence::File::importFile(
+        reread, modern, lc::persistence::File::Library::LIBDXFRW).ok);
+    EXPECT_EQ(entitiesInDocument(reread)["Line"], 1u);
+    ASSERT_EQ(reread->allLayers().count("A"), 1u);
+    EXPECT_DOUBLE_EQ(reread->allLayers().at("A")->lineWidth().width(), 0.25);
+    boost::filesystem::remove(modern);
+}
