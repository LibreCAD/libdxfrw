diff --git a/persistence/libdxfrw/dxfimpl.cpp b/persistence/libdxfrw/dxfimpl.cpp
index 3776e5b..5284126 100644
--- a/persistence/libdxfrw/dxfimpl.cpp
+++ b/persistence/libdxfrw/dxfimpl.cpp
@@ -1682,0 +1683,11 @@ void DXFimpl::writeLayer(const std::shared_ptr<const lc::meta::Layer>& layer) {
+    // R12/R14 have no layer lineweight field. Preserve the writer's
+    // fail-closed contract, but allow an explicit, reported conversion.
+    if (_exportVersion <= DRW::AC1014 && lay.lWeight != DRW_LW_Conv::widthDefault) {
+        const std::string note =
+            "Layer lineweights were not retained: R12/R14 DXF has no layer lineweight field.";
+        if (std::find(_loss.notes.begin(), _loss.notes.end(), note) == _loss.notes.end()) {
+            _loss.notes.push_back(note);
+        }
+        lay.lWeight = DRW_LW_Conv::widthDefault;
+    }
+
