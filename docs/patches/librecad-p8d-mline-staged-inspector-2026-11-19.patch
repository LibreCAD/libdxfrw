+// Experimental profile: unit planar miters, exactly two continuous elements,
+// no source XDATA, and six vertices. Wider semantics require separate proof.
+bool eligibleGroup41MLine(const DRW_MLine &data) {
+  if (data.numLines != 2 || data.vertlist.size() != 6 || data.numVerts != 6 ||
+      data.openClosed != 1 || data.scale != 1.0 || data.justification != 0 ||
+      !data.extData.empty() || data.extPoint.x != 0 || data.extPoint.y != 0 ||
+      data.extPoint.z != 1 || data.basePoint.x != data.vertlist[0].position.x ||
+      data.basePoint.y != data.vertlist[0].position.y || data.basePoint.z != 0)
+    return false;
+  for (const auto &v : data.vertlist) {
+    const double norm = std::hypot(v.miterDir.x, v.miterDir.y);
+    if (!std::isfinite(v.position.x) || !std::isfinite(v.position.y) ||
+        v.position.z != 0 || !std::isfinite(v.vertexDir.x) ||
+        !std::isfinite(v.vertexDir.y) || v.vertexDir.z != 0 ||
+        !std::isfinite(norm) || std::abs(norm - 1.0) > 1e-9 ||
+        v.miterDir.z != 0 || v.segParms.size() != 2 ||
+        v.areaFillParms.size() != 2)
+      return false;
+    for (std::size_t i = 0; i < 2; ++i)
+      if (v.segParms[i].size() != 2 || !std::isfinite(v.segParms[i][0]) ||
+          v.segParms[i][1] != 0 || !v.areaFillParms[i].empty() ||
+          !std::isfinite(v.position.x + v.miterDir.x / norm * v.segParms[i][0]) ||
+          !std::isfinite(v.position.y + v.miterDir.y / norm * v.segParms[i][0]))
+        return false;
+  }
+  return true;
+}
