+// The currently witnessed open profile has nondegenerate straight baseline
+// segments, matching unit forward directions, and consistently oriented unit
+// angle-bisector miters. The last direction repeats the preceding segment.
+// This is a narrow source/profile guard, not general MLINE validation.
+bool group41Topology(const DRW_Coord *positions, const DRW_Coord *directions,
+                     const DRW_Coord *miters, std::size_t count) {
+  if (!positions || !directions || !miters || count != 6u)
+    return false;
+  constexpr double tolerance = 1e-8;
+  std::array<double, 5> ux{}, uy{};
+  for (std::size_t i = 0; i + 1u < count; ++i) {
+    const double dx = positions[i + 1u].x - positions[i].x;
+    const double dy = positions[i + 1u].y - positions[i].y;
+    const double length = std::hypot(dx, dy);
+    if (!std::isfinite(dx) || !std::isfinite(dy) ||
+        !std::isfinite(length) || length <= RS_TOLERANCE)
+      return false;
+    ux[i] = dx / length;
+    uy[i] = dy / length;
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    const std::size_t segment = i == count - 1u ? i - 1u : i;
+    if (!std::isfinite(directions[i].x) || !std::isfinite(directions[i].y) ||
+        directions[i].z != 0.0 ||
+        std::abs(directions[i].x - ux[segment]) > tolerance ||
+        std::abs(directions[i].y - uy[segment]) > tolerance)
+      return false;
+    double tangentX = ux[segment];
+    double tangentY = uy[segment];
+    if (i > 0u && i + 1u < count) {
+      tangentX += ux[i - 1u];
+      tangentY += uy[i - 1u];
+    }
+    const double bisectorLength = std::hypot(tangentX, tangentY);
+    if (!std::isfinite(bisectorLength) || bisectorLength <= RS_TOLERANCE ||
+        !std::isfinite(miters[i].x) || !std::isfinite(miters[i].y) ||
+        miters[i].z != 0.0 ||
+        std::abs(miters[i].x + tangentY / bisectorLength) > tolerance ||
+        std::abs(miters[i].y - tangentX / bisectorLength) > tolerance)
+      return false;
+  }
+  return true;
+}
+
+bool group41Topology(const DRW_MLine &line) {
+  if (line.vertlist.size() != 6u)
+    return false;
+  std::array<DRW_Coord, 6> positions{}, directions{}, miters{};
+  for (std::size_t i = 0; i < positions.size(); ++i) {
+    positions[i] = line.vertlist[i].position;
+    directions[i] = line.vertlist[i].vertexDir;
+    miters[i] = line.vertlist[i].miterDir;
+  }
+  return group41Topology(positions.data(), directions.data(), miters.data(), positions.size());
+}
+
+// This experimental witness guard deliberately accepts only the selected
+// STANDARD style profile. It is not a general MLINESTYLE validator.
+template <class T> bool selectedGroup41Style(const T &style) {
+  return style.name == "STANDARD" && style.flags == 0 &&
+      style.fillColor == 256 && style.description.empty() &&
+      style.startAngle == 90.0 && style.endAngle == 90.0 &&
+      style.elements.size() == 2 && style.elements[0].offset == 0.5 &&
+      style.elements[1].offset == -0.5 &&
+      style.elements[0].color == 256 && style.elements[1].color == 256 &&
+      style.elements[0].color24 == -1 && style.elements[1].color24 == -1 &&
+      style.elements[0].linetype == "BYLAYER" && style.elements[1].linetype == "BYLAYER";
+}
