+namespace {
+// A disconnected polyline cannot be represented as one DXF LWPOLYLINE;
+// emitting the ordinary fallback would silently join its edited segments.
+bool group41FallbackPolylineIsRepresentable(RS_Polyline *polyline) {
+  if (!polyline) return false;
+  bool seen = false;
+  RS_Vector first, previous;
+  for (RS_Entity *entity :
+       lc::LC_ContainerTraverser{*polyline, RS2::ResolveNone}.entities()) {
+    if (!entity || (entity->rtti() != RS2::EntityLine &&
+                    entity->rtti() != RS2::EntityArc))
+      return false;
+    const auto *segment = static_cast<const RS_AtomicEntity *>(entity);
+    const RS_Vector start = segment->getStartpoint(), end = segment->getEndpoint();
+    if (!hasFiniteVisibleCoordinate(start) || !hasFiniteVisibleCoordinate(end) ||
+        (seen && !pointsMatch2D(start, DRW_Coord{previous.x, previous.y, 0.0})))
+      return false;
+    if (!seen) first = start;
+    seen = true;
+    previous = end;
+  }
+  return seen && (!polyline->isClosed() ||
+      pointsMatch2D(previous, DRW_Coord{first.x, first.y, 0.0}));
+}
