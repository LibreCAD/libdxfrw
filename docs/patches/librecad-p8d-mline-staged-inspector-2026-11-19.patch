+      ++r.handleCount;
+      if (!stageHex(v, r.handle))
+        return false;
+      if (targets.count(r.handle))
+        r.touchesTarget = true;
+      continue;
+    }
+    if (code == 330 && depth == 0) {
+      ++r.ownerCount;
+      if (!stageHex(v, r.owner, true))
+        return false;
+      continue;
+    }
+    if (code == 340 && depth == 0 && r.kind == "MLINE") {
+      ++r.targetCount;
+      if (!stageHex(v, r.target))
+        return false;
+      continue;
+    }
+    if (r.kind == "MLINESTYLE" && depth == 0 && r.styleBody && code == 100 &&
+        v != "AcDbMlineStyle")
+      r.unsupportedStyle = true;
+    if (r.kind == "MLINESTYLE" && depth == 0 && r.styleBody && code != 100) {
+      if (r.handleCount == 0)
+        r.payloadBeforeIdentity = true;
+      if (code != 2 && code != 70 && code != 3 && code != 62 && code != 51 &&
+          code != 52 && code != 71 && code != 49 && code != 6)
+        r.unsupportedStyle = true;
+      else if (r.touchesTarget) {
+        if (r.styleFields.size() >= 16 || v.size() > 256)
+          return false;
+        r.styleFields.push_back({code, v});
+      }
+    }
+    if (code == 2 && (r.kind == "MLINE" || r.kind == "MLINESTYLE")) {
+      ++r.nameCount;
+      r.name = v;
+      continue;
+    }
+    if (r.kind == "DICTIONARY" && depth == 0) {
+      if (code == 3) {
+        if (!pendingName.isEmpty() || v.isEmpty() ||
+            static_cast<std::uint64_t>(v.size()) > budget.maxDictionaryKeyBytes)
+          return false;
+        pendingName = v;
+      } else if (code == 350 || code == 360) {
+        std::uint32_t target = 0;
+        const auto nameBytes = static_cast<std::uint64_t>(pendingName.size());
+        if (pendingName.isEmpty() || !stageHex(v, target) ||
+            ++entryCount > budget.maxDictionaryEntriesPerRecord ||
+            ++totalEntries > budget.maxTotalDictionaryEntries ||
+            entryBytes > budget.maxAggregateDictionaryKeyBytes ||
+            nameBytes > budget.maxAggregateDictionaryKeyBytes - entryBytes)
+          return false;
+        entryBytes += nameBytes;
+        r.entries.push_back({pendingName, target, code});
+        pendingName.clear();
+      }
+    }
+  }
+  if (!finish() || !seenEof || !section.isEmpty() || sectionPending)
+    return false;
+  for (const auto &e : expected) {
+    if (counts[e.anchor] != 1)
+      return false;
+    const auto &a = selected[e.anchor];
+    if (a.kind != "MLINE" || a.section != "ENTITIES" || a.name != "STANDARD" ||
+        a.nameCount != 1 || a.ownerCount != 1 || a.owner != 0x1F ||
+        a.targetCount != 1 || a.target != e.style || !e.style ||
+        !e.dictionary || e.style == e.dictionary || e.style == 0xC ||
+        e.dictionary == 0xC)
+      return false;
+    if (counts[0xC] != 1 || counts[e.style] != 1 || counts[e.dictionary] != 1)
+      return false;
+    const auto &root = selected[0xC], &dict = selected[e.dictionary],
+               &style = selected[e.style];
+    if (root.kind != "DICTIONARY" || root.section != "OBJECTS" ||
+        root.ownerCount != 1 || root.owner != 0 || !root.dictionaryBody ||
+        root.dictionarySubclassCount != 1 || root.unsupportedDictionary ||
+        root.hardOwnerCount != 0 || root.cloningCount != 1 ||
+        root.cloning != 1 || root.reactorOpen != 0 || !root.reactors.empty() ||
+        dict.kind != "DICTIONARY" || dict.section != "OBJECTS" ||
+        dict.ownerCount != 1 || dict.owner != 0xC || !dict.dictionaryBody ||
+        dict.dictionarySubclassCount != 1 || dict.unsupportedDictionary ||
+        dict.hardOwnerCount != 1 || dict.hardOwner != 0 ||
+        dict.cloningCount != 1 || dict.cloning != 1 || dict.reactorOpen != 1 ||
+        dict.reactors.size() != 1 || dict.reactors[0] != 0xC ||
+        style.kind != "MLINESTYLE" || style.section != "OBJECTS" ||
+        style.ownerCount != 1 || style.owner != e.dictionary ||
+        style.nameCount != 1 || style.name != "STANDARD" || !style.styleBody ||
+        style.styleSubclassCount != 1 || style.reactorOpen != 1 ||
+        style.reactors.size() != 1 || style.reactors[0] != e.dictionary ||
+        style.unsupportedStyle || !a.mlineBody || a.unsupportedMline)
+      return false;
+    auto edge = [](const StageRecord &rec, const QByteArray &key,
+                   std::uint32_t target) {
+      return std::count_if(rec.entries.begin(), rec.entries.end(),
+                           [&](const StageRecord::Edge &x) {
+                             return x.key.compare(key, Qt::CaseInsensitive) ==
+                                        0 &&
+                                    x.target == target && x.role == 350;
+                           }) == 1 &&
+             std::count_if(rec.entries.begin(), rec.entries.end(),
+                           [&](const StageRecord::Edge &x) {
+                             return x.key.compare(key, Qt::CaseInsensitive) ==
+                                        0 ||
+                                    x.target == target;
+                           }) == 1;
+    };
+    if (!edge(root, "ACAD_MLINESTYLE", e.dictionary) ||
+        !edge(dict, "Standard", e.style) || standardStyles != 1 ||
+        malformedStyleName)
+      return false;
+    const auto &common = a.mlineCommon;
+    const int commonCodes[] = {5, 330, 100, 8, 6, 62, 370, 100};
+    if (common.size() != 8)
+      return false;
+    for (std::size_t i = 0; i < 8; ++i)
+      if (common[i].first != commonCodes[i])
+        return false;
+    std::uint32_t commonAnchor = 0, commonOwner = 0;
+    if (!stageHex(common[0].second, commonAnchor) || commonAnchor != e.anchor ||
+        !stageHex(common[1].second, commonOwner) || commonOwner != 0x1F ||
+        common[2].second != "AcDbEntity" || common[3].second != "0" ||
+        common[4].second != "ByLayer" || common[7].second != "AcDbMline")
+      return false;
+    bool colorOk = false, weightOk = false;
+    if (common[5].second.toInt(&colorOk) != 256 || !colorOk ||
+        common[6].second.toInt(&weightOk) != -1 || !weightOk)
+      return false;
+    // The emitted MLINE must be exactly the V2 model selected by the write
+    // callback, within the existing ASCII binary64 formatting tolerance.
+    std::size_t cursor = 0;
+    auto value = [&](int code, const QByteArray &literal) {
+      if (cursor >= a.mlineFields.size() ||
+          a.mlineFields[cursor].first != code ||
+          a.mlineFields[cursor].second != literal)
+        return false;
+      ++cursor;
+      return true;
+    };
+    auto number = [&](int code, double expectedValue) {
+      if (cursor >= a.mlineFields.size() || a.mlineFields[cursor].first != code)
+        return false;
+      bool ok = false;
+      double x = a.mlineFields[cursor++].second.toDouble(&ok);
+      return ok && std::isfinite(x) && std::isfinite(expectedValue) &&
+             std::abs(x - expectedValue) <= 1e-12;
+    };
+    auto integer = [&](int code, int expectedValue) {
+      if (cursor >= a.mlineFields.size() || a.mlineFields[cursor].first != code)
+        return false;
+      bool ok = false;
+      int x = a.mlineFields[cursor++].second.toInt(&ok);
+      return ok && x == expectedValue;
+    };
+    auto ref = [&]() {
+      if (cursor >= a.mlineFields.size() || a.mlineFields[cursor].first != 340)
+        return false;
+      std::uint32_t x = 0;
+      return stageHex(a.mlineFields[cursor++].second, x) && x == e.style;
+    };
+    if (!value(2, "STANDARD") || !ref() || !number(40, 1) || !integer(70, 0) ||
+        !integer(71, 1) || !integer(72, 6) || !integer(73, 2))
+      return false;
+    for (int k = 0; k < 3; ++k)
+      if (!number(10 + 10 * k, e.base[k]))
+        return false;
+    for (int i = 0; i < 6; ++i) {
+      for (int k = 0; k < 3; ++k)
+        if (!number(11 + 10 * k, e.position[i][k]))
+          return false;
+      for (int k = 0; k < 3; ++k)
+        if (!number(12 + 10 * k, e.direction[i][k]))
+          return false;
+      for (int k = 0; k < 3; ++k)
+        if (!number(13 + 10 * k, e.miter[i][k]))
+          return false;
+      for (int k = 0; k < 2; ++k)
+        if (!integer(74, 2) || !number(41, e.distances[i][k]) ||
+            !number(41, 0) || !integer(75, 0))
+          return false;
+    }
+    if (cursor != a.mlineFields.size())
+      return false;
+    const auto &sf = style.styleFields;
+    const int codes[] = {2, 70, 3, 62, 51, 52, 71, 49, 62, 6, 49, 62, 6};
+    // Keep the complete, ordered profile; do not accept extra style fields.
+    if (sf.size() != 13)
+      return false;
+    for (std::size_t i = 0; i < sf.size(); ++i)
+      if (sf[i].first != codes[i])
+        return false;
+    auto styleInteger = [&](std::size_t i, int value) {
+      bool ok = false;
+      auto x = sf[i].second.toInt(&ok);
+      return ok && x == value;
+    };
+    auto styleReal = [&](std::size_t i, double value) {
+      bool ok = false;
+      auto x = sf[i].second.toDouble(&ok);
+      return ok && x == value;
+    };
+    if (sf[0].second != "STANDARD" || !styleInteger(1, 0) ||
+        !sf[2].second.isEmpty() || !styleInteger(3, 256) || !styleReal(4, 90) ||
+        !styleReal(5, 90) || !styleInteger(6, 2) || !styleReal(7, 0.5) ||
+        !styleInteger(8, 256) || sf[9].second != "BYLAYER" ||
+        !styleReal(10, -0.5) || !styleInteger(11, 256) ||
+        sf[12].second != "BYLAYER")
+      return false;
+  }
+  return true;
+}
