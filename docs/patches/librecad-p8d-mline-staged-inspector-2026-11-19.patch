+bool hasGroup41Marker(const RS_Entity *entity) {
+  if (!entity || !entity->hasDrwExtData()) return false;
+  for (const auto &value : entity->getDrwExtData()) {
+    std::string marker;
+    if (readXDataMarker(value.get(), marker) == XDataReadResult::Valid &&
