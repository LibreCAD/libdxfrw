+struct HasCanonicalLTypeMetadata : std::false_type {};
+
+template <typename T>
+struct HasCanonicalLTypeMetadata<T, std::void_t<decltype(
+    std::declval<T&>().setCanonicalLineTypeMetadata(
+        std::declval<const std::vector<DRW_LType>&>()))>> : std::true_type {};
+
 std::string slurp(const std::filesystem::path &path);
 std::vector<std::pair<std::string, std::string>> readGroups(
