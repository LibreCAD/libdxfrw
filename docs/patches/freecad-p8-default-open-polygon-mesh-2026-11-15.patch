+            ("long_grid", False), ("closed_m", False), ("closed_n", False),
+            ("smooth_type", False), ("smooth_density", False), ("bad_smooth", False),
+            ("header_subclass", False), ("vertex_subclass", False),
+            ("bad_vertex_flag", False), ("wrong_owner", False), ("vertex_color", False),
+            ("duplicate_coord", False), ("nonplanar_second", False),
+            ("missing_seqend", False), ("missing_header_flag", False),
+        ]
+        for name, accepted in cases:
+            with self.subTest(profile=name):
+                flags = {"closed_m": 17, "closed_n": 48}.get(name, 16)
+                tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                        (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                        (0, "SECTION"), (2, "ENTITIES"), (0, "POLYLINE"),
+                        (5, "A"), (330, "B"), (100, "AcDbEntity"), (8, "0"),
+                        (100, "AcDbPolyFaceMesh" if name == "header_subclass" else "AcDbPolygonMesh"),
+                        (66, 1)]
+                if name != "missing_header_flag":
+                    tags.append((70, "16junk" if name == "bad_header_flags" else flags))
+                tags.append((71, "2junk" if name == "bad_count" else 2))
+                if name != "missing_count": tags.append((72, 3))
+                if name == "duplicate_count": tags.append((71, 2))
+                if name == "zero_smoothing": tags.extend([(73, 0), (74, 0), (75, 0)])
+                if name == "smooth_type": tags.append((75, 5))
+                if name == "smooth_density": tags.append((73, 1))
+                if name == "bad_smooth": tags.append((75, "oops"))
+                grid = points[:-1] if name == "short_grid" else points + [(9, 9, 9)] if name == "long_grid" else points
+                for i, (x, y, z) in enumerate(grid):
+                    if name == "nonplanar_second" and i == 5: z += 1
+                    tags.extend([(0, "VERTEX"), (330, "C" if name == "wrong_owner" else "A"),
