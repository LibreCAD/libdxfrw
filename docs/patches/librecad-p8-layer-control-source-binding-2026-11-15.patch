+  // One optional, bounded source body; it is not export authority.
+  void observeAc1024LayerControlSource(
+      const DRW_DwgAc1024LayerControlSource &source) noexcept {
+    noteSelectedSourceCallback();
+    if (m_layerControlSourceCaptureFailed)
+      return;
+    const auto reject = [this]() noexcept {
+      m_layerControlSource.reset();
+      m_layerControlSourceCaptureFailed = true;
+    };
+    const auto &raw = source.m_raw;
+    if (m_layerControlSource || raw.m_handle == 0u || raw.m_handle == DRW::NoHandle
+        || raw.m_rawBytes.empty() || raw.m_rawBytes.size() > 4096u
+        || !raw.m_recordName.empty() || !raw.m_className.empty()
+        || !raw.m_classAppName.empty() || !raw.m_reactorHandles.empty()) {
+      reject();
+      return;
+    }
+    try {
+      m_layerControlSource = source;
+    } catch (...) {
+      reject();
+    }
+  }
+  bool ac1024LayerControlSourceCaptureFailed() const noexcept {
+    return m_layerControlSourceCaptureFailed;
+  }
+  bool matchesAc1024LayerControlExtensionSource(std::uint32_t controlHandle,
+      std::uint32_t dictionaryHandle) const noexcept;
+#endif
