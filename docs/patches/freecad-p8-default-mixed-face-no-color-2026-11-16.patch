diff --git a/src/Mod/Import/App/dxf/dxf.cpp b/src/Mod/Import/App/dxf/dxf.cpp
index 1a6aa04..cbf4730 100644
--- a/src/Mod/Import/App/dxf/dxf.cpp
+++ b/src/Mod/Import/App/dxf/dxf.cpp
@@ -2537,3 +2537,4 @@ bool CDxfRead::ReadBoundedMesh(
-            // A face may explicitly override its parent's color. This profile
-            // emits one compound, so all face colors must agree. An omitted or
-            // BYLAYER face on an explicitly colored parent remains ambiguous.
+            // One compound cannot preserve mixed face colors. When colors are
+            // explicitly disabled, retain the valid geometry instead. An
+            // omitted or BYLAYER face on a colored parent is also ambiguous
+            // only when colors are being preserved.
@@ -2541 +2542 @@ bool CDxfRead::ReadBoundedMesh(
-            if (faceColor == 256 && parentColor != 256) profileValid = false;
+            if (m_preserveColors && faceColor == 256 && parentColor != 256) profileValid = false;
@@ -2543 +2544 @@ bool CDxfRead::ReadBoundedMesh(
