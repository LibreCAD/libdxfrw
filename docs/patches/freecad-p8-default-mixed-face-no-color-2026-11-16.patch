+            else if (m_preserveColors && uniformFaceColor != faceColor) profileValid = false;
diff --git a/src/Mod/Import/importtests/TestImportDXF.py b/src/Mod/Import/importtests/TestImportDXF.py
index 25868b0..1e82ad7 100644
--- a/src/Mod/Import/importtests/TestImportDXF.py
+++ b/src/Mod/Import/importtests/TestImportDXF.py
@@ -933,0 +934,48 @@ class TestImportDXF(TestImportBase):
+    def test_bounded_polyface_color_disabled_mixed_and_invalid(self):
+        """Discard valid face colors only when requested; keep malformed colors refused."""
+        options = FreeCAD.ParamGet(self.option_source)
+        cases = (("mixed", ((2,), (3,)), True), ("omitted", ((2,), ()), True),
+                 ("bylayer", ((2,), (256,)), True), ("byblock", ((2,), (0,)), False),
+                 ("range", ((2,), (257,)), False), ("duplicate", ((2,), (2, 3)), False),
+                 ("malformed", ((2,), ("bad",)), False), ("badindex", ((2,), (3,)), False))
+        for preserve in (True, False):
+            options.SetBool("dxfGetOriginalColors", preserve)
+            for name, first_colors, valid in cases:
+                with self.subTest(preserve=preserve, profile=name):
+                    tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                            (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                            (0, "SECTION"), (2, "ENTITIES")]
+                    for offset, colors in ((0, first_colors), (10, ((2,), (2,)))):
+                        tags.extend([(0, "POLYLINE"), (8, "0"), (66, 1), (70, 64), (62, 1)])
+                        for x, y in ((offset, 0), (offset + 4, 0), (offset + 4, 3), (offset, 3)):
+                            tags.extend([(0, "VERTEX"), (8, "0"), (10, x), (20, y), (30, 0),
+                                         (70, 192), (62, 1)])
+                        for indices, color_tags in zip(((1, 2, 3), (1, 3, 4)), colors):
+                            if name == "badindex" and offset == 0 and indices == (1, 3, 4):
+                                indices = (1, 3, 99)
+                            tags.extend([(0, "VERTEX"), (8, "0"), (10, 0), (20, 0), (30, 0), (70, 128)])
+                            tags.extend((71 + index, value) for index, value in enumerate(indices))
+                            tags.extend((62, color) for color in color_tags)
+                        tags.extend([(0, "SEQEND"), (8, "0")])
+                    tags.extend([(0, "LINE"), (8, "0"), (10, 20), (20, 0), (30, 0),
+                                 (11, 22), (21, 0), (31, 0), (0, "ENDSEC"), (0, "EOF")])
+                    path = os.path.join(self.temp_dir, f"mixed-face-{preserve}-{name}.dxf")
+                    with open(path, "w", encoding="ascii", newline="\n") as stream:
+                        stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                    previous = set(self.document.Objects)
+                    stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                    objects = [obj for obj in self.document.Objects if obj not in previous
+                               and obj.isDerivedFrom("Part::Feature")]
+                    meshes = [obj for obj in objects if obj.Name.startswith("Polyface")]
+                    lines = [obj for obj in objects if obj.Name.startswith("Shape")]
+                    accepted = valid and not preserve
+                    self.assertEqual(len(meshes), 1 + int(accepted))
+                    self.assertEqual(len(lines), 1)
+                    for mesh in meshes:
+                        self.assertEqual(len(mesh.Shape.Faces), 2)
+                        self.assertAlmostEqual(mesh.Shape.Area, 12.0)
+                    reason = "POLYFACE unsupported or invalid profile"
+                    self.assertEqual(reason in stats["unsupportedFeatures"], not accepted)
+                    if not accepted:
+                        self.assertEqual(len(stats["unsupportedFeatures"][reason]), 1)
+
