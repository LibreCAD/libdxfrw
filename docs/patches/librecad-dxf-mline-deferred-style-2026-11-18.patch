+void RS_FilterDXFRW::finishPendingDxfMLines() {
+  std::set<RS_EntityContainer *> affected;
+  for (const auto &pending : m_pendingDxfMLines) {
+    projectMLine(pending.source.get(), &pending.placeholders);
+    affected.insert(pending.container);
+  }
+  m_pendingDxfMLines.clear();
+  for (auto *container : affected)
+    if (container != nullptr)
+      container->calculateBorders();
+}
