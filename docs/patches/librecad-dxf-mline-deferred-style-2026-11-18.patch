+TEST_CASE("DXF filter resolves a late MLINE style in source order",
+          "[mline][filter][dxf_roundtrip]") {
+  lc::test::ensureSettings();
+  lc::test::QuietLog quiet;
+  QTemporaryDir temporary;
+  REQUIRE(temporary.isValid());
+  RS_FilterDXFRW filter;
+
+  enum class Style { Matched, Missing, DifferentHandle };
+  for (const bool binary : {false, true}) {
+    for (const auto profile : {Style::Matched, Style::Missing, Style::DifferentHandle}) {
+      CAPTURE(binary, profile);
+      const auto path = temporary.filePath(
+          QStringLiteral("mline-%1-%2.dxf").arg(binary).arg(static_cast<int>(profile)));
+      const QByteArray fileName = path.toUtf8();
+      LateMLineStyleEmitter emitter;
+      emitter.includeStyle = profile != Style::Missing;
+      emitter.style.handle = 0xD0u;
+      emitter.style.name = "WALLSTYLE";
+      emitter.style.elements.resize(2);
+      emitter.style.elements[0].offset = 0.5;
+      emitter.style.elements[1].offset = -0.5;
+      emitter.m_line.styleName = emitter.style.name;
+      emitter.m_line.styleHandle = profile == Style::DifferentHandle
+          ? 0xD1u : emitter.style.handle;
+      emitter.m_line.numLines = 2;
+      emitter.m_line.numVerts = 2;
+      for (const double x : {0.0, 10.0}) {
+        DRW_MLineVertex vertex;
+        vertex.position = DRW_Coord(x, 0.0, 0.0);
+        vertex.vertexDir = DRW_Coord(1.0, 0.0, 0.0);
+        vertex.miterDir = DRW_Coord(0.0, 1.0, 0.0);
+        vertex.segParms = {{0.0, 0.0}, {-1.0, 0.0}};
+        vertex.areaFillParms.resize(2);
+        emitter.m_line.vertlist.push_back(vertex);
+      }
+      {
+        dxfRW writer(fileName.constData());
+        emitter.m_rw = &writer;
+        REQUIRE(writer.write(&emitter, DRW::AC1021, binary));
+      }
+
+      RS_Graphic drawing;
+      REQUIRE(filter.fileImport(drawing, path, RS2::FormatDXFRW));
+      REQUIRE(drawing.count() == 4);
+      const auto *before = dynamic_cast<const RS_Line *>(drawing.entityAt(0));
+      const auto *after = dynamic_cast<const RS_Line *>(drawing.entityAt(3));
+      REQUIRE(before != nullptr);
+      REQUIRE(after != nullptr);
+      CHECK(before->getStartpoint().x == 100.0);
+      CHECK(after->getStartpoint().x == 200.0);
+      for (const int index : {0, 1}) {
+        const auto *polyline = dynamic_cast<const RS_Polyline *>(drawing.entityAt(index + 1));
+        REQUIRE(polyline != nullptr);
+        const double expected = profile == Style::Matched ? -index : index - 0.5;
+        CHECK(polyline->getStartpoint().y == Approx(expected));
+        CHECK(polyline->getEndpoint().y == Approx(expected));
+        const auto &xdata = polyline->getDrwExtData();
+        REQUIRE(xdata.size() > 8);
+        REQUIRE(xdata[8] != nullptr);
+        REQUIRE(xdata[8]->type() == DRW_Variant::DOUBLE);
+        CHECK(xdata[8]->d_val() == Approx(expected));
+      }
+    }
+  }
+}
