diff --git a/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp b/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
index 4d822ff..5c95588 100644
--- a/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
+++ b/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
@@ -11467,0 +11468 @@ TEST_CASE("Binary DXF imports an editable line type definition",
+      input.close();
@@ -11564,0 +11566,157 @@ TEST_CASE("R13 DXF imports an editable line type from ODA",
+namespace {
+template <typename Style, typename Element>
+auto checkMLineExtendedColorRefusal(int)
+    -> decltype((void)std::declval<Style &>().fillColor24,
+                (void)std::declval<Style &>().fillColorMethod,
+                (void)std::declval<Element &>().colorFlags,
+                (void)std::declval<Element &>().colorDwgIndex, void()) {
+  // An explicit CMC ByLayer method has the same meaning as ACI 256 and is
+  // representable; retaining metadata must not reject it.
+  {
+    RS_Graphic graphic;
+    Style style;
+    style.handle = 0x900u;
+    style.name = "P8_BYLAYER_PROBE";
+    style.fillColorMethod = 0xC0u; // DWG CMC ByLayer
+    Element element;
+    element.linetype = "BYLAYER";
+    element.colorMethod = 0xC0u;
+    style.elements.push_back(element);
+    graphic.dwgAdvancedMetadata().addMLineStyle(style);
+    const auto &stored = graphic.dwgAdvancedMetadata().mlineStyles().back();
+    CHECK(stored.fillColorMethod == 0xC0u);
+    REQUIRE(stored.elements.size() == 1u);
+    CHECK(stored.elements[0].colorMethod == 0xC0u);
+    const std::string out = tmpFile("mline_explicit_bylayer.dxf");
+    RS_FilterDXFRW filter;
+    REQUIRE(filter.fileExport(graphic, QString::fromStdString(out), RS2::FormatDXFRW));
+    CHECK(namedRecordGroupValues(out, "MLINESTYLE", "P8_BYLAYER_PROBE", "62") ==
+          std::vector<std::string>{"256", "256"});
+    std::filesystem::remove(out);
+  }
+  for (const bool elementColor : {false, true}) {
+    CAPTURE(elementColor);
+    RS_Graphic graphic;
+    Style style;
+    style.handle = 0x900u;
+    style.name = "P8_COLOR_PROBE";
+    Element element;
+    element.linetype = "BYLAYER";
+    if (elementColor) {
+      element.color24 = 0x123456;
+      element.colorMethod = 0xC2u;
+      element.colorFlags = 3u;
+      element.colorDwgIndex = 42u;
+      element.colorName = "Element color";
+      element.colorBookName = "Element book";
+    } else {
+      style.fillColor24 = 0x654321;
+      style.fillColorMethod = 0xC2u;
+      style.fillColorFlags = 3u;
+      style.fillColorDwgIndex = 41u;
+      style.fillColorName = "Fill color";
+      style.fillColorBookName = "Fill book";
+    }
+    style.elements.push_back(element);
+    graphic.dwgAdvancedMetadata().addMLineStyle(style);
+    const auto &stored = graphic.dwgAdvancedMetadata().mlineStyles().back();
+    REQUIRE(stored.elements.size() == 1u);
+    if (elementColor) {
+      CHECK(stored.elements[0].color24 == 0x123456);
+      CHECK(stored.elements[0].colorMethod == 0xC2u);
+      CHECK(stored.elements[0].colorFlags == 3u);
+      CHECK(stored.elements[0].colorDwgIndex == 42u);
+      CHECK(stored.elements[0].colorName == "Element color");
+      CHECK(stored.elements[0].colorBookName == "Element book");
+    } else {
+      CHECK(stored.fillColor24 == 0x654321);
+      CHECK(stored.fillColorMethod == 0xC2u);
+      CHECK(stored.fillColorFlags == 3u);
+      CHECK(stored.fillColorDwgIndex == 41u);
+      CHECK(stored.fillColorName == "Fill color");
+      CHECK(stored.fillColorBookName == "Fill book");
+    }
+    const std::string out = tmpFile("mline_extended_color_refusal.dxf");
+    const std::string sentinel = "previous drawing\n";
+    writeText(out, sentinel);
+    RS_FilterDXFRW filter;
+    CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(out),
+                                  RS2::FormatDXFRW));
+    CHECK(filter.lastErrorCode() != DRW::BAD_NONE);
+    std::ifstream prior(out, std::ios::binary);
+    CHECK(std::string(std::istreambuf_iterator<char>(prior), {}) == sentinel);
+    prior.close();
+    graphic.dwgAdvancedMetadata().clear();
+    REQUIRE(filter.fileExport(graphic, QString::fromStdString(out),
+                               RS2::FormatDXFRW));
+    CHECK(filter.lastErrorCode() == DRW::BAD_NONE);
+    std::filesystem::remove(out);
+  }
+  // Each unsupported field must independently reach the writer. A combined
+  // failure alone would not catch a mapper that silently lost one field.
+  for (const bool elementColor : {false, true}) {
+    for (int field = 0; field < 6; ++field) {
+      CAPTURE(elementColor, field);
+      RS_Graphic graphic;
+      Style style;
+      style.handle = 0x900u;
+      style.name = "P8_ONE_COLOR_FIELD";
+      Element element;
+      element.linetype = "BYLAYER";
+      if (elementColor) {
+        switch (field) {
+        case 0: element.color24 = 0x123456; break;
+        case 1: element.colorMethod = 0xC1u; break;
+        case 2: element.colorFlags = 1u; break;
+        case 3: element.colorDwgIndex = 42u; break;
+        case 4: element.colorName = "Element color"; break;
+        case 5: element.colorBookName = "Element book"; break;
+        }
+      } else {
+        switch (field) {
+        case 0: style.fillColor24 = 0x654321; break;
+        case 1: style.fillColorMethod = 0xC1u; break;
+        case 2: style.fillColorFlags = 1u; break;
+        case 3: style.fillColorDwgIndex = 41u; break;
+        case 4: style.fillColorName = "Fill color"; break;
+        case 5: style.fillColorBookName = "Fill book"; break;
+        }
+      }
+      style.elements.push_back(element);
+      graphic.dwgAdvancedMetadata().addMLineStyle(style);
+      const std::string out = tmpFile("mline_single_color_refusal.dxf");
+      const std::string sentinel = "previous drawing\n";
+      writeText(out, sentinel);
+      RS_FilterDXFRW filter;
+      CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(out), RS2::FormatDXFRW));
+      CHECK(filter.lastErrorCode() != DRW::BAD_NONE);
+      std::ifstream prior(out, std::ios::binary);
+      CHECK(std::string(std::istreambuf_iterator<char>(prior), {}) == sentinel);
+      prior.close();
+      std::filesystem::remove(out);
+    }
+  }
+}
+template <typename Style, typename Element>
+void checkMLineExtendedColorRefusal(long) {}
+} // namespace
+
+TEST_CASE("MLINESTYLE color state is retained or refused safely",
+          "[dxf][roundtrip][filter][ltype][mline][write-errors]") {
+  ensureSettings();
+  RS_Graphic graphic;
+  DRW_MLineStyle style;
+  style.handle = 0x900u;
+  style.name = "P8_COLOR_PROBE";
+  DRW_MLineElement element;
+  element.linetype = "BYLAYER";
+  style.elements.push_back(element);
+  graphic.dwgAdvancedMetadata().addMLineStyle(style);
+  const std::string out = tmpFile("mline_default_color.dxf");
+  RS_FilterDXFRW filter;
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(out), RS2::FormatDXFRW));
+  CHECK(namedRecordGroupValues(out, "MLINESTYLE", "P8_COLOR_PROBE", "70").size() == 1u);
+  std::filesystem::remove(out);
+  checkMLineExtendedColorRefusal<DRW_MLineStyle, DRW_MLineElement>(0);
+}
