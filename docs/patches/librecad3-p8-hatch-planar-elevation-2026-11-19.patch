     }
+    // A single flat XY-plane polyline is representable as a HATCH at one
+    // common OCS elevation. The boundary writer emits only XY coordinates,
+    // so store Z on the HATCH, including after reopening a fallback HATCH.
+    // Do not infer a plane for other geometry or mixed/nonfinite Z values.
+    if (region.loopList().size() == 1
+        && region.loopList()[0].entities().size() == 1) {
+        const auto polyline = std::dynamic_pointer_cast<const lc::entity::LWPolyline>(
+            region.loopList()[0].entities()[0]);
+        if (polyline && polyline->closed() && !polyline->vertex().empty()
+            && polyline->elevation() == 0.0
+            && polyline->tickness() == 0.0
+            && polyline->extrusionDirection().x() == 0.0
+            && polyline->extrusionDirection().y() == 0.0
+            && polyline->extrusionDirection().z() == 1.0) {
+            const double elevation = polyline->vertex()[0].location().z();
+            const bool planar = std::isfinite(elevation) && std::all_of(
+                polyline->vertex().begin(), polyline->vertex().end(),
+                [elevation](const lc::entity::LWVertex2D& vertex) {
+                    return std::isfinite(vertex.location().z())
+                        && vertex.location().z() == elevation;
+                });
+            if (planar) hatch.basePoint.z = elevation;
+        }
+    }
