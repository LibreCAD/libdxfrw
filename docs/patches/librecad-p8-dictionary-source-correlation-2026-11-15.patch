diff --git a/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp b/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
index 9d1f158..659f1e1 100644
--- a/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
+++ b/librecad/src/lib/filters/tests/dxf_roundtrip_tests.cpp
@@ -9567,6 +9567,48 @@ TEST_CASE("Dictionary source observations retain typed values and reject ambigui
   metadata.clear();
   CHECK_FALSE(metadata.dictionarySourceCaptureFailed());
 }
+
+TEST_CASE("AC1024 dictionary source observations match live adapter receipts",
+          "[dwg][roundtrip][dictionarysource][source]") {
+  ensureSettings();
+  const auto path = std::string(LIBRECAD_TEST_DIR) + "/mpolygon/oda_solid_ac1024.dwg";
+  REQUIRE(std::filesystem::exists(path));
+  RS_Graphic graphic;
+  RS_FilterDXFRW reader;
+  const auto import = [&] {
+    return reader.fileImport(graphic, QString::fromStdString(path), RS2::FormatDWG);
+  };
+  REQUIRE(import());
+  auto &metadata = graphic.dwgAdvancedMetadata();
+  REQUIRE(metadata.sourceDwgVersion() == DRW::AC1024);
+  REQUIRE(metadata.dwgFramePublicationCoverageComplete());
+  REQUIRE_FALSE(metadata.dictionarySourceCaptureFailed());
+  constexpr std::uint32_t target = 0xBu;
+  REQUIRE(metadata.matchesAc1024DictionarySourceObservation(target));
+  metadata.setSourceDwgVersion(DRW::AC1027);
+  CHECK_FALSE(metadata.matchesAc1024DictionarySourceObservation(target));
+  metadata.setSourceDwgVersion(DRW::AC1024);
+  CHECK(metadata.matchesAc1024DictionarySourceObservation(target));
+  const auto goodReport = metadata.dwgFrameCoverageReport();
+  auto badReport = goodReport;
+  for (auto &entry : badReport.m_entries)
+    if (entry.m_handle == target) ++entry.m_sourceMapOrdinal;
+  metadata.addDwgFrameCoverageReport(badReport);
+  CHECK_FALSE(metadata.matchesAc1024DictionarySourceObservation(target));
+  metadata.addDwgFrameCoverageReport(goodReport);
+  CHECK(metadata.matchesAc1024DictionarySourceObservation(target));
+  const auto &memberships = metadata.dwgDictionaryMemberships();
+  const auto found = std::find_if(memberships.begin(), memberships.end(),
+      [](const auto &entry) { return entry.m_dictionaryHandle == target; });
+  REQUIRE(found != memberships.end());
+  const auto duplicate = *found;
+  metadata.addDwgDictionaryMembership(duplicate);
+  CHECK_FALSE(metadata.matchesAc1024DictionarySourceObservation(target));
+  metadata.clear();
+  CHECK_FALSE(metadata.matchesAc1024DictionarySourceObservation(target));
+  REQUIRE(import());
+  CHECK(graphic.dwgAdvancedMetadata().matchesAc1024DictionarySourceObservation(target));
+}
 #endif
 
