+{
+    m_circularEntityNormal = Base::Vector3d(
+        OCSOrientationTransform[0][2], OCSOrientationTransform[1][2], OCSOrientationTransform[2][2]
+    );
+    if (m_circularEntityNormal.IsNull() || !std::isfinite(m_circularEntityNormal.x)
+        || !std::isfinite(m_circularEntityNormal.y) || !std::isfinite(m_circularEntityNormal.z)) {
+        UnsupportedFeature("ARC/CIRCLE invalid extrusion direction");
+        return false;
+    }
+    return true;
+}
