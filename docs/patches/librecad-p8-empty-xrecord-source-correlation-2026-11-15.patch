+#if defined(LIBDXFRW_HAS_AC1024_EMPTY_XRECORD_SOURCE_VERIFY) && defined(LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY)
+bool LC_DwgAdvancedMetadata::matchesAc1024EmptyXRecordSourceObservation(
+    std::uint32_t handle) const noexcept {
+  // Selected source correlation only: this does not authorize any output.
+  if (m_sourceDwgVersion != DRW::AC1024 || !m_dwgFramePublicationCoverageComplete
+      || !m_dwgFramePublicationConflicts.empty() || m_emptyXRecordSourceCaptureFailed)
+    return false;
+  const auto snapshotIt = m_emptyXRecordSources.find(handle);
+  if (snapshotIt == m_emptyXRecordSources.end())
+    return false;
+  const auto &snapshot = snapshotIt->second;
+  const XRecordRecord *current = nullptr;
+  const RawObjectRecord *raw = nullptr;
+  const DRW_DwgFramePublication *publication = nullptr;
+  const DRW_DwgFrameCoverageEntry *coverage = nullptr;
+  for (const auto &item : m_xrecords)
+    if (item.handle == handle) { if (current) return false; current = &item; }
+  for (const auto &item : m_rawObjects)
+    if (item.handle == handle) { if (raw) return false; raw = &item; }
+  for (const auto &item : m_dwgFramePublications)
+    if (item.m_handle == handle) { if (publication) return false; publication = &item; }
+  for (const auto &item : m_dwgFrameCoverageReport.m_entries)
+    if (item.m_handle == handle) { if (coverage) return false; coverage = &item; }
+  if (!current || !raw || !publication || !coverage
+      || coverage->m_sourceOffset != publication->m_sourceOffset
+      || coverage->m_sourceMapOrdinal != publication->m_sourceMapOrdinal
+      || coverage->m_sourceOffsetSpace != publication->m_sourceOffsetSpace
+      || coverage->m_disposition != DRW_DwgFrameDisposition::Published
+      || coverage->m_publicationCount != 1u || raw->rawBytes.empty()
+      || raw->rawBytes.size() > 4096u || !raw->commonHandleDataValidated
+      || current->replayState != ReplayState::ReplayAllowed
+      || raw->replayState != ReplayState::ReplayAllowed
+      || current->handle != snapshot.handle || current->parentHandle != snapshot.parentHandle
+      || current->cloning != snapshot.m_cloning || !current->values.empty()
+      || !current->handleValues.empty() || !current->dataEntries.empty()
+      || current->rawDataValid || !current->rawData.empty()
+      || !current->appData.empty() || !current->extData.empty()
+      || current->reactorHandles != snapshot.reactorHandles
+      || current->xDictHandle != snapshot.xDictHandle
+      || current->numReactors != snapshot.reactorCount()
+      || current->xDictFlag != snapshot.extensionDictionaryFlag()
+      || current->hasDsData != snapshot.hasDataStorageBinaryData())
+    return false;
+  try {
+    const auto source = sourceObject(*raw);
+    return snapshot.matchesAc1024EmptyDwgFrame(source, *publication);
+  } catch (...) {
+    return false;
+  }
+}
+
+bool LC_DwgAdvancedMetadata::matchesSelectedAc1024EmptyXRecordDictionary(
+    std::uint32_t dictionaryHandle, const std::string &entryName,
+    std::uint32_t xrecordHandle) const noexcept {
+  // An imported source relationship, not graph closure or permission to write.
+  if (!m_selectedSourceCaptureSealed || entryName.empty()
+      || dictionaryHandle == 0u || dictionaryHandle == DRW::NoHandle
+      || xrecordHandle == 0u || xrecordHandle == DRW::NoHandle
+      || dictionaryHandle == xrecordHandle
+      || !matchesAc1024DictionarySourceObservation(dictionaryHandle)
+      || !matchesAc1024EmptyXRecordSourceObservation(xrecordHandle))
+    return false;
+  const DictionaryRecord *dictionary = nullptr;
+  const XRecordRecord *xrecord = nullptr;
+  for (const auto &item : m_dictionaries)
+    if (item.handle == dictionaryHandle) { if (dictionary) return false; dictionary = &item; }
+  for (const auto &item : m_xrecords)
+    if (item.handle == xrecordHandle) { if (xrecord) return false; xrecord = &item; }
+  if (!dictionary || !xrecord || xrecord->parentHandle != dictionaryHandle)
+    return false;
+  std::size_t matches = 0u;
+  for (const auto &entry : dictionary->entries) {
+    if (entry.name == entryName || entry.handle == xrecordHandle) {
+      if (entry.name != entryName || entry.handle != xrecordHandle)
+        return false;
+      ++matches;
+    }
+  }
+  return matches == 1u;
+}
+#endif
