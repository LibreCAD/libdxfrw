+#if defined(LIBDXFRW_HAS_AC1024_EMPTY_XRECORD_SOURCE_VERIFY) && defined(LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY)
+TEST_CASE("ODA generated empty XRECORD retains selected dictionary source",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_GENERATED_SORTENTS_FIXTURE to a locally generated ODA AC1024 DWG");
+  REQUIRE(std::filesystem::exists(fixture));
+  ensureSettings(); RS_Graphic graphic; RS_FilterDXFRW reader;
+  REQUIRE(reader.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  auto &md = graphic.dwgAdvancedMetadata();
+  REQUIRE(md.selectedDwgSourceCaptureSessionSealed());
+  REQUIRE_FALSE(md.emptyXRecordSourceCaptureFailed());
+  REQUIRE(md.emptyXRecordSourceObservations().count(0xB200u) == 1u);
+  REQUIRE(md.matchesAc1024EmptyXRecordSourceObservation(0xB200u));
+  REQUIRE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  CHECK_FALSE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "ACAD_SORTENTS", 0xB200u));
+  CHECK_FALSE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB004u, "OTHER", 0xB200u));
+  auto &dictionaries = const_cast<std::vector<LC_DwgAdvancedMetadata::DictionaryRecord>&>(md.dictionaries());
+  const auto dictionary = std::find_if(dictionaries.begin(), dictionaries.end(), [](const auto &d) { return d.handle == 0xB003u; });
+  REQUIRE(dictionary != dictionaries.end());
+  const auto entry = std::find_if(dictionary->entries.begin(), dictionary->entries.end(), [](const auto &e) { return e.name == "OTHER"; });
+  REQUIRE(entry != dictionary->entries.end());
+  entry->handle ^= 1u;
+  CHECK_FALSE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  entry->handle ^= 1u;
+  CHECK(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  auto &records = const_cast<std::vector<LC_DwgAdvancedMetadata::XRecordRecord>&>(md.xrecords());
+  const auto it = std::find_if(records.begin(), records.end(), [](const auto &x) { return x.handle == 0xB200u; });
+  REQUIRE(it != records.end());
+  it->cloning = 1;
+  CHECK_FALSE(md.matchesAc1024EmptyXRecordSourceObservation(0xB200u));
+  it->cloning = 0;
+  CHECK(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  auto &raws = const_cast<std::vector<LC_DwgAdvancedMetadata::RawObjectRecord>&>(md.rawObjects());
+  const auto raw = std::find_if(raws.begin(), raws.end(), [](const auto &x) { return x.handle == 0xB200u; });
+  REQUIRE(raw != raws.end()); REQUIRE_FALSE(raw->rawBytes.empty());
+  raw->rawBytes.back() ^= 0x10u;
+  CHECK_FALSE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  raw->rawBytes.back() ^= 0x10u;
+  CHECK(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  const auto duplicate = md.emptyXRecordSourceObservations().at(0xB200u);
+  md.observeEmptyXRecordSource(duplicate);
+  CHECK(md.emptyXRecordSourceCaptureFailed());
+  CHECK_FALSE(md.selectedDwgSourceCaptureSessionSealed());
+  CHECK_FALSE(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+  md.clear();
+  REQUIRE(reader.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  CHECK(md.matchesSelectedAc1024EmptyXRecordDictionary(0xB003u, "OTHER", 0xB200u));
+}
+#endif
