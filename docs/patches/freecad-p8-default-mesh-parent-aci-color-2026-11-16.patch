+        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"),
+                (0, "SECTION"), (2, "ENTITIES")]
+        for offset, colors in ((0, (1, 2)), (10, (1,))):
+            tags.extend([(0, "POLYLINE"), (8, "0"), (66, 1), (70, 64)])
+            tags.extend((62, color) for color in colors)
+            for x, y in ((offset, 0), (offset + 4, 0), (offset, 3)):
+                tags.extend([(0, "VERTEX"), (8, "0"), (10, x), (20, y), (30, 0), (70, 192)])
+            tags.extend([(0, "VERTEX"), (8, "0"), (10, 0), (20, 0), (30, 0),
+                         (70, 128), (71, 1), (72, 2), (73, 3), (0, "SEQEND"), (8, "0")])
+        tags.extend([(0, "LINE"), (8, "0"), (10, 20), (20, 0), (30, 0),
+                     (11, 22), (21, 0), (31, 0), (0, "ENDSEC"), (0, "EOF")])
+        path = os.path.join(self.temp_dir, "mesh-color-recovery.dxf")
+        with open(path, "w", encoding="ascii", newline="\n") as stream:
+            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+        previous = set(self.document.Objects)
+        stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+        objects = [obj for obj in self.document.Objects if obj not in previous
