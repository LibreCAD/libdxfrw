+#ifdef LIBDXFRW_HAS_AC1024_EMPTY_XRECORD_SOURCE_VERIFY
+TEST_CASE("DWG title block preview reaches the LibreCAD block model",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_AC1024_SORTENTS_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_AC1024_SORTENTS_FIXTURE to a locally available AC1024 title drawing");
+  ensureSettings(); RS_Graphic graphic; RS_FilterDXFRW filter;
+  REQUIRE(filter.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  const RS_Block *block = nullptr;
+  for (unsigned i = 0; i < graphic.countBlocks(); ++i)
+    if (graphic.blockAt(i)->getName() == QStringLiteral("Title_Block-ISO")) block = graphic.blockAt(i);
+  REQUIRE(block != nullptr);
+  CHECK(block->sourceHandle() == 0x127u);
+  REQUIRE(block->getPreviewData().size() == 2088u);
+  std::uint64_t hash = 14695981039346656037ull;
+  for (const auto byte : block->getPreviewData()) { hash ^= byte; hash *= 1099511628211ull; }
+  CHECK(hash == 0xf881aec25d524b4full);
+}
+#endif
