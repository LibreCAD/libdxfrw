+    def test_polyface_display_invalid_then_valid_same_file(self):
+        """Reject nondefault display metadata without contaminating the next mesh."""
+        points = [(1, 1, 1), (4, 1, 2), (4, 5, 3), (1, 5, 2)]
+        tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"), (2, "ENTITIES")]
+        for handle, lineweight in (("A", 25), ("B", "  -1")):
+            tags.extend([(0, "POLYLINE"), (5, handle), (8, "0"),
+                         (6, "BYLAYER"), (370, lineweight), (66, 1), (70, 64)])
+            for x, y, z in points:
+                tags.extend([(0, "VERTEX"), (8, "0"), (6, "BYLAYER"), (370, "  -1"),
+                             (10, x), (20, y), (30, z), (70, 192)])
+            tags.extend([(0, "VERTEX"), (8, "0"), (6, "BYLAYER"), (370, "  -1"),
+                         (70, 128), (71, 1), (72, 2), (73, 3), (74, 4), (0, "SEQEND")])
+        tags.extend([(0, "ENDSEC"), (0, "EOF")])
+        path = os.path.join(self.temp_dir, "polyface-display-recovery.dxf")
+        with open(path, "w", encoding="ascii", newline="\n") as stream:
+            stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+        stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+        self.assertEqual(stats["entityCounts"].get("POLYLINE"), 2)
+        self.assertEqual(len(stats["unsupportedFeatures"]["POLYFACE unsupported or invalid profile"]), 1)
+        meshes = [obj for obj in self.document.Objects if obj.Name.startswith("Polyface")]
+        self.assertEqual(len(meshes), 1)
+        self.assertTrue(meshes[0].Shape.isValid())
+        self.assertEqual(len(meshes[0].Shape.Faces), 1)
+        self.assertEqual(sorted((v.Point.x, v.Point.y, v.Point.z) for v in meshes[0].Shape.Vertexes),
+                         sorted(points))
