+// Explicit BYLAYER display tags have the same meaning as their omission in
+// this bounded mesh profile. Other styles must not be silently discarded.
+bool acceptDefaultMeshDisplayTag(int code, const std::string& value,
+                                 bool& linetypeSeen, bool& lineweightSeen)
+{
+    bool& seen = code == 6 ? linetypeSeen : lineweightSeen;
+    if (seen) return false;
+    seen = true;
+    if (code == 6) return value == "BYLAYER";
+    std::istringstream stream(value);
+    stream.imbue(std::locale("C"));
+    int lineweight = 0;
+    return static_cast<bool>(stream >> lineweight) && (stream >> std::ws).eof()
+        && lineweight == -1;
+}
