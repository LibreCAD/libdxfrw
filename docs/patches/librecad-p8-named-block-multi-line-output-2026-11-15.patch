 #ifdef LIBDXFRW_HAS_AC1024_EMPTY_XRECORD_SOURCE_VERIFY
+TEST_CASE("Named block export preserves verified ordered source lines",
+          "[dwg][roundtrip][sortentssource][source]") {
+  const char *fixture = std::getenv("LIBRECAD_ODA_NAMED_BLOCK_TWO_LINES_FIXTURE");
+  if (fixture == nullptr || *fixture == '\0')
+    SKIP("Set LIBRECAD_ODA_NAMED_BLOCK_TWO_LINES_FIXTURE to a locally generated ODA AC1024 DWG");
+  ensureSettings(); RS_Graphic graphic; RS_FilterDXFRW filter;
+  REQUIRE(filter.fileImport(graphic, QString::fromUtf8(fixture), RS2::FormatDWG));
+  const auto &md = graphic.dwgAdvancedMetadata();
+  REQUIRE(md.matchesSelectedAc1024SortEntsOwnerChain(0x30u, 0xB003u, 0xB100u));
+  REQUIRE(md.blockRecordLinks().at(0x30u).sourceEntityCount == 2u);
+  REQUIRE(md.blockRecordLinks().at(0x30u).boundedLineSources.size() == 2u);
+  RS_Block *block = nullptr;
+  for (unsigned i = 0; i < graphic.countBlocks(); ++i)
+    if (graphic.blockAt(i)->getName() == QStringLiteral("Named")) block = graphic.blockAt(i);
+  REQUIRE(block != nullptr);
+  lc::LC_ContainerTraverser walk{*block, RS2::ResolveNone};
+  RS_Entity *first = walk.first(); RS_Entity *second = walk.next();
+  REQUIRE(first != nullptr); REQUIRE(second != nullptr); REQUIRE(walk.next() == nullptr);
+  REQUIRE(first->rtti() == RS2::EntityLine); REQUIRE(second->rtti() == RS2::EntityLine);
+  const auto secondHandle = second->sourceHandle();
+  REQUIRE(filter.setExperimentalEmptyNamedSortEnts(true));
+  const char *keepPath = std::getenv("LIBRECAD_KEEP_NAMED_BLOCK_TWO_LINES_DXF");
+  const std::string path = keepPath && *keepPath ? keepPath : tmpFile("named_sort_two_lines.dxf");
+  const std::string sentinel = "previous destination\n";
+  writeText(path, sentinel);
+  second->setSourceHandle(first->sourceHandle());
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  second->setSourceHandle(secondHandle);
+  second->setVisible(false);
+  CHECK_FALSE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  {
+    std::ifstream saved(path);
+    CHECK(std::string(std::istreambuf_iterator<char>(saved), {}) == sentinel);
+  }
+  second->setVisible(true);
+  REQUIRE(filter.fileExport(graphic, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  RS_Graphic reread; RS_FilterDXFRW rereader;
+  REQUIRE(rereader.fileImport(reread, QString::fromStdString(path), RS2::FormatDXFRW2010));
+  const RS_Block *readBlock = nullptr;
+  for (unsigned i = 0; i < reread.countBlocks(); ++i)
+    if (reread.blockAt(i)->getName() == QStringLiteral("Named")) readBlock = reread.blockAt(i);
+  REQUIRE(readBlock != nullptr);
+  lc::LC_ContainerTraverser readWalk{*readBlock, RS2::ResolveNone};
+  const auto *one = readWalk.first(); const auto *two = readWalk.next();
+  REQUIRE(one != nullptr); REQUIRE(two != nullptr); REQUIRE(readWalk.next() == nullptr);
+  REQUIRE(one->rtti() == RS2::EntityLine); REQUIRE(two->rtti() == RS2::EntityLine);
+  const auto *lineOne = static_cast<const RS_Line *>(one);
+  const auto *lineTwo = static_cast<const RS_Line *>(two);
+  CHECK(lineOne->getStartpoint().x == Catch::Approx(1.0));
+  CHECK(lineOne->getStartpoint().y == Catch::Approx(2.0));
+  CHECK(lineTwo->getStartpoint().x == Catch::Approx(-2.0));
+  CHECK(lineTwo->getStartpoint().y == Catch::Approx(5.0));
+  REQUIRE(reread.dwgAdvancedMetadata().sortEntsTables().size() == 1u);
+  if (!(keepPath && *keepPath)) std::filesystem::remove(path);
+}
+#endif
