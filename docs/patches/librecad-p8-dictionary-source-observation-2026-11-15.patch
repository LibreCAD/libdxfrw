+#ifdef LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY
+  // Frozen typed observations are correlation evidence, never export authority.
+  // Only retain the bounded no-EED profile accepted by the source verifier.
+  void observeDictionarySource(const DRW_Dictionary &dictionary) noexcept {
+    constexpr std::size_t maxRecords = 100000u;
+    constexpr std::size_t maxBytes = 32u * 1024u * 1024u;
+    if (m_dictionarySourceCaptureFailed)
+      return;
+    if (dictionary.tType != DRW::DICTIONARY || !dictionary.hasCompleteDwgEntries()
+        || dictionary.countCap || !dictionary.appData.empty()
+        || !dictionary.extData.empty() || !dictionary.pendingAppIdResolutions.empty()
+        || !dictionary.pendingLayerRefResolutions.empty()
+        || dictionary.reactorCount() != 0 || !dictionary.reactorHandles.empty()
+        || dictionary.extensionDictionaryFlag() != 1u || dictionary.xDictHandle != 0u
+        || dictionary.hasDataStorageBinaryData()
+        || dictionary.parentHandle == 0u || dictionary.parentHandle == DRW::NoHandle)
+      return;
+    const auto reject = [this]() noexcept {
+      m_dictionarySources.clear();
+      m_dictionarySourceBytes = 0u;
+      m_dictionarySourceCaptureFailed = true;
+    };
+    if (dictionary.handle == 0u || dictionary.handle == DRW::NoHandle
+        || m_dictionarySources.size() >= maxRecords
+        || dictionary.m_entries.size() > DRW_Dictionary::kMaxEntries) {
+      reject();
+      return;
+    }
+    std::size_t estimate = sizeof(DRW_Dictionary);
+    const auto account = [&estimate](std::size_t bytes) noexcept {
+      if (bytes > maxBytes - estimate)
+        return false;
+      estimate += bytes;
+      return true;
+    };
+    if (!account(dictionary.name.size())
+        || dictionary.m_entries.size() > maxBytes / sizeof(DRW_Dictionary::Entry)
+        || !account(dictionary.m_entries.size() * sizeof(DRW_Dictionary::Entry))) {
+      reject();
+      return;
+    }
+    for (const auto &entry : dictionary.m_entries) {
+      if (!account(entry.m_name.size())) {
+        reject();
+        return;
+      }
+    }
+    if (m_dictionarySourceBytes > maxBytes - estimate) {
+      reject();
+      return;
+    }
+    try {
+      if (!m_dictionarySources.emplace(dictionary.handle, dictionary).second) {
+        reject();
+        return;
+      }
+      m_dictionarySourceBytes += estimate;
+    } catch (...) {
+      reject();
+    }
+  }
+
+  const std::map<std::uint32_t, DRW_Dictionary> &
+  dictionarySourceObservations() const noexcept { return m_dictionarySources; }
+  bool dictionarySourceCaptureFailed() const noexcept {
+    return m_dictionarySourceCaptureFailed;
+  }
+#endif
+
   void clear() {
