+#ifdef LIBDXFRW_HAS_AC1024_DICTIONARY_SOURCE_VERIFY
+TEST_CASE("Dictionary source observations retain typed values and reject ambiguity",
+          "[dwg][roundtrip][dictionarysource][source]") {
+  LC_DwgAdvancedMetadata metadata;
+  DRW_Dictionary dict;
+  dict.handle = 0x123u;
+  dict.parentHandle = 0x10u;
+  dict.setDwgCommonObjectState(0, 1, false);
+  dict.setDwgCommonLinkTailValidated(true);
+  dict.flags = 42;
+  dict.name = "DICTIONARY";
+  DRW_Dictionary::Entry entry;
+  entry.m_name = "ACAD_SORTENTS";
+  entry.m_handle = 0x456u;
+  dict.m_entries.push_back(entry);
+  metadata.addDictionary(dict);
+  REQUIRE_FALSE(metadata.dictionarySourceCaptureFailed());
+  REQUIRE(metadata.dictionarySourceObservations().size() == 1u);
+  dict.flags = 0;
+  dict.m_entries[0].m_name = "CHANGED";
+  const auto &saved = metadata.dictionarySourceObservations().at(0x123u);
+  CHECK(saved.flags == 42);
+  CHECK(saved.hasDwgCommonLinkTail());
+  CHECK(saved.m_entries[0].m_name == "ACAD_SORTENTS");
+  CHECK(saved.m_entries[0].m_handle == 0x456u);
+  metadata.observeDictionarySource(dict);
+  CHECK(metadata.dictionarySourceCaptureFailed());
+  CHECK(metadata.dictionarySourceObservations().empty());
+  metadata.clear();
+  CHECK_FALSE(metadata.dictionarySourceCaptureFailed());
+  dict.handle = DRW::NoHandle;
+  metadata.observeDictionarySource(dict);
+  CHECK(metadata.dictionarySourceCaptureFailed());
+  metadata.clear();
+  dict.handle = 0x123u;
+  dict.reactorHandles.push_back(0x99u);
+  metadata.observeDictionarySource(dict);
+  CHECK_FALSE(metadata.dictionarySourceCaptureFailed());
+  CHECK(metadata.dictionarySourceObservations().empty());
+  dict.reactorHandles.clear();
+  dict.parentHandle = 0u; // The root dictionary is outside this profile.
+  metadata.observeDictionarySource(dict);
+  CHECK_FALSE(metadata.dictionarySourceCaptureFailed());
+  CHECK(metadata.dictionarySourceObservations().empty());
+  dict.parentHandle = 0x10u;
+  dict.name.assign(32u * 1024u * 1024u, 'x');
+  metadata.observeDictionarySource(dict);
+  CHECK(metadata.dictionarySourceCaptureFailed());
+  CHECK(metadata.dictionarySourceObservations().empty());
+  metadata.clear();
+  CHECK_FALSE(metadata.dictionarySourceCaptureFailed());
+}
+#endif
