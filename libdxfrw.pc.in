prefix=@LIBDXFRW_PC_PREFIX@
exec_prefix=${prefix}
libdir=@LIBDXFRW_PC_LIBDIR@
includedir=@LIBDXFRW_PC_INCLUDEDIR@

Name: libdxfrw
Description: c++ library to read/write dxf files in binary and ascii form
Version: @PROJECT_VERSION@
Libs: -L@LIBDXFRW_PC_LIBDIR@ -ldxfrw
Libs.private: @CMAKE_THREAD_LIBS_INIT@
Cflags: -I@LIBDXFRW_PC_INCLUDEDIR@/libdxfrw @LIBDXFRW_PC_THREAD_CFLAGS@
