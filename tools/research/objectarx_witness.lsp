;; Scratch-drawing producer witness.  No fixture files or network access.
;; Load only in a new, unmodified, empty AutoCAD drawing; see companion README.
(defun dxfrw-require (value description)
  (if (not value) (progn (princ (strcat "\nFAILED: " description)) (exit)))
  value)

(defun dxfrw-layer-weight (name / record)
  (setq record (entget (tblobjname "LAYER" name)))
  (cdr (assoc 370 record)))

(defun dxfrw-set-weight (name value / entity record old)
  (setq entity (tblobjname "LAYER" name) record (entget entity)
        old (assoc 370 record))
  (dxfrw-require
    (entmod (if old (subst (cons 370 value) old record)
                  (append record (list (cons 370 value)))))
    "setting layer weight"))

(defun c:DXFRWREPORT (/ inserts entity record owner)
  (princ (strcat "\nDXFRW ACADVER=" (getvar "ACADVER")))
  (princ (strcat "\nDXFRW DWGNAME=" (getvar "DWGNAME")))
  (princ (strcat "\nDXFRW DWGTITLED=" (itoa (getvar "DWGTITLED"))))
  (if (tblsearch "LAYER" "DXFRW_A")
    (progn
      (princ "\nDXFRW layer DXFRW_A group370=")
      (prin1 (dxfrw-layer-weight "DXFRW_A"))))
  (setq inserts (ssget "_X" '((0 . "INSERT") (2 . "DXFRW_ORDER"))))
  (princ "\nDXFRW matching INSERT count=")
  (prin1 (if inserts (sslength inserts) 0))
  (if (= (if inserts (sslength inserts) 0) 1)
    (progn
      (setq entity (ssname inserts 0) record (entget entity)
            owner (cdr (assoc 330 record)))
      (princ "\nDXFRW INSERT handle=") (prin1 (cdr (assoc 5 record)))
      (princ " owner handle=")
      (prin1 (if owner (cdr (assoc 5 (entget owner))) nil))))
  (princ))

(defun c:DXFRWCREATE ()
  (dxfrw-require (= 0 (getvar "DWGTITLED")) "drawing must be untitled")
  (dxfrw-require (= 0 (getvar "DBMOD")) "drawing must be unmodified")
  (dxfrw-require (not (ssget "_X")) "drawing must contain no graphical entities")
  (dxfrw-require (not (tblsearch "LAYER" "DXFRW_A")) "layer name exists")
  (dxfrw-require (not (tblsearch "LAYER" "DXFRW_B")) "layer name exists")
  (dxfrw-require (not (tblsearch "BLOCK" "DXFRW_ORDER")) "block name exists")
  (dxfrw-require (not (tblsearch "VIEW" "DXFRW_VIEW")) "view name exists")
  (dxfrw-require (not (layerstate-has "DXFRW_DEFAULT")) "default layer state exists")
  (dxfrw-require (not (layerstate-has "DXFRW_EXPLICIT")) "explicit layer state exists")
  (dxfrw-require (entmake '((0 . "LAYER") (100 . "AcDbSymbolTableRecord")
     (100 . "AcDbLayerTableRecord") (2 . "DXFRW_A") (70 . 0)
     (62 . 1) (6 . "Continuous") (370 . -3))) "create layer A")
  (dxfrw-require (entmake '((0 . "LAYER") (100 . "AcDbSymbolTableRecord")
     (100 . "AcDbLayerTableRecord") (2 . "DXFRW_B") (70 . 0)
     (62 . 3) (6 . "Continuous"))) "create layer B")
  (dxfrw-require (entmake '((0 . "BLOCK") (2 . "DXFRW_ORDER") (70 . 0)
                            (10 0.0 0.0 0.0))) "start block")
  (dxfrw-require (entmake '((0 . "SOLID") (8 . "DXFRW_A")
     (10 0.0 0.0 0.0) (11 20.0 0.0 0.0) (12 0.0 20.0 0.0)
     (13 20.0 20.0 0.0))) "first solid")
  (dxfrw-require (entmake '((0 . "SOLID") (8 . "DXFRW_B")
     (10 10.0 10.0 0.0) (11 30.0 10.0 0.0) (12 10.0 30.0 0.0)
     (13 30.0 30.0 0.0))) "second solid")
  (dxfrw-require (entmake '((0 . "ENDBLK"))) "end block")
  (dxfrw-require (entmake '((0 . "INSERT") (2 . "DXFRW_ORDER")
                             (10 0.0 0.0 0.0))) "insert block")
  (princ "\nDXFRW default layer weight before save=")
  (prin1 (dxfrw-layer-weight "DXFRW_A"))
  (dxfrw-require (layerstate-save "DXFRW_DEFAULT" 255 nil) "save default layer state")
  (dxfrw-set-weight "DXFRW_A" 25)
  (princ "\nDXFRW explicit layer weight before save=")
  (prin1 (dxfrw-layer-weight "DXFRW_A"))
  (dxfrw-require (layerstate-save "DXFRW_EXPLICIT" 255 nil) "save explicit layer state")
  (dxfrw-require (layerstate-restore "DXFRW_DEFAULT" nil) "restore default layer state")
  (princ "\nDXFRW layer weight after restoring default=")
  (prin1 (dxfrw-layer-weight "DXFRW_A"))
  (dxfrw-require (layerstate-restore "DXFRW_EXPLICIT" nil) "restore explicit layer state")
  (princ "\nDXFRW layer weight after restoring explicit=")
  (prin1 (dxfrw-layer-weight "DXFRW_A"))
  (c:DXFRWREPORT)
  (princ "\nDXFRW creation complete; follow witness README before saving.")
  (princ))
(princ "\nLoaded DXFRWCREATE and DXFRWREPORT. See witness README.")
(princ)
